4_v3\":\"Mdsv3\",\"standard_m176s_3_v3\":\"Msv3\",\"standard_m176s_4_v3\":\"Msv3\",\"standard_m192idms_v2\":\"Midmsv2\",\"standard_m192ids_v2\":\"Midsv2\",\"standard_m192ims_v2\":\"Mimsv2\",\"standard_m192is_v2\":\"Misv2\",\"standard_m208ms_v2\":\"Mmsv2\",\"standard_m208s_v2\":\"Msv2\",\"standard_m24ds_v3\":\"Mdsv3\",\"standard_m24s_v3\":\"Msv3\",\"standard_m32-16ms\":\"Mmsv1\",\"standard_m32-8ms\":\"Mmsv1\",\"standard_m32bds_v3\":\"Mbdsv3\",\"standard_m32bs_v3\":\"Mbsv3\",\"standard_m32dms_v2\":\"Mdmsv2\",\"standard_m32ls\":\"Mlsv1\",\"standard_m32ms\":\"Mmsv1\",\"standard_m32ms_v2\":\"Mmsv2\",\"standard_m32ts\":\"Mtsv1\",\"standard_m416-208ms_v2\":\"Mmsv2\",\"standard_m416-208s_v2\":\"Msv2\",\"standard_m416bs_v3\":\"Mbsv3\",\"standard_m416ds_10_v3\":\"Mdsv3\",\"standard_m416ds_12_v3\":\"Mdsv3\",\"standard_m416ds_6_v3\":\"Mdsv3\",\"standard_m416ds_8_v3\":\"Mdsv3\",\"standard_m416ds_9_v3\":\"Mdsv3\",\"standard_m416ms_v2\":\"Mmsv2\",\"standard_m416s_10_v2\":\"Msv2\",\"standard_m416s_10_v3\":\"Msv3\",\"standard_m416s_12_v3\":\"Msv3\",\"standard_m416s_6_v3\":\"Msv3\",\"standard_m416s_8_v2\":\"Msv2\",\"standard_m416s_8_v3\":\"Msv3\",\"standard_m416s_9_v2\":\"Msv2\",\"standard_m416s_9_v3\":\"Msv3\",\"standard_m416s_v2\":\"Msv2\",\"standard_m48bds_v3\":\"Mbdsv3\",\"standard_m48bs_v3\":\"Mbsv3\",\"standard_m48ds_1_v3\":\"Mdsv3\",\"standard_m48s_1_v3\":\"Msv3\",\"standard_m624ds_12_v3\":\"Mdsv3\",\"standard_m624s_12_v3\":\"Msv3\",\"standard_m64\":\"Mv1\",\"standard_m64-16ms\":\"Mmsv1\",\"standard_m64-32bds_1_v3\":\"Mbdsv3\",\"standard_m64-32ms\":\"Mmsv1\",\"standard_m64bds_1_v3\":\"Mbdsv3\",\"standard_m64bds_v3\":\"Mbdsv3\",\"standard_m64bs_v3\":\"Mbsv3\",\"standard_m64dms_v2\":\"Mdmsv2\",\"standard_m64ds_v2\":\"Mdsv2\",\"standard_m64ls\":\"Mlsv1\",\"standard_m64m\":\"Mmv1\",\"standard_m64ms\":\"Mmsv1\",\"standard_m64ms_v2\":\"Mmsv2\",\"standard_m64s\":\"Msv1\",\"standard_m64s_v2\":\"Msv2\",\"standard_m8-2ms\":\"Mmsv1\",\"standard_m8-4ms\":\"Mmsv1\",\"standard_m832ds_12_v3\":\"Mdsv3\",\"standard_m832ids_16_v3\":\"Midsv3\",\"standard_m832is_16_v3\":\"Misv3\",\"standard_m832s_12_v3\":\"Msv3\",\"standard_m8ms\":\"Mmsv1\",\"standard_m96-48bds_2_v3\":\"Mbdsv3\",\"standard_m96bds_2_v3\":\"Mbdsv3\",\"standard_m96bds_v3\":\"Mbdsv3\",\"standard_m96bs_v3\":\"Mbsv3\",\"standard_m96ds_1_v3\":\"Mdsv3\",\"standard_m96ds_2_v3\":\"Mdsv3\",\"standard_m96s_1_v3\":\"Msv3\",\"standard_m96s_2_v3\":\"Msv3\",\"standard_nc16as_t4_v3\":\"NCas_T4v3\",\"standard_nc40ads_h100_v5\":\"NCads_H100v5\",\"standard_nc64as_t4_v3\":\"NCas_T4v3\",\"standard_nd40rs_v2\":\"NDrsv2\",\"standard_np10s\":\"NPsv1\",\"standard_np20s\":\"NPsv1\",\"standard_np40s\":\"NPsv1\",\"standard_nv12ads_a10_v5\":\"NVads_A10v5\",\"standard_nv12s_v3\":\"NVsv3\",\"standard_nv16as_v4\":\"NVasv4\",\"standard_nv18ads_a10_v5\":\"NVads_A10v5\",\"standard_nv24s_v3\":\"NVsv3\",\"standard_nv32as_v4\":\"NVasv4\",\"standard_nv36ads_a10_v5\":\"NVads_A10v5\",\"standard_nv48s_v3\":\"NVsv3\",\"standard_nv4as_v4\":\"NVasv4\",\"standard_nv6ads_a10_v5\":\"NVads_A10v5\",\"standard_nv72ads_a10_v5\":\"NVads_A10v5\",\"standard_nv8as_v4\":\"NVasv4\"}')[tolower(VmSize)])\n| extend ReportedExcluded = tobool(parse_json('{\"amv2\":true,\"av2\":true,\"blsv1\":true,\"bmsv1\":true,\"bsv1\":true,\"ddsv7\":true,\"dldsv7\":true,\"dlsv7\":true,\"dsv1\":true,\"dsv2\":true,\"dsv7\":true,\"dv1\":true,\"dv2\":true,\"edsv7\":true,\"esv7\":true,\"fsv1\":true,\"fsv2\":true,\"fv1\":true,\"gsv1\":true,\"gv1\":true,\"hcs\":true,\"lsv1\":true,\"lsv2\":true,\"npsv1\":true}')[tolower(Series)]) == true\n        or tolower(VmSize) matches regex '^standard_(d[0-9]+(-[0-9]+)?(s|ds|ls|lds)|e[0-9]+(-[0-9]+)?(s|ds))_v7$'\n| extend Exposure = case(\n        ReportedExcluded == true, 'Reported regional exclusion - not a universal exemption',\n        isempty(Series), 'Potential exposure - series/scope unknown',\n        'Potential exposure - verify advisory and agreement')\n| extend EffectiveDate = datetime(2027-02-01),\n         Evidence = 'Public Q&A reproduction of customer notification; not a formal public announcement',\n         Scope = 'VM compute only; not a bill estimate. Confirm meters, contract, reservations and regional scope in Service Health. Separate legacy-series changes may apply.',\n         Source = 'https://learn.microsoft.com/en-us/answers/questions/6025662/is-there-any-official-announcement-for-azure-vm-in'\n| project Name, ResourceGroup, Region, VmSize, Instances, Series, Exposure,\n          AnnouncedRegionalPercent, EffectiveDate, Evidence, Scope, Source, ResourceId\n| order by AnnouncedRegionalPercent desc, Region asc, Name asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"VMs in regions with reported pricing changes - potential exposure","gridSettings":{"formatters":[{"columnMatch":"Name","formatter":1,"formatOptions":{"linkColumn":"ResourceId","linkTarget":"Resource","linkIsContextBlade":true,"customColumnWidthSetting":"18fr"}},{"columnMatch":"ResourceGroup","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"Instances","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"Exposure","formatter":0,"formatOptions":{"customColumnWidthSetting":"45fr"}},{"columnMatch":"AnnouncedRegionalPercent","formatter":0,"formatOptions":{"customColumnWidthSetting":"17fr"}},{"columnMatch":"EffectiveDate","formatter":6,"dateFormat":{"showUtcTime":true,"formatName":"shortDatePattern"},"formatOptions":{"customColumnWidthSetting":"13fr"}},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"Source","formatter":1,"formatOptions":{"linkTarget":"Url"}}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"VmSize","label":"Current size"},{"columnId":"ResourceGroup","label":"Resource group"},{"columnId":"AnnouncedRegionalPercent","label":"Reported regional %"},{"columnId":"EffectiveDate","label":"Reported effective date"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"regional-price-grid","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"InventoryView","comparison":"isEqualTo","value":"impacted"},"name":"grp-impacted"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Purchased reservation exposure\n\nActual reservation records visible to you in the **current tenant**, not inferred from VMs. This scope is independent of the VM subscription/lifecycle filters and includes records without a deployed VM. **Reservation access is separate from subscription Reader access**; [check permissions](https://learn.microsoft.com/azure/cost-management-billing/reservations/view-reservations).\n\n**Browse every API page** using Next reservation page, even when a page has no impacted matches. The default includes impacted and unassessed VM SKUs, including expired/cancelled historical records. Select Details for term, renewal, applied scope and IDs. **An empty or access-limited result does not prove no reservations exist.**\n\nExposure is a planning signal, not lost value, utilization or VM benefit attribution. Series cutoffs are not customer expiry dates; pricing signals do not reprice existing RI terms."},"name":"reservation-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":9,"name":"reservation-controls","content":{"version":"KqlParameterItem/1.0","style":"pills","parameters":[{"version":"KqlParameterItem/1.0","name":"ReservationPagePath","type":1,"value":"/providers/Microsoft.Capacity/reservations?api-version=2022-11-01&take=100","isHiddenWhenLocked":true,"isGlobal":true},{"version":"KqlParameterItem/1.0","name":"ReservationView","type":2,"label":"Show reservations","isRequired":true,"value":"affected","jsonData":"[{\"value\":\"affected\",\"label\":\"Impacted + unassessed VM SKUs\"},{\"value\":\"all\",\"label\":\"All visible VM reservations\"}]"},{"version":"KqlParameterItem/1.0","name":"ReservationEvidence","type":2,"label":"Result detail","isRequired":true,"value":"summary","jsonData":"[{\"value\":\"summary\",\"label\":\"Customer summary\"},{\"value\":\"raw\",\"label\":\"Advanced raw evidence\"}]"}]}},{"type":3,"name":"reservation-live","conditionalVisibility":{"parameterName":"ReservationEvidence","comparison":"isEqualTo","value":"raw"},"content":{"version":"KqlItem/1.0","queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GET\",\"data\":null,\"headers\":[],\"path\":\"{ReservationPagePath}\",\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"path\":\"$\",\"columnid\":\"Page\"}]}}]}","title":"Advanced: reservation API page","size":1,"visualization":"table","gridSettings":{"formatters":[{"columnMatch":"Page","formatter":0,"formatOptions":{"customColumnWidthSetting":"100fr"}}],"rowLimit":100},"noDataMessage":"Unknown: no reservation response. Check API errors and reservation-level permissions."},"customWidth":"100"},{"type":9,"name":"reservation-page-parameter","content":{"version":"KqlParameterItem/1.0","parameters":[{"version":"KqlParameterItem/1.0","name":"ReservationPageRecord","type":1,"isHiddenWhenLocked":true,"value":"","queryType":7,"query":"{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"6c2c0906-cb15-565f-9224-d6cf96ad917d\",\"mergeType\":\"table\",\"leftTable\":\"reservation-live\"}],\"projectRename\":[{\"originalName\":\"[reservation-live].Page\",\"mergedName\":\"Page\",\"fromId\":\"6c2c0906-cb15-565f-9224-d6cf96ad917d\"}]}"}]}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resourcecontainers\n| take 1\n| summarize Seed = count()\n| project RawPage = dynamic({ReservationPageRecord:json})\n| extend Page = iff(gettype(RawPage) == 'string', parse_json(tostring(RawPage)), RawPage)\n| extend RecordsKnown = gettype(Page.value) == 'array', Records = Page.value,\n         NextLink = tostring(Page.nextLink)\n| extend NextPagePath = extract(\n    @'(?i)^(?:https://management[.]azure[.]com)?(/providers/Microsoft[.]Capacity/reservations[?][^\\s#]+)$',\n    1, NextLink)\n| extend NextPagePath = iff(RecordsKnown and isnotempty(NextLink), NextPagePath, '')\n| project Evidence = case(\n    not(RecordsKnown), 'Unknown - no valid reservation response; check request errors and reservation permissions',\n    array_length(Records) > 100, 'Partial - API page exceeds the 100-row display limit; reconcile in Reservations',\n    isnotempty(NextLink) and isempty(NextPagePath), 'Partial - unsupported continuation; reconcile in Reservations',\n    isnotempty(NextLink), 'More pages - use Next reservation page; this is not a complete inventory',\n    array_length(Records) == 0, 'No visible reservations on this page - not proof the customer owns none',\n    'Last API page - visibility is still limited to reservations you can read'),\n  RowsInPage = array_length(Records),\n  Scope = 'Current tenant, reservation access; independent of the VM subscription/lifecycle filters',\n  NextPagePath","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Reservation visibility and page coverage","gridSettings":{"formatters":[{"columnMatch":"Evidence","formatter":0,"formatOptions":{"customColumnWidthSetting":"65fr"}},{"columnMatch":"RowsInPage","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"Scope","formatter":0,"formatOptions":{"customColumnWidthSetting":"25fr"}},{"columnMatch":"NextPagePath","formatter":5}],"rowLimit":100}},"name":"reservation-coverage","customWidth":"100"},{"type":9,"name":"reservation-next-parameter","content":{"version":"KqlParameterItem/1.0","parameters":[{"version":"KqlParameterItem/1.0","name":"ReservationNextPagePath","type":1,"isHiddenWhenLocked":true,"value":"","queryType":7,"query":"{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"5dea603b-e88b-5bc7-9307-e456e787ef25\",\"mergeType\":\"table\",\"leftTable\":\"reservation-coverage\"}],\"projectRename\":[{\"originalName\":\"[reservation-coverage].NextPagePath\",\"mergedName\":\"NextPagePath\",\"fromId\":\"5dea603b-e88b-5bc7-9307-e456e787ef25\"}]}"}]}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resourcecontainers\n| take 1\n| summarize Seed = count()\n| project RawPage = dynamic({ReservationPageRecord:json})\n| extend Page = iff(gettype(RawPage) == 'string', parse_json(tostring(RawPage)), RawPage)\n| extend RecordsKnown = gettype(Page.value) == 'array', Records = Page.value,\n         NextLink = tostring(Page.nextLink)\n| extend NextPagePath = extract(\n    @'(?i)^(?:https://management[.]azure[.]com)?(/providers/Microsoft[.]Capacity/reservations[?][^\\s#]+)$',\n    1, NextLink)\n| extend NextPagePath = iff(RecordsKnown and isnotempty(NextLink), NextPagePath, '')\n| where RecordsKnown\n| mv-expand Reservation = Records limit 2000\n| extend ResourceType = tostring(Reservation.properties.reservedResourceType)\n| where ResourceType =~ 'VirtualMachines' or isempty(ResourceType)\n| extend ReservedSku = tostring(Reservation.sku.name),\n         ReservationId = tostring(Reservation.id),\n         ReservationName = tostring(Reservation.properties.displayName),\n         Region = tostring(Reservation.location),\n         Quantity = tolong(Reservation.properties.quantity),\n         ExpiryOn = todatetime(coalesce(Reservation.properties.expiryDateTime, Reservation.properties.expiryDate)),\n         State = tostring(coalesce(Reservation.properties.displayProvisioningState, Reservation.properties.provisioningState)),\n         Term = tostring(Reservation.properties.term),\n         AutoRenew = tostring(Reservation.properties.renew),\n         AppliedScope = tostring(Reservation.properties.appliedScopeType),\n         AppliedScopes = tostring(Reservation.properties.appliedScopes),\n         AppliedScopeProperties = tostring(Reservation.properties.appliedScopeProperties),\n         PurchaseDate = tostring(coalesce(Reservation.properties.purchaseDateTime, Reservation.properties.purchaseDate)),\n         Archived = tostring(Reservation.properties.archived)\n| extend CatalogueRecord = tostring(parse_json(tolower('{LifecycleSkuMap}'))[tolower(ReservedSku)])\n| extend Fields = split(CatalogueRecord, '|')\n| extend Lifecycle = toupper(tostring(Fields[0])), Series = tostring(Fields[12]),\n         RetirementDate = tostring(Fields[2]), SeriesRiCutoff = tostring(Fields[11]),\n         SeriesPriceSignal = tostring(Fields[13]) == '1'\n| extend RegionalPriceSignal = isnotnull(parse_json('{\"northeurope\":17,\"francecentral\":11,\"francesouth\":11,\"westeurope\":9,\"norwayeast\":9,\"norwaywest\":9,\"southeastasia\":8}')[tolower(Region)])\n    and isnotempty(CatalogueRecord) and Series !in (dynamic([\"amv2\", \"av2\", \"blsv1\", \"bmsv1\", \"bsv1\", \"ddsv7\", \"dldsv7\", \"dlsv7\", \"dsv1\", \"dsv2\", \"dsv7\", \"dv1\", \"dv2\", \"edsv7\", \"esv7\", \"fsv1\", \"fsv2\", \"fv1\", \"gsv1\", \"gv1\", \"hcs\", \"lsv1\", \"lsv2\", \"npsv1\"]))\n    and not(tolower(ReservedSku) matches regex @'^standard_(d[0-9]+(-[0-9]+)?(s|ds|ls|lds)|e[0-9]+(-[0-9]+)?(s|ds))_v7$')\n| extend Exposure = case(\n    isempty(ResourceType) or isempty(ReservationId), 'Unknown reservation metadata',\n    isempty(CatalogueRecord), 'Unassessed SKU - manual review',\n    Lifecycle in ('RETIRE', 'EOL'), 'Retirement / EOL',\n    isnotempty(SeriesRiCutoff), 'RI purchase/renewal cutoff',\n    SeriesPriceSignal or RegionalPriceSignal, 'Pricing review - not an existing RI price change',\n    'No captured impact')\n| where '{ReservationView}' == 'all' or Exposure != 'No captured impact'\n| extend ReservationName = coalesce(ReservationName, ReservationId, 'Unknown'),\n         ReservedSku = coalesce(ReservedSku, 'Unknown'), Region = coalesce(Region, 'Unknown'),\n         Quantity = iff(Quantity >= 0, Quantity, tolong('')),\n         Expiry = iff(isnull(ExpiryOn), 'Unknown', format_datetime(ExpiryOn, 'yyyy-MM-dd')),\n         State = coalesce(State, 'Unknown'),\n         TermState = case(isnull(ExpiryOn), 'Unknown', ExpiryOn <= now(), 'Expired - historical record',\n                          'Unexpired date - benefit/state not certified'),\n         Details = 'Details'\n| project ReservationName, ReservedSku, Region, Quantity, Expiry, State, Exposure, Details,\n          Term, AutoRenew, TermState, AppliedScope, AppliedScopes, AppliedScopeProperties,\n          PurchaseDate, Archived, Lifecycle, Series, RetirementDate, SeriesRiCutoff,\n          SeriesPriceSignal, RegionalPriceSignal, ReservationId\n| order by Exposure asc, Expiry asc, ReservationName asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching VM reservations on this API page. Check coverage/errors, view All visible VM reservations and continue through remaining pages; this is not proof of no RI exposure.","title":"Purchased VM reservations - current API page","gridSettings":{"formatters":[{"columnMatch":"ReservationName","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"ReservedSku","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"16fr"}},{"columnMatch":"Quantity","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"Expiry","formatter":0,"formatOptions":{"customColumnWidthSetting":"13fr"}},{"columnMatch":"State","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"Exposure","formatter":0,"formatOptions":{"customColumnWidthSetting":"30fr"}},{"columnMatch":"Details","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"10fr"}},{"columnMatch":"Term","formatter":5},{"columnMatch":"AutoRenew","formatter":5},{"columnMatch":"TermState","formatter":5},{"columnMatch":"AppliedScope","formatter":5},{"columnMatch":"AppliedScopes","formatter":5},{"columnMatch":"AppliedScopeProperties","formatter":5},{"columnMatch":"PurchaseDate","formatter":5},{"columnMatch":"Archived","formatter":5},{"columnMatch":"Lifecycle","formatter":5},{"columnMatch":"Series","formatter":5},{"columnMatch":"RetirementDate","formatter":5},{"columnMatch":"SeriesRiCutoff","formatter":5},{"columnMatch":"SeriesPriceSignal","formatter":5},{"columnMatch":"RegionalPriceSignal","formatter":5},{"columnMatch":"ReservationId","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"reservation-inventory","customWidth":"100"},{"type":11,"name":"reservation-next-page","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"8f2dbf8f-88b2-5021-828f-eaaa011be340","cellValue":"ReservationPagePath","linkTarget":"parameter","linkLabel":"Next reservation page","subTarget":"{ReservationNextPagePath}","preText":"","style":"link"}]},"conditionalVisibility":{"parameterName":"ReservationNextPagePath","comparison":"isNotEqualTo","value":""}},{"type":11,"name":"reservation-first-page","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"094041e3-a5a2-5f5b-8c44-f48c2c35c762","cellValue":"ReservationPagePath","linkTarget":"parameter","linkLabel":"Return to first reservation page","subTarget":"/providers/Microsoft.Capacity/reservations?api-version=2022-11-01&take=100","preText":"","style":"link"}]}}]},"conditionalVisibility":{"parameterName":"InventoryView","comparison":"isEqualTo","value":"reservations"},"name":"grp-reservations"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":9,"name":"discovery-parameters","content":{"version":"KqlParameterItem/1.0","style":"pills","parameters":[{"version":"KqlParameterItem/1.0","name":"DiscoveryWorkload","label":"Workload signal","type":2,"isRequired":true,"value":"All","jsonData":"[{\"value\":\"All\",\"label\":\"All\"},{\"value\":\"AKS\",\"label\":\"AKS\"},{\"value\":\"Databricks\",\"label\":\"Databricks\"},{\"value\":\"AVD\",\"label\":\"AVD\"},{\"value\":\"SQL\",\"label\":\"SQL\"},{\"value\":\"SAP\",\"label\":\"SAP\"},{\"value\":\"Batch\",\"label\":\"Batch\"},{\"value\":\"ARO\",\"label\":\"ARO\"},{\"value\":\"Managed\",\"label\":\"Managed\"},{\"value\":\"Unclassified\",\"label\":\"Unclassified\"}]"},{"version":"KqlParameterItem/1.0","name":"BatchAccountId","type":1,"value":"","isHiddenWhenLocked":true},{"version":"KqlParameterItem/1.0","name":"BatchSelectedWorkload","type":1,"value":"","isHiddenWhenLocked":true}]}},{"type":1,"content":{"json":"## Workload ownership and observed evidence\n\nIdentify the owning service before choosing a resize or rebuild workflow. **No application complexity or migration approval is inferred from a platform score.** Owner associations, SQL registrations and SAP hints are discovery evidence, not proof of running software, healthy HA, stateless nodes or vendor certification. Use the table filter for resource groups and individual resources; export for full evidence.\n\n**Why Batch may be absent from the VM ownership grid:** it only contains VM/VMSS resources visible in the selected subscriptions. In **Batch service allocation mode**, pool VMs run in Microsoft-managed subscriptions, not your Compute inventory. Use **Service-owned pool configurations** below and **Live Batch pools (ARM)**. An absent VM row does not mean Batch is unowned or undiscovered.\n\nThe compute detail includes Flexible members and scale-set models: **do not sum these rows for fleet capacity**. The quota and coverage inventories count models once. Missing NIC/disk visibility is Unknown, not a passed check. Identity and Marketplace plans are rebuild dependencies, not blanket resize blockers.\n\nOS hints use a deliberately limited subset of the official NVMe/MANA lists, checked 18 November 2026. Other distributions/versions remain **Review**, not unsupported. Guest metadata takes precedence over old image labels; neither proves driver or boot readiness. Windows Server 2019 shared-disk NVMe compatibility needs separate review."},"name":"discovery-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets',\n    'microsoft.network/networkinterfaces', 'microsoft.compute/disks',\n    'microsoft.compute/virtualmachines/extensions', 'microsoft.sqlvirtualmachine/sqlvirtualmachines')\n| extend IsVmss = type =~ 'microsoft.compute/virtualmachinescalesets',\n         IsCompute = type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets'),\n         IsNic = type =~ 'microsoft.network/networkinterfaces', IsDisk = type =~ 'microsoft.compute/disks',\n         IsRegistration = type =~ 'microsoft.sqlvirtualmachine/sqlvirtualmachines',\n         IsExtension = type =~ 'microsoft.compute/virtualmachines/extensions'\n| extend IsSqlExtension = IsExtension and tostring(properties.publisher) =~ 'Microsoft.SqlServer.Management'\n            and (tostring(properties.type) =~ 'SqlIaaSAgent' or tostring(properties.typePropertiesType) =~ 'SqlIaaSAgent'),\n         IsAdeExtension = IsExtension and tostring(properties.publisher) in~ ('Microsoft.Azure.Security', 'Microsoft.Azure.Security.Edp')\n            and tostring(properties.type) in~ ('AzureDiskEncryption', 'AzureDiskEncryptionForLinux'),\n         IsSapExtension = IsExtension and tostring(properties.publisher) in~ ('Microsoft.AzureCAT.AzureEnhancedMonitoring', 'Microsoft.OSTCExtensions')\n            and tostring(properties.type) in~ ('MonitorX64Windows', 'MonitorX64Linux', 'AzureEnhancedMonitorForLinux', 'AzureCATExtensionHandler')\n| extend ComputeProfile = iff(IsVmss, properties.virtualMachineProfile, properties)\n| extend Keys = case(IsCompute, array_concat(pack_array(id),\n            coalesce(ComputeProfile.storageProfile.dataDisks, dynamic([])),\n            pack_array(tostring(ComputeProfile.storageProfile.osDisk.managedDisk.id))),\n        IsNic, pack_array(tostring(properties.virtualMachine.id)),\n        IsRegistration, pack_array(tostring(properties.virtualMachineResourceId)),\n        IsExtension, pack_array(tostring(split(tolower(id), '/extensions/')[0])),\n        IsDisk, pack_array(id), dynamic([]))\n| mv-expand Key = Keys limit 2000\n| extend VmId = tolower(iff(isnotempty(tostring(Key.managedDisk.id)), tostring(Key.managedDisk.id), tostring(Key)))\n| where isnotempty(VmId)\n| extend IsSelf = IsCompute and tolower(id) == VmId\n| summarize ComputeRows = countif(IsSelf),\n        VM = take_anyif(pack('id', id, 'type', type, 'name', name, 'resourceGroup', resourceGroup, 'subscriptionId', subscriptionId,\n            'location', location, 'properties', properties, 'sku', sku, 'tags', tags,\n            'identity', identity, 'plan', plan, 'managedBy', managedBy, 'zones', zones), IsSelf),\n        AttachedVmIds = make_set_if(tolower(id), IsCompute and not(IsSelf), 2000),\n        NicRows = countif(IsNic), AcceleratedNicRows = countif(IsNic and tobool(properties.enableAcceleratedNetworking) == true),\n        NicFlagRows = countif(IsNic and isnotnull(tobool(properties.enableAcceleratedNetworking))),\n        DiskRows = countif(IsDisk), SharedDiskRows = countif(IsDisk and toint(properties.maxShares) > 1),\n        AdeDiskRows = countif(IsDisk and tobool(properties.encryptionSettingsCollection.enabled) == true),\n        DiskIops = sumif(tolong(properties.diskIOPSReadWrite), IsDisk),\n        DiskMBps = sumif(toreal(properties.diskMBpsReadWrite), IsDisk),\n        DiskIopsKnown = countif(IsDisk and isnotnull(tolong(properties.diskIOPSReadWrite))),\n        DiskMBpsKnown = countif(IsDisk and isnotnull(toreal(properties.diskMBpsReadWrite))),\n        AdeExtensionRows = countif(IsAdeExtension), SapExtensionRows = countif(IsSapExtension),\n        SqlExtensionRows = countif(IsSqlExtension), SqlRegistrationRows = countif(IsRegistration),\n        SqlGroupIds = make_set_if(tostring(properties.sqlVirtualMachineGroupResourceId), IsRegistration, 20)\n    by VmId\n| extend ComputeKeys = iff(ComputeRows > 0, pack_array(VmId), AttachedVmIds)\n| mv-expand ComputeKey = ComputeKeys limit 2000\n| summarize VM = take_anyif(VM, ComputeRows > 0), ComputeRows = sum(ComputeRows),\n        NicRows = sum(NicRows), AcceleratedNicRows = sum(AcceleratedNicRows), NicFlagRows = sum(NicFlagRows),\n        DiskRows = sum(DiskRows), SharedDiskRows = sum(SharedDiskRows), AdeExtensionRows = sum(AdeExtensionRows),\n        AdeDiskRows = sum(AdeDiskRows), DiskIops = sum(DiskIops), DiskMBps = sum(DiskMBps),\n        DiskIopsKnown = sum(DiskIopsKnown), DiskMBpsKnown = sum(DiskMBpsKnown),\n        SapExtensionRows = sum(SapExtensionRows), SqlExtensionRows = sum(SqlExtensionRows),\n        SqlRegistrationRows = sum(SqlRegistrationRows), SqlGroupIds = take_anyif(SqlGroupIds, ComputeRows > 0)\n    by VmId = tostring(ComputeKey)\n| where ComputeRows == 1\n| extend ResourceId = tostring(VM.id), Name = tostring(VM.name), ResourceGroup = tostring(VM.resourceGroup),\n         SubscriptionId = tostring(VM.subscriptionId), Region = tostring(VM.location),\n         IsVmss = tostring(VM.type) =~ 'microsoft.compute/virtualmachinescalesets',\n         Profile = iff(tostring(VM.type) =~ 'microsoft.compute/virtualmachinescalesets', VM.properties.virtualMachineProfile, VM.properties)\n| extend VmSize = iff(IsVmss, tostring(VM.sku.name), tostring(Profile.hardwareProfile.vmSize)),\n         RgId = tolower(strcat('/subscriptions/', SubscriptionId, '/resourceGroups/', ResourceGroup)),\n         ExpectedNics = array_length(Profile.networkProfile.networkInterfaces),\n         DataDiskCount = array_length(Profile.storageProfile.dataDisks),\n         ImagePublisher = tostring(Profile.storageProfile.imageReference.publisher),\n         ImageOffer = tostring(Profile.storageProfile.imageReference.offer), ImageSku = tostring(Profile.storageProfile.imageReference.sku),\n         GuestOsName = tostring(VM.properties.extended.instanceView.osName)\n| extend ExpectedDisks = coalesce(DataDiskCount, 0) + iff(isnotempty(tostring(Profile.storageProfile.osDisk.managedDisk.id)), 1, 0)\n| extend DiskVisibilityComplete = not(IsVmss) and isnotnull(DataDiskCount) and DiskRows == ExpectedDisks and ExpectedDisks > 0,\n         NicVisibilityComplete = not(IsVmss) and isnotnull(ExpectedNics) and NicRows == ExpectedNics,\n         PlacementEvidence = strcat('Zones: ', tostring(VM.zones),\n             '; Availability set: ', tostring(VM.properties.availabilitySet.id),\n             '; Dedicated Host: ', tostring(VM.properties.host.id),\n             '; Host group: ', tostring(VM.properties.hostGroup.id),\n             '; PPG: ', tostring(VM.properties.proximityPlacementGroup.id),\n             '; Capacity reservation: ', tostring(Profile.capacityReservation.capacityReservationGroup.id),\n             '; Empty/missing associations do not verify target placement'),\n         ApplianceEvidence = iff(ImagePublisher in~ ('fortinet', 'paloaltonetworks', 'cisco',\n             'checkpoint', 'barracudanetworks', 'f5-networks', 'sophos', 'netapp', 'veeam',\n             'cohesity', 'rubrik') or tostring(VM.plan.publisher) in~ ('fortinet', 'paloaltonetworks',\n             'cisco', 'checkpoint', 'barracudanetworks', 'f5-networks', 'sophos', 'netapp',\n             'veeam', 'cohesity', 'rubrik'), strcat('Suspected vendor appliance - image/plan publishers: ',\n             ImagePublisher, '/', tostring(VM.plan.publisher),\n             '; verify exact product/version and target/NIC/driver/HA certification'),\n             'Unknown - image/plan and application owner review required; Marketplace alone is not an appliance signal')\n| extend ProvisionedDiskIops = iff(DiskVisibilityComplete and DiskIopsKnown == ExpectedDisks, DiskIops, tolong('')),\n         ProvisionedDiskMBps = iff(DiskVisibilityComplete and DiskMBpsKnown == ExpectedDisks, DiskMBps, toreal(''))\n| extend AcceleratedNetworking = case(IsVmss, 'Review scale-set NIC configurations',\n            isnull(ExpectedNics) or NicRows != ExpectedNics or NicFlagRows != NicRows, 'Unknown - incomplete NIC evidence',\n            strcat(AcceleratedNicRows, ' of ', ExpectedNics, ' NICs enabled')),\n         SharedDiskEvidence = case(SharedDiskRows > 0, 'Detected - review clustering and migration sequencing',\n            IsVmss or DiskRows != ExpectedDisks or ExpectedDisks == 0, 'Unknown - incomplete attached-disk evidence',\n            'No sharing-enabled attached disks observed'),\n         EphemeralOsDisk = case(tostring(Profile.storageProfile.osDisk.diffDiskSettings.option) =~ 'Local', 'Configured - rebuild/persistence review',\n            isempty(tostring(Profile.storageProfile.osDisk)), 'Unknown', 'Not configured in indexed model'),\n         UnmanagedDiskEvidence = iff(isnotempty(tostring(Profile.storageProfile.osDisk.vhd.uri)) or tostring(Profile.storageProfile.dataDisks) contains 'vhd',\n            'Detected - managed-disk migration review', 'No unmanaged disk reference observed'),\n         Hibernation = case(tobool(VM.properties.additionalCapabilities.hibernationEnabled) == true, 'Enabled - target support review',\n            isnull(VM.properties.additionalCapabilities.hibernationEnabled), 'Unknown - not recorded', 'Disabled in indexed model'),\n         SecurityType = iff(isempty(tostring(Profile.securityProfile.securityType)), 'Not recorded - verify effective security type', tostring(Profile.securityProfile.securityType)),\n         SystemAssignedIdentity = iff(tostring(VM.identity.type) contains 'SystemAssigned', 'Present - preserve/re-authorize if rebuilding', 'No system-assigned identity recorded'),\n         MarketplacePlan = strcat(tostring(VM.plan.publisher), ' / ', tostring(VM.plan.product)),\n         AdeEvidence = case(AdeExtensionRows > 0, 'Extension observed - guest encryption state unverified',\n             AdeDiskRows > 0, 'Attached-disk ADE configuration observed - confirm OS/data and guest state',\n             'Guest encryption state unverified'),\n         InventoryRole = case(IsVmss, 'Scale-set model', isnotempty(tostring(Profile.virtualMachineScaleSet.id)), 'Flexible member detail - do not add to model capacity', 'Standalone VM')\n| join kind=leftouter (\n    resources\n    | where type in~ ('microsoft.containerservice/managedclusters', 'microsoft.databricks/workspaces',\n        'microsoft.solutions/applications', 'microsoft.redhatopenshift/openshiftclusters')\n    | extend OwnerKind = case(type =~ 'microsoft.containerservice/managedclusters', 'AKS',\n             type =~ 'microsoft.databricks/workspaces', 'Databricks',\n             type =~ 'microsoft.redhatopenshift/openshiftclusters', 'ARO', 'Managed application')\n    | extend RgId = tolower(case(OwnerKind == 'AKS', strcat('/subscriptions/', subscriptionId, '/resourceGroups/', tostring(properties.nodeResourceGroup)),\n             OwnerKind == 'ARO', tostring(properties.clusterProfile.resourceGroupId), tostring(properties.managedResourceGroupId)))\n    | project RgId, OwnerKind, OwnerId = tolower(id)\n    | union (\n        resourcecontainers\n        | where type =~ 'microsoft.resources/subscriptions/resourcegroups' and isnotempty(tostring(managedBy))\n        | extend OwnerId = tolower(tostring(managedBy))\n        | project RgId = tolower(id), OwnerId, OwnerKind = case(\n            OwnerId contains '/microsoft.containerservice/managedclusters/', 'AKS',\n            OwnerId contains '/microsoft.databricks/workspaces/', 'Databricks',\n            OwnerId contains '/microsoft.batch/', 'Batch', 'Managed service')\n      )\n    | where isnotempty(RgId) and isnotempty(OwnerId)\n    | summarize OwnerIds = make_set(OwnerId, 20), OwnerKinds = make_set(OwnerKind, 20) by RgId\n  ) on RgId\n| join kind=leftouter (\n    desktopvirtualizationresources\n    | where type =~ 'microsoft.desktopvirtualization/hostpools/sessionhosts'\n    | extend VmId = tolower(tostring(properties.resourceId))\n    | where isnotempty(VmId)\n    | summarize AvdHostPoolIds = make_set(tostring(split(tolower(id), '/sessionhosts/')[0]), 20) by VmId\n  ) on VmId\n| extend Workload = trim('; ', strcat(\n        iff(array_length(OwnerKinds) > 0, strcat(strcat_array(OwnerKinds, '; '), '; '), ''),\n        iff(isnotempty(tostring(VM.managedBy)) and coalesce(array_length(OwnerKinds), 0) == 0, 'Managed service (compute managedBy); ', ''),\n        iff(array_length(AvdHostPoolIds) > 0, 'AVD; ', ''),\n        iff(SqlExtensionRows > 0 or SqlRegistrationRows > 0, 'SQL; ', ''),\n        iff(SapExtensionRows > 0 or tostring(Profile.licenseType) contains 'SLES_SAP' or ImageOffer contains 'sap', 'SAP signal; ', '')))\n| extend Workload = iff(isempty(Workload), 'Unclassified - guest/workload assessment required', Workload),\n         AssociationEvidence = strcat('Compute managedBy: ', tostring(VM.managedBy), '; Managed owners: ', tostring(OwnerIds), '; AVD host pools: ', tostring(AvdHostPoolIds),\n            '; SQL extensions/registrations: ', SqlExtensionRows, '/', SqlRegistrationRows, '; SAP extensions: ', SapExtensionRows),\n         MigrationMethod = case(array_length(OwnerIds) > 1, 'Multiple owner associations - resolve ownership before changes',\n            tostring(OwnerKinds) contains 'AKS', 'AKS node-pool workflow; validate surge, PDBs, persistence and capacity',\n            tostring(OwnerKinds) contains 'Databricks', 'Databricks-supported node type/runtime and cluster restart/recreation',\n            array_length(AvdHostPoolIds) > 0, 'AVD host replacement; check pooled/personal type, sessions, profiles and persistence',\n            tostring(OwnerKinds) contains 'Batch', 'Batch pool replacement; drain tasks and review autoscale/quotas',\n            array_length(OwnerKinds) > 0 or isnotempty(tostring(VM.managedBy)), 'Use owning service/vendor migration workflow; do not directly resize managed compute',\n            SqlExtensionRows > 0 or SqlRegistrationRows > 0 or Workload contains 'SAP', 'Stateful/vendor assessment before resize or rebuild; validate HA, licensing, backup and rollback',\n            'Determine application owner/state; then validate resize versus rebuild and rollback'),\n         MigrationApproval = 'Not assessed - application, HA, backup and rollback require evidence'\n\n| extend OsHintSource = iff(isnotempty(GuestOsName), 'Guest OS metadata', 'Image hint only - current guest unverified'),\n         OsHintText = tolower(iff(isnotempty(GuestOsName), GuestOsName, strcat(ImagePublisher, ' ', ImageOffer, ' ', ImageSku)))\n| extend NvmeOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2019|2022|2025)($|[^0-9])', 'Listed OS family - validate image, generation and boot',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(18[._-]04|20[._-]04|22[._-]04|24[._-]04)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        OsHintText matches regex @'debian[^0-9]{0,30}(11|12)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        'Review official NVMe OS list - not classified by captured subset'),\n         ManaOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2016|2019|2022|2025)($|[^0-9])', 'Listed OS family - install/verify current MANA driver',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(22[._-]04|24[._-]04|26[._-]04)($|[^0-9])', 'Listed OS family - verify minimum kernel and MANA driver',\n        'Review official MANA OS/kernel list - not classified by captured subset')\n| extend NvmeDriverValidation = 'Unknown - guest driver and target boot not tested',\n         ManaDriverValidation = 'Unknown - target hardware, driver and traffic not tested',\n         NvmeOsReference = 'https://learn.microsoft.com/azure/virtual-machines/enable-nvme-interface',\n         ManaOsReference = 'https://learn.microsoft.com/azure/virtual-network/accelerated-networking-overview',\n         OsReferenceChecked = '2026-11-18'\n| extend CatalogueRecord = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| extend CatalogueCoverage = iff(isempty(CatalogueRecord), 'Not assessed - SKU absent from captured catalogue', tostring(split(CatalogueRecord, '|')[0]))\n| where '{DiscoveryWorkload}' == 'All' or Workload contains '{DiscoveryWorkload}'\n\n| project Name, ResourceGroup, SubscriptionId, Region, VmSize, CatalogueCoverage, Workload, MigrationMethod,\n    AcceleratedNetworking, ExpectedNics, DataDiskCount, SharedDiskEvidence, EphemeralOsDisk,\n    UnmanagedDiskEvidence, Hibernation, SecurityType, SystemAssignedIdentity, MarketplacePlan, AdeEvidence,\n    AdeDiskRows, ApplianceEvidence, PlacementEvidence, DiskVisibilityComplete, NicVisibilityComplete,\n    ProvisionedDiskIops, ProvisionedDiskMBps,\n    OsHintSource, NvmeOsHint, ManaOsHint, NvmeDriverValidation, ManaDriverValidation,\n    OsReferenceChecked, NvmeOsReference, ManaOsReference, AssociationEvidence, OwnerIds, AvdHostPoolIds,\n    SqlGroupIds, MigrationApproval, InventoryRole, ResourceId\n| order by Workload asc, Name asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Observed subscription VM / VMSS ownership and prerequisites","gridSettings":{"formatters":[{"columnMatch":"Name","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"Workload","formatter":0,"formatOptions":{"customColumnWidthSetting":"24fr"}},{"columnMatch":"MigrationMethod","formatter":0,"formatOptions":{"customColumnWidthSetting":"65fr"}},{"columnMatch":"CatalogueCoverage","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"ResourceGroup","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"SubscriptionId","formatter":5},{"columnMatch":"OwnerIds","formatter":5},{"columnMatch":"AvdHostPoolIds","formatter":5},{"columnMatch":"SqlGroupIds","formatter":5},{"columnMatch":"NvmeOsReference","formatter":5},{"columnMatch":"ManaOsReference","formatter":5},{"columnMatch":"OsReferenceChecked","formatter":5},{"columnMatch":"NvmeDriverValidation","formatter":5},{"columnMatch":"ManaDriverValidation","formatter":5},{"columnMatch":"AdeDiskRows","formatter":5},{"columnMatch":"ApplianceEvidence","formatter":5},{"columnMatch":"PlacementEvidence","formatter":5},{"columnMatch":"DiskVisibilityComplete","formatter":5},{"columnMatch":"NicVisibilityComplete","formatter":5},{"columnMatch":"ProvisionedDiskIops","formatter":5},{"columnMatch":"ProvisionedDiskMBps","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"discovery-compute","customWidth":"100"},{"type":1,"content":{"json":"### Service-owned pool configurations\n\nThis is the ownership view for **Batch service-mode compute**, including pools with zero nodes. Each Batch pool belongs to its Batch account; use the **Batch pool/task migration workflow**, not a direct VM resize. AKS pools are also shown as service-owned configuration. These are **pool records, not additional VM/VMSS rows**; do not add them to fleet totals or subscription Compute quota demand.\n\nConfigured sizes and lifecycle classifications remain relevant when nodes are stopped. **Autoscaler maxima, surge and Batch demand are not automatically added to the existing Compute quota plan**; validate service-specific quotas and peak capacity separately. **Resource Graph may omit Batch pools even when ARM lists them.** Empty/missing pool profiles do not prove that the service has no nodes. Select a Batch account in **Independent service registrations** to inspect its pools directly through ARM below."},"name":"discovery-pool-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| union batchresources\n| where type in~ ('microsoft.containerservice/managedclusters', 'microsoft.batch/batchaccounts/pools')\n| extend Workload = iff(type =~ 'microsoft.containerservice/managedclusters', 'AKS', 'Batch')\n| where '{DiscoveryWorkload}' == 'All' or Workload contains '{DiscoveryWorkload}'\n| extend Pools = iff(Workload == 'AKS', properties.agentPoolProfiles, pack_array(properties))\n| mv-expand Pool = Pools limit 2000\n| extend VmSize = tostring(Pool.vmSize)\n| extend CatalogueRecord = tostring(parse_json(tolower('{LifecycleSkuMap}'))[tolower(VmSize)])\n| project Service = name, Workload, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n    Region = location, Pool = iff(Workload == 'AKS', tostring(Pool.name), name), VmSize,\n    Lifecycle = iff(isempty(CatalogueRecord), 'Not assessed - no catalogue match', toupper(tostring(split(CatalogueRecord, '|')[0]))),\n    ConfiguredNodes = toint(Pool['count']), Autoscaling = tostring(Pool.enableAutoScaling),\n    MinimumNodes = toint(Pool.minCount), MaximumNodes = toint(Pool.maxCount),\n    MaxSurge = tostring(Pool.upgradeSettings.maxSurge), OsSku = tostring(Pool.osSKU),\n    OsDiskType = tostring(Pool.osDiskType), Priority = tostring(coalesce(Pool.scaleSetPriority, Pool.scaleSettings.fixedScale.targetLowPriorityNodes)),\n    BatchCurrentDedicated = toint(Pool.currentDedicatedNodes), BatchCurrentLowPriority = toint(Pool.currentLowPriorityNodes),\n    BatchTargetDedicated = toint(Pool.scaleSettings.fixedScale.targetDedicatedNodes),\n    BatchTargetLowPriority = toint(Pool.scaleSettings.fixedScale.targetLowPriorityNodes),\n    BatchAutoscaleFormula = tostring(Pool.scaleSettings.autoScale.formula),\n    MigrationMethod = iff(Workload == 'AKS', 'Node-pool migration; validate PDBs, persistence, surge and autoscaler maximum',\n        'Pool/task migration; validate image, task slots, drainage and autoscale demand'),\n    Evidence = 'Configured pool, not observed running nodes; not additive to VM/VMSS inventory', ResourceId = id\n| order by Workload asc, Service asc, Pool asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Service-owned AKS / Batch pools, lifecycle and migration method (not VM inventory)","gridSettings":{"formatters":[{"columnMatch":"Service","formatter":0,"formatOptions":{"customColumnWidthSetting":"28fr"}},{"columnMatch":"Pool","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"ResourceId","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"discovery-pools","customWidth":"100"},{"type":1,"content":{"json":"### Independent service registrations\n\nThese registrations remain visible without observable backing VMs. Counts are not additive to compute inventory. A service's location need not be its VM location. AVD host-pool type is shown here; SQL groups do not prove active Always On membership. Serverless/terminated Databricks compute and guest application roles are not enumerated."},"name":"discovery-service-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| union batchresources\n| where type in~ ('microsoft.containerservice/managedclusters', 'microsoft.databricks/workspaces',\n    'microsoft.batch/batchaccounts', 'microsoft.batch/batchaccounts/pools', 'microsoft.solutions/applications',\n    'microsoft.redhatopenshift/openshiftclusters', 'microsoft.desktopvirtualization/hostpools',\n    'microsoft.sqlvirtualmachine/sqlvirtualmachines', 'microsoft.workloads/sapvirtualinstances',\n    'microsoft.workloads/sapvirtualinstances/applicationinstances', 'microsoft.workloads/sapvirtualinstances/centralinstances',\n    'microsoft.workloads/sapvirtualinstances/databaseinstances')\n| extend Workload = case(type contains 'microsoft.containerservice/', 'AKS', type contains 'microsoft.databricks/', 'Databricks',\n    type contains 'microsoft.batch/', 'Batch', type contains 'microsoft.desktopvirtualization/', 'AVD',\n    type contains 'microsoft.sqlvirtualmachine/', 'SQL', type contains 'microsoft.workloads/', 'SAP',\n    type contains 'microsoft.redhatopenshift/', 'ARO', 'Managed application')\n| where '{DiscoveryWorkload}' == 'All' or Workload contains '{DiscoveryWorkload}'\n| project Name = name, Workload, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n    ServiceRegion = location, ServiceType = type, ResourceId = id,\n    HostPoolType = tostring(properties.hostPoolType), NodeProvisioningMode = tostring(properties.nodeProvisioningProfile.mode),\n    ManagedResourceGroup = coalesce(tostring(properties.managedResourceGroupId), tostring(properties.nodeResourceGroup)),\n    LinkedVm = tostring(properties.virtualMachineResourceId), ConfiguredPools = properties.agentPoolProfiles,\n    SqlEdition = tostring(properties.sqlImageSku), SqlLicenseType = tostring(properties.sqlServerLicenseType),\n    SapVmDetails = properties.vmDetails,\n    Evidence = 'Indexed service registration/configuration; backing compute and runtime not established'\n| order by Workload asc, Name asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Services, including registrations without visible backing compute (select a Batch account for live pools)","gridSettings":{"formatters":[{"columnMatch":"Name","formatter":0,"formatOptions":{"customColumnWidthSetting":"28fr"}},{"columnMatch":"Workload","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"ResourceGroup","formatter":0,"formatOptions":{"customColumnWidthSetting":"24fr"}},{"columnMatch":"ResourceId","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all","exportedParameters":[{"fieldName":"ResourceId","parameterName":"BatchAccountId","parameterType":1},{"fieldName":"Workload","parameterName":"BatchSelectedWorkload","parameterType":1}]},"name":"discovery-services","customWidth":"100"},{"type":1,"content":{"json":"### Live Batch pools (ARM)\n\n**Select a Batch account row above** to read its pool configurations directly from Azure Resource Manager, independently of Resource Graph pool indexing. This read-only inspection requires pool read permission. Empty output or an API error is **not proof of zero pools**; check the selected account and permissions.\n\nUse the **Batch pool/task migration workflow**, not a direct VM resize. These records are not additional subscription VMs and are not additive to fleet totals. Dedicated and Spot counts show current and fixed-scale targets; blank targets can indicate autoscaling, whose formula is shown separately. Configured sizes are evidence, not migration eligibility; this direct inspection does not apply the ARG lifecycle map."},"name":"discovery-batch-live-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"name":"discovery-batch-live","conditionalVisibility":{"parameterName":"BatchSelectedWorkload","comparison":"isEqualTo","value":"Batch"},"content":{"version":"KqlItem/1.0","queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GETARRAY\",\"data\":null,\"headers\":[],\"path\":\"{BatchAccountId}/pools?api-version=2024-07-01\",\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"path\":\"$.name\",\"columnid\":\"Pool\"},{\"path\":\"$.properties.vmSize\",\"columnid\":\"VmSize\"},{\"path\":\"$.properties.currentDedicatedNodes\",\"columnid\":\"DedicatedNow\"},{\"path\":\"$.properties.currentLowPriorityNodes\",\"columnid\":\"SpotNow\"},{\"path\":\"$.properties.scaleSettings.fixedScale.targetDedicatedNodes\",\"columnid\":\"DedicatedTarget\"},{\"path\":\"$.properties.scaleSettings.fixedScale.targetLowPriorityNodes\",\"columnid\":\"SpotTarget\"},{\"path\":\"$.properties.scaleSettings.autoScale.formula\",\"columnid\":\"Autoscale\"}]}}]}","title":"Live Batch pools (ARM) - {BatchAccountId}","size":1,"visualization":"table","showExportToExcel":true,"noDataMessage":"Unknown: no pool rows returned. Check account selection, permissions and the ARM request; do not infer zero pools.","gridSettings":{"formatters":[{"columnMatch":"Pool","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"Autoscale","formatter":0,"formatOptions":{"customColumnWidthSetting":"40fr"}}],"rowLimit":100,"filter":true}},"customWidth":"100"}]},"conditionalVisibility":{"parameterName":"InventoryView","comparison":"isEqualTo","value":"discovery"},"name":"grp-discovery"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Check what was not assessed\n\nSizes absent from the captured catalogue are **unassessed**, not approved or necessarily retiring. Assign an owner to research their lifecycle and target path. The all-sizes grid includes optional sizes independently of the lifecycle filter."},"name":"coverage-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| summarize Resources = count(), Instances = sum(Instances) by Lifecycle, ActionCategory\n| order by Instances desc","size":4,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Coverage - resources matched to the lifecycle catalogue","gridSettings":{"formatters":[{"columnMatch":"Lifecycle","formatter":0,"formatOptions":{"customColumnWidthSetting":"26fr"}},{"columnMatch":"ActionCategory","formatter":0,"formatOptions":{"customColumnWidthSetting":"32fr"}},{"columnMatch":"Resources","formatter":0,"formatOptions":{"customColumnWidthSetting":"21fr"}},{"columnMatch":"Instances","formatter":0,"formatOptions":{"customColumnWidthSetting":"21fr"}}],"rowLimit":100,"labelSettings":[{"columnId":"ActionCategory","label":"Lifecycle status"}]}},"name":"about-coverage","customWidth":"100"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| extend CatalogueRecord = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| extend CatalogueCoverage = iff(isempty(CatalogueRecord), 'Not assessed - SKU absent from captured catalogue',\n         strcat('Captured classification: ', tostring(split(CatalogueRecord, '|')[0])))\n| summarize Resources = count(), Instances = sum(Instances) by VmSize, CatalogueCoverage\n| order by CatalogueCoverage asc, Instances desc","size":4,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"All sizes in scope - explicit captured-catalogue coverage","gridSettings":{"formatters":[{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"24fr"}},{"columnMatch":"CatalogueCoverage","formatter":0,"formatOptions":{"customColumnWidthSetting":"50fr"}},{"columnMatch":"Resources","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"Instances","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}}],"rowLimit":100,"labelSettings":[{"columnId":"VmSize","label":"Size"}]}},"name":"about-allsizes","customWidth":"100"},{"type":1,"content":{"json":"### Reconcile native Advisor evidence\n\nRead-only, built-in `AdvisorResources`: retirement-text candidates associated with Compute resources, not an authoritative or exhaustive VM-size retirement feed. Includes other Compute retirement recommendations for owner review. Empty/missing results do not prove absence; investigate indexing, permissions, Service Health notices and official lifecycle dates. Does not change catalogue classifications."},"name":"advisor-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"advisorresources\n| where type =~ 'microsoft.advisor/recommendations'\n| extend ResourceId = tostring(properties.resourceMetadata.resourceId),\n         Problem = tostring(properties.shortDescription.problem),\n         Recommendation = tostring(properties.shortDescription.solution)\n| where tolower(ResourceId) contains '/microsoft.compute/'\n| where strcat(Problem, ' ', Recommendation, ' ', tostring(properties.extendedProperties)) contains 'retir'\n| project ResourceId, Problem, Recommendation, Category = tostring(properties.category),\n          LastUpdated = tostring(properties.lastUpdated), ExtendedEvidence = properties.extendedProperties,\n          Evidence = 'Indexed Advisor retirement candidate - reconcile with official lifecycle and Service Health',\n          EvaluatedAt = now()\n| order by ResourceId asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Indexed Advisor Compute retirement candidates - reconcile, do not auto-approve","gridSettings":{"formatters":[{"columnMatch":"ResourceId","formatter":0,"formatOptions":{"customColumnWidthSetting":"40fr"}},{"columnMatch":"Problem","formatter":0,"formatOptions":{"customColumnWidthSetting":"45fr"}},{"columnMatch":"Recommendation","formatter":0,"formatOptions":{"customColumnWidthSetting":"60fr"}},{"columnMatch":"Category","formatter":5},{"columnMatch":"LastUpdated","formatter":5},{"columnMatch":"ExtendedEvidence","formatter":5},{"columnMatch":"Evidence","formatter":5},{"columnMatch":"EvaluatedAt","formatter":5}],"rowLimit":100},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"advisor-retirement","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"InventoryView","comparison":"isEqualTo","value":"coverage"},"name":"grp-coverage"},{"type":11,"name":"workflow-next-inventory","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"ac3fd955-e361-5e10-b6f1-d0b7b293571a","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Previous: Start here","subTarget":"start","preText":"","style":"link"},{"id":"256d362d-9142-5ac2-a076-b4cd6617b440","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Next: 2. Assess","subTarget":"assess","preText":"","style":"primary"},{"id":"7e73fb7a-3572-5219-b98b-dbd599d2b005","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Help: Methodology & references","subTarget":"about","preText":"","style":"link"}]}}]},"conditionalVisibility":{"parameterName":"WorkflowStage","comparison":"isEqualTo","value":"inventory"},"name":"stage-inventory"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## 2. Assess - what could prevent a successful migration?\n\n**Goal:** Choose a candidate path and identify prerequisite work and missing evidence.\n\n**What to do:** Review V5 first and compare V6/V7 where justified. Review Routes & gates, Required actions and SQL opportunities with the workload owner. Check live target availability and quota in Plan. Export the detailed grids only when you need the full evidence columns.\n\n**Before moving on:** Record a preferred target and migration method. Resolve Not met checks and assign every Unknown check an owner, evidence requirement and decision date.\n\n**Outcome / interpretation:** A candidate path and assessment backlog, not migration approval. Met is evidence for one check; Unknown is not a pass; Not applicable does not imply overall readiness."},"name":"workflow-guide-assess","styleSettings":{"margin":"0","padding":"0"}},{"type":1,"content":{"json":"**Evidence key:** catalogue/reference dates are shown in Start here. Inventory, ownership, Advisor and quota are **indexed ARG** data at refresh, not real-time allocation or guest telemetry. The selected SKU record is **live ARM** at inspection. Guest/application/recovery evidence is **customer-confirmed** and stays Unknown here until independently verified. **Captured as of:** catalogue 2026-09-22T18:03:33; quota family/CPU map 2026-11-17T17:43:27.5429677Z."},"name":"workflow-evidence-assess","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"workflow-views-assess","content":{"version":"LinkItem/1.0","style":"tabs","links":[{"id":"8d7458f5-d0a2-5feb-9cd0-f0701a5a3d86","cellValue":"AssessView","linkTarget":"parameter","linkLabel":"V5 / V6 / V7 paths","subTarget":"paths","preText":"","style":"link"},{"id":"df6a4587-22aa-5f65-96b8-83f95e162ff6","cellValue":"AssessView","linkTarget":"parameter","linkLabel":"Routes & gates","subTarget":"routes","preText":"","style":"link"},{"id":"350444e7-bb65-57d9-8101-2ea9e0856a2d","cellValue":"AssessView","linkTarget":"parameter","linkLabel":"Required actions","subTarget":"prereq","preText":"","style":"link"},{"id":"2b1488bf-58c1-51d4-9eb7-392d49deacb4","cellValue":"AssessView","linkTarget":"parameter","linkLabel":"SQL opportunities","subTarget":"sql","preText":"","style":"link"}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Compare upgrade paths\n\nThe same retiring resources are assessed against **independent V5, V6 and V7 targets**. No suitable catalogue match means manual selection, not a fallback to another generation. These panels distinguish observed configuration from prerequisites and **unverified guest readiness**. They do not resize a VM or certify a migration. Export any grid for the full evidence columns. Continue to **Plan > Live target availability**, then **Capacity & quota**."},"name":"paths-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":12,"name":"path-v5-panel","customWidth":"100","content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### V5 upgrade path\n\nPrefer a catalogued non-NVMe v5 target. Gen1 conversion is required only if that selected target is Gen2-only; do not assume decryption or an OS upgrade is mandatory for every v5 resize."},"name":"path-v5-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{V5PathSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| where Lifecycle != 'OPTIONAL'\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{V5PathRegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{V5PathRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| extend OsHintSource = iff(isnotempty(GuestOsName), 'Guest OS metadata', 'Image hint only - current guest unverified'),\n         OsHintText = tolower(iff(isnotempty(GuestOsName), GuestOsName, strcat(ImagePublisher, ' ', ImageOffer, ' ', ImageSku)))\n| extend NvmeOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2019|2022|2025)($|[^0-9])', 'Listed OS family - validate image, generation and boot',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(18[._-]04|20[._-]04|22[._-]04|24[._-]04)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        OsHintText matches regex @'debian[^0-9]{0,30}(11|12)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        'Review official NVMe OS list - not classified by captured subset'),\n         ManaOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2016|2019|2022|2025)($|[^0-9])', 'Listed OS family - install/verify current MANA driver',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(22[._-]04|24[._-]04|26[._-]04)($|[^0-9])', 'Listed OS family - verify minimum kernel and MANA driver',\n        'Review official MANA OS/kernel list - not classified by captured subset')\n| extend NvmeDriverValidation = 'Unknown - guest driver and target boot not tested',\n         ManaDriverValidation = 'Unknown - target hardware, driver and traffic not tested',\n         NvmeOsReference = 'https://learn.microsoft.com/azure/virtual-machines/enable-nvme-interface',\n         ManaOsReference = 'https://learn.microsoft.com/azure/virtual-network/accelerated-networking-overview',\n         OsReferenceChecked = '2026-11-18'\n| extend ImageProvenance = case(\n        isnotempty(ImageId), 'Custom/gallery image - verify guest drivers',\n        isnotempty(ImagePublisher), 'Marketplace origin - guest changes unverified',\n        'Unknown image lineage - verify guest drivers')\n| extend OsEvidence = case(\n        isnotempty(GuestOsName), strcat('Guest OS metadata: ', GuestOsName),\n        OsType =~ 'Windows' and ImageSku contains '2016', 'Server 2016 image hint - current guest OS unverified',\n        'Guest OS version unverified')\n| extend EncryptionEvidence = iff(DiskAdeConfigured == true,\n        'OS disk encryption configuration detected - guest state unverified',\n        'Guest BitLocker/ADE state unverified')\n| extend ConversionOsCheck = case(\n        OsType !~ 'Windows' or NeedsGen2 == 0, '',\n        GuestOsName contains '2016', '; Server 2016 detected: OS upgrade/rebuild before documented Trusted Launch conversion',\n        isempty(GuestOsName) and ImageSku contains '2016', '; Server 2016 image hint: confirm guest version; upgrade/rebuild if still 2016 before documented Trusted Launch conversion',\n        '; Verify Windows OS eligibility for the chosen conversion route')\n| extend ConversionEncryptionCheck = case(\n        OsType !~ 'Windows' or NeedsGen2 == 0, '',\n        DiskAdeConfigured == true, '; Encryption config detected: address Windows OS encryption before documented Trusted Launch conversion',\n        '; Guest encryption unknown: check BitLocker/ADE before conversion')\n| extend Prerequisites = iff(isempty(RecommendedTarget),\n        'No compatible target in this generation in the captured catalogue - manual selection required',\n        strcat('Generation ', VmGeneration, ': ', Blockers,\n            ConversionOsCheck, ConversionEncryptionCheck,\n            iff(NeedsGen2 == 1, '; Convert/rebuild to Gen2; validate partition layout and chosen route; Backup/ASR prerequisites apply to Trusted Launch conversion', ''),\n            iff(PenNvme > 0 and isnotempty(DiskControllers) and DiskControllers !contains 'NVMe',\n                '; Current OS disk does not advertise NVMe - validate image/disk/boot-driver compatibility', '')))\n| extend Validation = strcat('Catalogue region: ', TargetInRegion, '. ', OsEvidence, '. ',\n        EncryptionEvidence, '. ', ImageProvenance,\n        '. ', NvmeOsHint, '. ', ManaOsHint,\n        '. Unverified: MANA/traffic, target policy/capacity, storage IOPS/NIC limits, application/rollback. ',\n        'Use Plan > Capacity & quota with the matching target scenario; the default V5-first result is not a V6/V7-path quota approval.',\n        iff(WarnCodes has 'l', ' Target local-disk capacity unknown: confirm before choosing this target.', ''))\n| extend Resource = strcat(Name, ' [', VmSize, ']'),\n         Target = iff(isempty(RecommendedTarget), 'Manual selection required', RecommendedTarget),\n         ConversionRequired = iff(isempty(RecommendedTarget) or VmGeneration == 'Unknown', tobool(''), NeedsGen2 == 1),\n         NvmeRequired = iff(isempty(RecommendedTarget), tobool(''), PenNvme > 0)\n| extend TargetSelection = iff(isempty(RecommendedTarget), 'Not met', 'Met'),\n         GenerationSupport = case(isempty(RecommendedTarget) or VmGeneration == 'Unknown', 'Unknown',\n             NeedsGen2 == 1, 'Not met', 'Met'),\n         ConversionOS = case(isempty(RecommendedTarget), 'Unknown',\n             isempty(OsType) and WarnCodes has 'g' and VmGeneration != 'V2', 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2' or OsType !~ 'Windows', 'Not applicable',\n             VmGeneration == 'Unknown', 'Unknown',\n             GuestOsName contains '2016', 'Not met', 'Unknown'),\n         ConversionEncryption = case(isempty(RecommendedTarget), 'Unknown',\n             isempty(OsType) and WarnCodes has 'g' and VmGeneration != 'V2', 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2' or OsType !~ 'Windows', 'Not applicable',\n             VmGeneration == 'Unknown', 'Unknown',\n             DiskAdeConfigured == true, 'Not met', 'Unknown'),\n         NvmeBoot = case(isempty(RecommendedTarget), 'Unknown',\n             PenNvme == 0, 'Not applicable',\n             isnotempty(DiskControllers) and DiskControllers !contains 'NVMe', 'Not met', 'Unknown'),\n         ManaNetworking = 'Unknown',\n         Architecture = case(isempty(RecommendedTarget), 'Unknown', PenArch > 0, 'Not met', 'Met'),\n         MemoryCapacity = case(isempty(RecommendedTarget) or isnull(toreal(TargetMemoryGB)) or isnull(CurrentMemoryGB), 'Unknown',\n             PenMem > 0, 'Not met', 'Met'),\n         LocalDisk = case(isempty(RecommendedTarget) or WarnCodes has 'l', 'Unknown',\n             PenTemp > 0, 'Not met', 'Unknown'),\n         CatalogueRegion = case(TargetInRegion == 'Yes', 'Met', TargetInRegion == 'No', 'Not met', 'Unknown'),\n         ZonePlacement = iff(isempty(Zone), 'Not applicable', 'Unknown'),\n         AvailabilitySet = iff(isempty(AvSetId), 'Not applicable', 'Unknown'),\n         ScaleSetModel = iff(IsVmss, 'Unknown', 'Not applicable'),\n         DiskLimits = 'Unknown', NicLimits = 'Unknown',\n         Quota = 'Unknown', Policy = 'Unknown', AllocationCapacity = 'Unknown',\n         Backup = 'Unknown',\n         AsrConversion = case(isempty(RecommendedTarget), 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2', 'Not applicable', 'Unknown'),\n         ApplicationValidation = 'Unknown', Rollback = 'Unknown'\n\n| extend ChecksNotMet = iff(TargetSelection == 'Not met', 1, 0) + iff(GenerationSupport == 'Not met', 1, 0) + iff(ConversionOS == 'Not met', 1, 0) + iff(ConversionEncryption == 'Not met', 1, 0) + iff(NvmeBoot == 'Not met', 1, 0) + iff(ManaNetworking == 'Not met', 1, 0) + iff(Architecture == 'Not met', 1, 0) + iff(MemoryCapacity == 'Not met', 1, 0) + iff(LocalDisk == 'Not met', 1, 0) + iff(CatalogueRegion == 'Not met', 1, 0) + iff(ZonePlacement == 'Not met', 1, 0) + iff(AvailabilitySet == 'Not met', 1, 0) + iff(ScaleSetModel == 'Not met', 1, 0) + iff(DiskLimits == 'Not met', 1, 0) + iff(NicLimits == 'Not met', 1, 0) + iff(Quota == 'Not met', 1, 0) + iff(Policy == 'Not met', 1, 0) + iff(AllocationCapacity == 'Not met', 1, 0) + iff(Backup == 'Not met', 1, 0) + iff(AsrConversion == 'Not met', 1, 0) + iff(ApplicationValidation == 'Not met', 1, 0) + iff(Rollback == 'Not met', 1, 0),\n         ChecksUnknown = iff(TargetSelection == 'Unknown', 1, 0) + iff(GenerationSupport == 'Unknown', 1, 0) + iff(ConversionOS == 'Unknown', 1, 0) + iff(ConversionEncryption == 'Unknown', 1, 0) + iff(NvmeBoot == 'Unknown', 1, 0) + iff(ManaNetworking == 'Unknown', 1, 0) + iff(Architecture == 'Unknown', 1, 0) + iff(MemoryCapacity == 'Unknown', 1, 0) + iff(LocalDisk == 'Unknown', 1, 0) + iff(CatalogueRegion == 'Unknown', 1, 0) + iff(ZonePlacement == 'Unknown', 1, 0) + iff(AvailabilitySet == 'Unknown', 1, 0) + iff(ScaleSetModel == 'Unknown', 1, 0) + iff(DiskLimits == 'Unknown', 1, 0) + iff(NicLimits == 'Unknown', 1, 0) + iff(Quota == 'Unknown', 1, 0) + iff(Policy == 'Unknown', 1, 0) + iff(AllocationCapacity == 'Unknown', 1, 0) + iff(Backup == 'Unknown', 1, 0) + iff(AsrConversion == 'Unknown', 1, 0) + iff(ApplicationValidation == 'Unknown', 1, 0) + iff(Rollback == 'Unknown', 1, 0)\n| extend Review = 'All 22 checks'\n| project Resource, Target, GenerationSupport, NvmeBoot, ManaNetworking,\n          ChecksNotMet, ChecksUnknown, Review, TargetSelection, ConversionOS,\n          ConversionEncryption, Architecture, MemoryCapacity,\n          LocalDisk, CatalogueRegion, ZonePlacement, AvailabilitySet, ScaleSetModel,\n          DiskLimits, NicLimits, Quota, Policy, AllocationCapacity, Backup, AsrConversion,\n          ApplicationValidation, Rollback,\n          Prerequisites, Validation, ResourceId,\n          VmGeneration, ConversionRequired, NvmeRequired, ImageProvenance, OsEvidence, EncryptionEvidence,\n          OsHintSource, NvmeOsHint, ManaOsHint, NvmeDriverValidation, ManaDriverValidation,\n          NvmeOsReference, ManaOsReference, OsReferenceChecked\n| order by Resource asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"V5 targets - select All 22 checks for per-VM details","gridSettings":{"formatters":[{"columnMatch":"Resource","formatter":1,"formatOptions":{"linkColumn":"ResourceId","linkTarget":"Resource","linkIsContextBlade":true,"customColumnWidthSetting":"20fr"}},{"columnMatch":"Target","formatter":0,"formatOptions":{"customColumnWidthSetting":"19fr"}},{"columnMatch":"GenerationSupport","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"NvmeBoot","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"ManaNetworking","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"ChecksNotMet","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":0,"representation":"red","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"9fr"}},{"columnMatch":"ChecksUnknown","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":0,"representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"9fr"}},{"columnMatch":"Review","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"15fr"}},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"Prerequisites","formatter":5},{"columnMatch":"Validation","formatter":5},{"columnMatch":"VmGeneration","formatter":5},{"columnMatch":"ConversionRequired","formatter":5},{"columnMatch":"NvmeRequired","formatter":5},{"columnMatch":"ImageProvenance","formatter":5},{"columnMatch":"OsEvidence","formatter":5},{"columnMatch":"EncryptionEvidence","formatter":5},{"columnMatch":"OsHintSource","formatter":5},{"columnMatch":"NvmeOsHint","formatter":5},{"columnMatch":"ManaOsHint","formatter":5},{"columnMatch":"NvmeDriverValidation","formatter":5},{"columnMatch":"ManaDriverValidation","formatter":5},{"columnMatch":"NvmeOsReference","formatter":5},{"columnMatch":"ManaOsReference","formatter":5},{"columnMatch":"OsReferenceChecked","formatter":5},{"columnMatch":"TargetSelection","formatter":5},{"columnMatch":"ConversionOS","formatter":5},{"columnMatch":"ConversionEncryption","formatter":5},{"columnMatch":"Architecture","formatter":5},{"columnMatch":"MemoryCapacity","formatter":5},{"columnMatch":"LocalDisk","formatter":5},{"columnMatch":"CatalogueRegion","formatter":5},{"columnMatch":"ZonePlacement","formatter":5},{"columnMatch":"AvailabilitySet","formatter":5},{"columnMatch":"ScaleSetModel","formatter":5},{"columnMatch":"DiskLimits","formatter":5},{"columnMatch":"NicLimits","formatter":5},{"columnMatch":"Quota","formatter":5},{"columnMatch":"Policy","formatter":5},{"columnMatch":"AllocationCapacity","formatter":5},{"columnMatch":"Backup","formatter":5},{"columnMatch":"AsrConversion","formatter":5},{"columnMatch":"ApplicationValidation","formatter":5},{"columnMatch":"Rollback","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"path-v5-grid","customWidth":"100"},{"type":1,"content":{"json":"**Status legend:** Met = observed/captured evidence meets this specific check; Not met = observed mismatch; Unknown = validation evidence missing; Not applicable = this target/route does not trigger the check. Use **All 22 checks** for vertically listed statuses/evidence, or export for every prerequisite column. See the column key below. Catalogue matches are not guest certification or a live capacity guarantee. The OS/encryption checks describe the documented Trusted Launch conversion route, not every rebuild.\n\n**Before a v5 resize**\n\n- Confirm the target supports the actual VM generation and existing controller.\n- Validate MANA/accelerated networking on target hardware independently of NVMe.\n- Check OS/image support, ADE restrictions, disk/NIC limits and local-disk capacity/performance.\n- Check subscription quota, restrictions, policy, zone/cluster availability and downtime.\n- Take recoverable backups; test applications and rollback.\n\nGen1, Server 2016 and ADE are not blanket v5 blockers."},"name":"path-v5-checklist","styleSettings":{"margin":"0","padding":"0"}}]}},{"type":12,"name":"path-v6-panel","customWidth":"100","content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### V6 upgrade path\n\nEvaluate a catalogued v6 target independently. Gen2-only and NVMe requirements come from that target's metadata, not the version label alone. Rehearse boot from the actual legacy image/disk before rollout."},"name":"path-v6-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{V6PathSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| where Lifecycle != 'OPTIONAL'\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{V6PathRegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{V6PathRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| extend OsHintSource = iff(isnotempty(GuestOsName), 'Guest OS metadata', 'Image hint only - current guest unverified'),\n         OsHintText = tolower(iff(isnotempty(GuestOsName), GuestOsName, strcat(ImagePublisher, ' ', ImageOffer, ' ', ImageSku)))\n| extend NvmeOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2019|2022|2025)($|[^0-9])', 'Listed OS family - validate image, generation and boot',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(18[._-]04|20[._-]04|22[._-]04|24[._-]04)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        OsHintText matches regex @'debian[^0-9]{0,30}(11|12)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        'Review official NVMe OS list - not classified by captured subset'),\n         ManaOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2016|2019|2022|2025)($|[^0-9])', 'Listed OS family - install/verify current MANA driver',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(22[._-]04|24[._-]04|26[._-]04)($|[^0-9])', 'Listed OS family - verify minimum kernel and MANA driver',\n        'Review official MANA OS/kernel list - not classified by captured subset')\n| extend NvmeDriverValidation = 'Unknown - guest driver and target boot not tested',\n         ManaDriverValidation = 'Unknown - target hardware, driver and traffic not tested',\n         NvmeOsReference = 'https://learn.microsoft.com/azure/virtual-machines/enable-nvme-interface',\n         ManaOsReference = 'https://learn.microsoft.com/azure/virtual-network/accelerated-networking-overview',\n         OsReferenceChecked = '2026-11-18'\n| extend ImageProvenance = case(\n        isnotempty(ImageId), 'Custom/gallery image - verify guest drivers',\n        isnotempty(ImagePublisher), 'Marketplace origin - guest changes unverified',\n        'Unknown image lineage - verify guest drivers')\n| extend OsEvidence = case(\n        isnotempty(GuestOsName), strcat('Guest OS metadata: ', GuestOsName),\n        OsType =~ 'Windows' and ImageSku contains '2016', 'Server 2016 image hint - current guest OS unverified',\n        'Guest OS version unverified')\n| extend EncryptionEvidence = iff(DiskAdeConfigured == true,\n        'OS disk encryption configuration detected - guest state unverified',\n        'Guest BitLocker/ADE state unverified')\n| extend ConversionOsCheck = case(\n        OsType !~ 'Windows' or NeedsGen2 == 0, '',\n        GuestOsName contains '2016', '; Server 2016 detected: OS upgrade/rebuild before documented Trusted Launch conversion',\n        isempty(GuestOsName) and ImageSku contains '2016', '; Server 2016 image hint: confirm guest version; upgrade/rebuild if still 2016 before documented Trusted Launch conversion',\n        '; Verify Windows OS eligibility for the chosen conversion route')\n| extend ConversionEncryptionCheck = case(\n        OsType !~ 'Windows' or NeedsGen2 == 0, '',\n        DiskAdeConfigured == true, '; Encryption config detected: address Windows OS encryption before documented Trusted Launch conversion',\n        '; Guest encryption unknown: check BitLocker/ADE before conversion')\n| extend Prerequisites = iff(isempty(RecommendedTarget),\n        'No compatible target in this generation in the captured catalogue - manual selection required',\n        strcat('Generation ', VmGeneration, ': ', Blockers,\n            ConversionOsCheck, ConversionEncryptionCheck,\n            iff(NeedsGen2 == 1, '; Convert/rebuild to Gen2; validate partition layout and chosen route; Backup/ASR prerequisites apply to Trusted Launch conversion', ''),\n            iff(PenNvme > 0 and isnotempty(DiskControllers) and DiskControllers !contains 'NVMe',\n                '; Current OS disk does not advertise NVMe - validate image/disk/boot-driver compatibility', '')))\n| extend Validation = strcat('Catalogue region: ', TargetInRegion, '. ', OsEvidence, '. ',\n        EncryptionEvidence, '. ', ImageProvenance,\n        '. ', NvmeOsHint, '. ', ManaOsHint,\n        '. Unverified: MANA/traffic, target policy/capacity, storage IOPS/NIC limits, application/rollback. ',\n        'Use Plan > Capacity & quota with the matching target scenario; the default V5-first result is not a V6/V7-path quota approval.',\n        iff(WarnCodes has 'l', ' Target local-disk capacity unknown: confirm before choosing this target.', ''))\n| extend Resource = strcat(Name, ' [', VmSize, ']'),\n         Target = iff(isempty(RecommendedTarget), 'Manual selection required', RecommendedTarget),\n         ConversionRequired = iff(isempty(RecommendedTarget) or VmGeneration == 'Unknown', tobool(''), NeedsGen2 == 1),\n         NvmeRequired = iff(isempty(RecommendedTarget), tobool(''), PenNvme > 0)\n| extend TargetSelection = iff(isempty(RecommendedTarget), 'Not met', 'Met'),\n         GenerationSupport = case(isempty(RecommendedTarget) or VmGeneration == 'Unknown', 'Unknown',\n             NeedsGen2 == 1, 'Not met', 'Met'),\n         ConversionOS = case(isempty(RecommendedTarget), 'Unknown',\n             isempty(OsType) and WarnCodes has 'g' and VmGeneration != 'V2', 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2' or OsType !~ 'Windows', 'Not applicable',\n             VmGeneration == 'Unknown', 'Unknown',\n             GuestOsName contains '2016', 'Not met', 'Unknown'),\n         ConversionEncryption = case(isempty(RecommendedTarget), 'Unknown',\n             isempty(OsType) and WarnCodes has 'g' and VmGeneration != 'V2', 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2' or OsType !~ 'Windows', 'Not applicable',\n             VmGeneration == 'Unknown', 'Unknown',\n             DiskAdeConfigured == true, 'Not met', 'Unknown'),\n         NvmeBoot = case(isempty(RecommendedTarget), 'Unknown',\n             PenNvme == 0, 'Not applicable',\n             isnotempty(DiskControllers) and DiskControllers !contains 'NVMe', 'Not met', 'Unknown'),\n         ManaNetworking = 'Unknown',\n         Architecture = case(isempty(RecommendedTarget), 'Unknown', PenArch > 0, 'Not met', 'Met'),\n         MemoryCapacity = case(isempty(RecommendedTarget) or isnull(toreal(TargetMemoryGB)) or isnull(CurrentMemoryGB), 'Unknown',\n             PenMem > 0, 'Not met', 'Met'),\n         LocalDisk = case(isempty(RecommendedTarget) or WarnCodes has 'l', 'Unknown',\n             PenTemp > 0, 'Not met', 'Unknown'),\n         CatalogueRegion = case(TargetInRegion == 'Yes', 'Met', TargetInRegion == 'No', 'Not met', 'Unknown'),\n         ZonePlacement = iff(isempty(Zone), 'Not applicable', 'Unknown'),\n         AvailabilitySet = iff(isempty(AvSetId), 'Not applicable', 'Unknown'),\n         ScaleSetModel = iff(IsVmss, 'Unknown', 'Not applicable'),\n         DiskLimits = 'Unknown', NicLimits = 'Unknown',\n         Quota = 'Unknown', Policy = 'Unknown', AllocationCapacity = 'Unknown',\n         Backup = 'Unknown',\n         AsrConversion = case(isempty(RecommendedTarget), 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2', 'Not applicable', 'Unknown'),\n         ApplicationValidation = 'Unknown', Rollback = 'Unknown'\n\n| extend ChecksNotMet = iff(TargetSelection == 'Not met', 1, 0) + iff(GenerationSupport == 'Not met', 1, 0) + iff(ConversionOS == 'Not met', 1, 0) + iff(ConversionEncryption == 'Not met', 1, 0) + iff(NvmeBoot == 'Not met', 1, 0) + iff(ManaNetworking == 'Not met', 1, 0) + iff(Architecture == 'Not met', 1, 0) + iff(MemoryCapacity == 'Not met', 1, 0) + iff(LocalDisk == 'Not met', 1, 0) + iff(CatalogueRegion == 'Not met', 1, 0) + iff(ZonePlacement == 'Not met', 1, 0) + iff(AvailabilitySet == 'Not met', 1, 0) + iff(ScaleSetModel == 'Not met', 1, 0) + iff(DiskLimits == 'Not met', 1, 0) + iff(NicLimits == 'Not met', 1, 0) + iff(Quota == 'Not met', 1, 0) + iff(Policy == 'Not met', 1, 0) + iff(AllocationCapacity == 'Not met', 1, 0) + iff(Backup == 'Not met', 1, 0) + iff(AsrConversion == 'Not met', 1, 0) + iff(ApplicationValidation == 'Not met', 1, 0) + iff(Rollback == 'Not met', 1, 0),\n         ChecksUnknown = iff(TargetSelection == 'Unknown', 1, 0) + iff(GenerationSupport == 'Unknown', 1, 0) + iff(ConversionOS == 'Unknown', 1, 0) + iff(ConversionEncryption == 'Unknown', 1, 0) + iff(NvmeBoot == 'Unknown', 1, 0) + iff(ManaNetworking == 'Unknown', 1, 0) + iff(Architecture == 'Unknown', 1, 0) + iff(MemoryCapacity == 'Unknown', 1, 0) + iff(LocalDisk == 'Unknown', 1, 0) + iff(CatalogueRegion == 'Unknown', 1, 0) + iff(ZonePlacement == 'Unknown', 1, 0) + iff(AvailabilitySet == 'Unknown', 1, 0) + iff(ScaleSetModel == 'Unknown', 1, 0) + iff(DiskLimits == 'Unknown', 1, 0) + iff(NicLimits == 'Unknown', 1, 0) + iff(Quota == 'Unknown', 1, 0) + iff(Policy == 'Unknown', 1, 0) + iff(AllocationCapacity == 'Unknown', 1, 0) + iff(Backup == 'Unknown', 1, 0) + iff(AsrConversion == 'Unknown', 1, 0) + iff(ApplicationValidation == 'Unknown', 1, 0) + iff(Rollback == 'Unknown', 1, 0)\n| extend Review = 'All 22 checks'\n| project Resource, Target, GenerationSupport, NvmeBoot, ManaNetworking,\n          ChecksNotMet, ChecksUnknown, Review, TargetSelection, ConversionOS,\n          ConversionEncryption, Architecture, MemoryCapacity,\n          LocalDisk, CatalogueRegion, ZonePlacement, AvailabilitySet, ScaleSetModel,\n          DiskLimits, NicLimits, Quota, Policy, AllocationCapacity, Backup, AsrConversion,\n          ApplicationValidation, Rollback,\n          Prerequisites, Validation, ResourceId,\n          VmGeneration, ConversionRequired, NvmeRequired, ImageProvenance, OsEvidence, EncryptionEvidence,\n          OsHintSource, NvmeOsHint, ManaOsHint, NvmeDriverValidation, ManaDriverValidation,\n          NvmeOsReference, ManaOsReference, OsReferenceChecked\n| order by Resource asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"V6 targets - select All 22 checks for per-VM details","gridSettings":{"formatters":[{"columnMatch":"Resource","formatter":1,"formatOptions":{"linkColumn":"ResourceId","linkTarget":"Resource","linkIsContextBlade":true,"customColumnWidthSetting":"20fr"}},{"columnMatch":"Target","formatter":0,"formatOptions":{"customColumnWidthSetting":"19fr"}},{"columnMatch":"GenerationSupport","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"NvmeBoot","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"ManaNetworking","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"ChecksNotMet","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":0,"representation":"red","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"9fr"}},{"columnMatch":"ChecksUnknown","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":0,"representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"9fr"}},{"columnMatch":"Review","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"15fr"}},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"Prerequisites","formatter":5},{"columnMatch":"Validation","formatter":5},{"columnMatch":"VmGeneration","formatter":5},{"columnMatch":"ConversionRequired","formatter":5},{"columnMatch":"NvmeRequired","formatter":5},{"columnMatch":"ImageProvenance","formatter":5},{"columnMatch":"OsEvidence","formatter":5},{"columnMatch":"EncryptionEvidence","formatter":5},{"columnMatch":"OsHintSource","formatter":5},{"columnMatch":"NvmeOsHint","formatter":5},{"columnMatch":"ManaOsHint","formatter":5},{"columnMatch":"NvmeDriverValidation","formatter":5},{"columnMatch":"ManaDriverValidation","formatter":5},{"columnMatch":"NvmeOsReference","formatter":5},{"columnMatch":"ManaOsReference","formatter":5},{"columnMatch":"OsReferenceChecked","formatter":5},{"columnMatch":"TargetSelection","formatter":5},{"columnMatch":"ConversionOS","formatter":5},{"columnMatch":"ConversionEncryption","formatter":5},{"columnMatch":"Architecture","formatter":5},{"columnMatch":"MemoryCapacity","formatter":5},{"columnMatch":"LocalDisk","formatter":5},{"columnMatch":"CatalogueRegion","formatter":5},{"columnMatch":"ZonePlacement","formatter":5},{"columnMatch":"AvailabilitySet","formatter":5},{"columnMatch":"ScaleSetModel","formatter":5},{"columnMatch":"DiskLimits","formatter":5},{"columnMatch":"NicLimits","formatter":5},{"columnMatch":"Quota","formatter":5},{"columnMatch":"Policy","formatter":5},{"columnMatch":"AllocationCapacity","formatter":5},{"columnMatch":"Backup","formatter":5},{"columnMatch":"AsrConversion","formatter":5},{"columnMatch":"ApplicationValidation","formatter":5},{"columnMatch":"Rollback","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"path-v6-grid","customWidth":"100"},{"type":1,"content":{"json":"**Status legend:** Met = observed/captured evidence meets this specific check; Not met = observed mismatch; Unknown = validation evidence missing; Not applicable = this target/route does not trigger the check. Use **All 22 checks** for vertically listed statuses/evidence, or export for every prerequisite column. See the column key below. Catalogue matches are not guest certification or a live capacity guarantee. The OS/encryption checks describe the documented Trusted Launch conversion route, not every rebuild.\n\n**Before a v6 migration**\n\n- For a Gen2-only target, convert or rebuild Gen1 guests; confirm supported OS and partition/EFI layout.\n- For [Gen1-to-Trusted-Launch conversion](https://learn.microsoft.com/azure/virtual-machines/trusted-launch-existing-vm-gen-1), check Server 2016 exclusion, Windows OS encryption, Backup policy and ASR prerequisites. Rebuilding is a separate route.\n- If required, validate NVMe image/disk capability, boot-critical driver and an actual converted-disk boot.\n- Validate MANA hardware, driver and traffic separately; custom image origin is not proof of a missing driver.\n- Confirm local-disk capacity/performance, disk/NIC limits, quota/policy/zone/cluster availability, applications and rollback."},"name":"path-v6-checklist","styleSettings":{"margin":"0","padding":"0"}}]}},{"type":12,"name":"path-v7-panel","customWidth":"100","content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### V7 upgrade path\n\nEvaluate a catalogued v7 target independently. Gen2-only and NVMe requirements come from that target's metadata, not the version label alone. Rehearse boot from the actual legacy image/disk before rollout."},"name":"path-v7-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{V7PathSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| where Lifecycle != 'OPTIONAL'\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{V7PathRegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{V7PathRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| extend OsHintSource = iff(isnotempty(GuestOsName), 'Guest OS metadata', 'Image hint only - current guest unverified'),\n         OsHintText = tolower(iff(isnotempty(GuestOsName), GuestOsName, strcat(ImagePublisher, ' ', ImageOffer, ' ', ImageSku)))\n| extend NvmeOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2019|2022|2025)($|[^0-9])', 'Listed OS family - validate image, generation and boot',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(18[._-]04|20[._-]04|22[._-]04|24[._-]04)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        OsHintText matches regex @'debian[^0-9]{0,30}(11|12)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        'Review official NVMe OS list - not classified by captured subset'),\n         ManaOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2016|2019|2022|2025)($|[^0-9])', 'Listed OS family - install/verify current MANA driver',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(22[._-]04|24[._-]04|26[._-]04)($|[^0-9])', 'Listed OS family - verify minimum kernel and MANA driver',\n        'Review official MANA OS/kernel list - not classified by captured subset')\n| extend NvmeDriverValidation = 'Unknown - guest driver and target boot not tested',\n         ManaDriverValidation = 'Unknown - target hardware, driver and traffic not tested',\n         NvmeOsReference = 'https://learn.microsoft.com/azure/virtual-machines/enable-nvme-interface',\n         ManaOsReference = 'https://learn.microsoft.com/azure/virtual-network/accelerated-networking-overview',\n         OsReferenceChecked = '2026-11-18'\n| extend ImageProvenance = case(\n        isnotempty(ImageId), 'Custom/gallery image - verify guest drivers',\n        isnotempty(ImagePublisher), 'Marketplace origin - guest changes unverified',\n        'Unknown image lineage - verify guest drivers')\n| extend OsEvidence = case(\n        isnotempty(GuestOsName), strcat('Guest OS metadata: ', GuestOsName),\n        OsType =~ 'Windows' and ImageSku contains '2016', 'Server 2016 image hint - current guest OS unverified',\n        'Guest OS version unverified')\n| extend EncryptionEvidence = iff(DiskAdeConfigured == true,\n        'OS disk encryption configuration detected - guest state unverified',\n        'Guest BitLocker/ADE state unverified')\n| extend ConversionOsCheck = case(\n        OsType !~ 'Windows' or NeedsGen2 == 0, '',\n        GuestOsName contains '2016', '; Server 2016 detected: OS upgrade/rebuild before documented Trusted Launch conversion',\n        isempty(GuestOsName) and ImageSku contains '2016', '; Server 2016 image hint: confirm guest version; upgrade/rebuild if still 2016 before documented Trusted Launch conversion',\n        '; Verify Windows OS eligibility for the chosen conversion route')\n| extend ConversionEncryptionCheck = case(\n        OsType !~ 'Windows' or NeedsGen2 == 0, '',\n        DiskAdeConfigured == true, '; Encryption config detected: address Windows OS encryption before documented Trusted Launch conversion',\n        '; Guest encryption unknown: check BitLocker/ADE before conversion')\n| extend Prerequisites = iff(isempty(RecommendedTarget),\n        'No compatible target in this generation in the captured catalogue - manual selection required',\n        strcat('Generation ', VmGeneration, ': ', Blockers,\n            ConversionOsCheck, ConversionEncryptionCheck,\n            iff(NeedsGen2 == 1, '; Convert/rebuild to Gen2; validate partition layout and chosen route; Backup/ASR prerequisites apply to Trusted Launch conversion', ''),\n            iff(PenNvme > 0 and isnotempty(DiskControllers) and DiskControllers !contains 'NVMe',\n                '; Current OS disk does not advertise NVMe - validate image/disk/boot-driver compatibility', '')))\n| extend Validation = strcat('Catalogue region: ', TargetInRegion, '. ', OsEvidence, '. ',\n        EncryptionEvidence, '. ', ImageProvenance,\n        '. ', NvmeOsHint, '. ', ManaOsHint,\n        '. Unverified: MANA/traffic, target policy/capacity, storage IOPS/NIC limits, application/rollback. ',\n        'Use Plan > Capacity & quota with the matching target scenario; the default V5-first result is not a V6/V7-path quota approval.',\n        iff(WarnCodes has 'l', ' Target local-disk capacity unknown: confirm before choosing this target.', ''))\n| extend Resource = strcat(Name, ' [', VmSize, ']'),\n         Target = iff(isempty(RecommendedTarget), 'Manual selection required', RecommendedTarget),\n         ConversionRequired = iff(isempty(RecommendedTarget) or VmGeneration == 'Unknown', tobool(''), NeedsGen2 == 1),\n         NvmeRequired = iff(isempty(RecommendedTarget), tobool(''), PenNvme > 0)\n| extend TargetSelection = iff(isempty(RecommendedTarget), 'Not met', 'Met'),\n         GenerationSupport = case(isempty(RecommendedTarget) or VmGeneration == 'Unknown', 'Unknown',\n             NeedsGen2 == 1, 'Not met', 'Met'),\n         ConversionOS = case(isempty(RecommendedTarget), 'Unknown',\n             isempty(OsType) and WarnCodes has 'g' and VmGeneration != 'V2', 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2' or OsType !~ 'Windows', 'Not applicable',\n             VmGeneration == 'Unknown', 'Unknown',\n             GuestOsName contains '2016', 'Not met', 'Unknown'),\n         ConversionEncryption = case(isempty(RecommendedTarget), 'Unknown',\n             isempty(OsType) and WarnCodes has 'g' and VmGeneration != 'V2', 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2' or OsType !~ 'Windows', 'Not applicable',\n             VmGeneration == 'Unknown', 'Unknown',\n             DiskAdeConfigured == true, 'Not met', 'Unknown'),\n         NvmeBoot = case(isempty(RecommendedTarget), 'Unknown',\n             PenNvme == 0, 'Not applicable',\n             isnotempty(DiskControllers) and DiskControllers !contains 'NVMe', 'Not met', 'Unknown'),\n         ManaNetworking = 'Unknown',\n         Architecture = case(isempty(RecommendedTarget), 'Unknown', PenArch > 0, 'Not met', 'Met'),\n         MemoryCapacity = case(isempty(RecommendedTarget) or isnull(toreal(TargetMemoryGB)) or isnull(CurrentMemoryGB), 'Unknown',\n             PenMem > 0, 'Not met', 'Met'),\n         LocalDisk = case(isempty(RecommendedTarget) or WarnCodes has 'l', 'Unknown',\n             PenTemp > 0, 'Not met', 'Unknown'),\n         CatalogueRegion = case(TargetInRegion == 'Yes', 'Met', TargetInRegion == 'No', 'Not met', 'Unknown'),\n         ZonePlacement = iff(isempty(Zone), 'Not applicable', 'Unknown'),\n         AvailabilitySet = iff(isempty(AvSetId), 'Not applicable', 'Unknown'),\n         ScaleSetModel = iff(IsVmss, 'Unknown', 'Not applicable'),\n         DiskLimits = 'Unknown', NicLimits = 'Unknown',\n         Quota = 'Unknown', Policy = 'Unknown', AllocationCapacity = 'Unknown',\n         Backup = 'Unknown',\n         AsrConversion = case(isempty(RecommendedTarget), 'Unknown',\n             not(WarnCodes has 'g') or VmGeneration == 'V2', 'Not applicable', 'Unknown'),\n         ApplicationValidation = 'Unknown', Rollback = 'Unknown'\n\n| extend ChecksNotMet = iff(TargetSelection == 'Not met', 1, 0) + iff(GenerationSupport == 'Not met', 1, 0) + iff(ConversionOS == 'Not met', 1, 0) + iff(ConversionEncryption == 'Not met', 1, 0) + iff(NvmeBoot == 'Not met', 1, 0) + iff(ManaNetworking == 'Not met', 1, 0) + iff(Architecture == 'Not met', 1, 0) + iff(MemoryCapacity == 'Not met', 1, 0) + iff(LocalDisk == 'Not met', 1, 0) + iff(CatalogueRegion == 'Not met', 1, 0) + iff(ZonePlacement == 'Not met', 1, 0) + iff(AvailabilitySet == 'Not met', 1, 0) + iff(ScaleSetModel == 'Not met', 1, 0) + iff(DiskLimits == 'Not met', 1, 0) + iff(NicLimits == 'Not met', 1, 0) + iff(Quota == 'Not met', 1, 0) + iff(Policy == 'Not met', 1, 0) + iff(AllocationCapacity == 'Not met', 1, 0) + iff(Backup == 'Not met', 1, 0) + iff(AsrConversion == 'Not met', 1, 0) + iff(ApplicationValidation == 'Not met', 1, 0) + iff(Rollback == 'Not met', 1, 0),\n         ChecksUnknown = iff(TargetSelection == 'Unknown', 1, 0) + iff(GenerationSupport == 'Unknown', 1, 0) + iff(ConversionOS == 'Unknown', 1, 0) + iff(ConversionEncryption == 'Unknown', 1, 0) + iff(NvmeBoot == 'Unknown', 1, 0) + iff(ManaNetworking == 'Unknown', 1, 0) + iff(Architecture == 'Unknown', 1, 0) + iff(MemoryCapacity == 'Unknown', 1, 0) + iff(LocalDisk == 'Unknown', 1, 0) + iff(CatalogueRegion == 'Unknown', 1, 0) + iff(ZonePlacement == 'Unknown', 1, 0) + iff(AvailabilitySet == 'Unknown', 1, 0) + iff(ScaleSetModel == 'Unknown', 1, 0) + iff(DiskLimits == 'Unknown', 1, 0) + iff(NicLimits == 'Unknown', 1, 0) + iff(Quota == 'Unknown', 1, 0) + iff(Policy == 'Unknown', 1, 0) + iff(AllocationCapacity == 'Unknown', 1, 0) + iff(Backup == 'Unknown', 1, 0) + iff(AsrConversion == 'Unknown', 1, 0) + iff(ApplicationValidation == 'Unknown', 1, 0) + iff(Rollback == 'Unknown', 1, 0)\n| extend Review = 'All 22 checks'\n| project Resource, Target, GenerationSupport, NvmeBoot, ManaNetworking,\n          ChecksNotMet, ChecksUnknown, Review, TargetSelection, ConversionOS,\n          ConversionEncryption, Architecture, MemoryCapacity,\n          LocalDisk, CatalogueRegion, ZonePlacement, AvailabilitySet, ScaleSetModel,\n          DiskLimits, NicLimits, Quota, Policy, AllocationCapacity, Backup, AsrConversion,\n          ApplicationValidation, Rollback,\n          Prerequisites, Validation, ResourceId,\n          VmGeneration, ConversionRequired, NvmeRequired, ImageProvenance, OsEvidence, EncryptionEvidence,\n          OsHintSource, NvmeOsHint, ManaOsHint, NvmeDriverValidation, ManaDriverValidation,\n          NvmeOsReference, ManaOsReference, OsReferenceChecked\n| order by Resource asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"V7 targets - select All 22 checks for per-VM details","gridSettings":{"formatters":[{"columnMatch":"Resource","formatter":1,"formatOptions":{"linkColumn":"ResourceId","linkTarget":"Resource","linkIsContextBlade":true,"customColumnWidthSetting":"20fr"}},{"columnMatch":"Target","formatter":0,"formatOptions":{"customColumnWidthSetting":"19fr"}},{"columnMatch":"GenerationSupport","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"NvmeBoot","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"ManaNetworking","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"ChecksNotMet","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":0,"representation":"red","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"9fr"}},{"columnMatch":"ChecksUnknown","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":0,"representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"9fr"}},{"columnMatch":"Review","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"15fr"}},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"Prerequisites","formatter":5},{"columnMatch":"Validation","formatter":5},{"columnMatch":"VmGeneration","formatter":5},{"columnMatch":"ConversionRequired","formatter":5},{"columnMatch":"NvmeRequired","formatter":5},{"columnMatch":"ImageProvenance","formatter":5},{"columnMatch":"OsEvidence","formatter":5},{"columnMatch":"EncryptionEvidence","formatter":5},{"columnMatch":"OsHintSource","formatter":5},{"columnMatch":"NvmeOsHint","formatter":5},{"columnMatch":"ManaOsHint","formatter":5},{"columnMatch":"NvmeDriverValidation","formatter":5},{"columnMatch":"ManaDriverValidation","formatter":5},{"columnMatch":"NvmeOsReference","formatter":5},{"columnMatch":"ManaOsReference","formatter":5},{"columnMatch":"OsReferenceChecked","formatter":5},{"columnMatch":"TargetSelection","formatter":5},{"columnMatch":"ConversionOS","formatter":5},{"columnMatch":"ConversionEncryption","formatter":5},{"columnMatch":"Architecture","formatter":5},{"columnMatch":"MemoryCapacity","formatter":5},{"columnMatch":"LocalDisk","formatter":5},{"columnMatch":"CatalogueRegion","formatter":5},{"columnMatch":"ZonePlacement","formatter":5},{"columnMatch":"AvailabilitySet","formatter":5},{"columnMatch":"ScaleSetModel","formatter":5},{"columnMatch":"DiskLimits","formatter":5},{"columnMatch":"NicLimits","formatter":5},{"columnMatch":"Quota","formatter":5},{"columnMatch":"Policy","formatter":5},{"columnMatch":"AllocationCapacity","formatter":5},{"columnMatch":"Backup","formatter":5},{"columnMatch":"AsrConversion","formatter":5},{"columnMatch":"ApplicationValidation","formatter":5},{"columnMatch":"Rollback","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"path-v7-grid","customWidth":"100"},{"type":1,"content":{"json":"**Status legend:** Met = observed/captured evidence meets this specific check; Not met = observed mismatch; Unknown = validation evidence missing; Not applicable = this target/route does not trigger the check. Use **All 22 checks** for vertically listed statuses/evidence, or export for every prerequisite column. See the column key below. Catalogue matches are not guest certification or a live capacity guarantee. The OS/encryption checks describe the documented Trusted Launch conversion route, not every rebuild.\n\n**Before a v7 migration**\n\n- For a Gen2-only target, convert or rebuild Gen1 guests; confirm supported OS and partition/EFI layout.\n- For [Gen1-to-Trusted-Launch conversion](https://learn.microsoft.com/azure/virtual-machines/trusted-launch-existing-vm-gen-1), check Server 2016 exclusion, Windows OS encryption, Backup policy and ASR prerequisites. Rebuilding is a separate route.\n- If required, validate NVMe image/disk capability, boot-critical driver and an actual converted-disk boot.\n- Validate MANA hardware, driver and traffic separately; custom image origin is not proof of a missing driver.\n- Confirm local-disk capacity/performance, disk/NIC limits, quota/policy/zone/cluster availability, applications and rollback."},"name":"path-v7-checklist","styleSettings":{"margin":"0","padding":"0"}}]}},{"type":1,"content":{"json":"### Assessment column and status key\n\nThe compact grids show the resource, target, generation, NVMe and MANA checks, plus **ChecksNotMet** (observed mismatches across all 22 checks) and **ChecksUnknown** (missing evidence across all 22). Click **All 22 checks** for that VM's vertically listed statuses and evidence. Export retains every prerequisite as its own column. Zero mismatches is not approval when evidence remains Unknown.\n\n| Status | Meaning and example |\n| --- | --- |\n| Met | Evidence meets this specific check; e.g. the target supports the observed disk generation. Not migration approval. |\n| Not met | An observed mismatch or unmet prerequisite; e.g. Gen1 against a Gen2-only target. Convert, rebuild or choose another target. |\n| Unknown | Evidence or testing is missing; e.g. a driver/traffic test, quota or application acceptance. Neither a pass nor proof of failure. |\n| Not applicable | This chosen target/route does not trigger the check; e.g. Windows conversion encryption on a route with no conversion. |\n\n| Prerequisite field | What it checks |\n| --- | --- |\n| TargetSelection | A capability-preserving candidate exists in the captured catalogue; not live availability. |\n| GenerationSupport | The actual OS disk generation is supported by this target; Not met means conversion/rebuild is needed. |\n| ConversionOS | Windows OS eligibility for the selected Gen1-to-Trusted-Launch route; observed Server 2016 is Not met. |\n| ConversionEncryption | Windows OS encryption prerequisite for that conversion route; detected ADE configuration is Not met. |\n| NvmeBoot | NVMe image/disk/boot-driver readiness if this target requires it; a real target boot is still required. |\n| ManaNetworking | Target MANA hardware, guest driver and traffic validation; image origin alone cannot pass this. |\n| Architecture | Source and target CPU architecture match. |\n| MemoryCapacity | The selected target preserves source memory capacity. |\n| LocalDisk | Local-disk capacity, persistence assumptions and performance; known removal is Not met, otherwise review. |\n| CatalogueRegion | The target is present in the captured regional snapshot; use Plan > Live target availability for current offerability. |\n| ZonePlacement | Current zone compatibility and placement; zonal sources require live validation. |\n| AvailabilitySet | Availability-set placement and resize-cluster constraints, when membership exists. |\n| ScaleSetModel | Scale-set orchestration, upgrade policy and model-level migration, when applicable. |\n| DiskLimits | Attached disk count, IOPS, throughput and target storage limits. |\n| NicLimits | NIC count and target networking limits. |\n| Quota | Regional/family quota for this path; the separate quota report models the default V5-first fleet, not V6 approval. |\n| Policy | Subscription policy and deployment governance approval. |\n| AllocationCapacity | Actual allocation and resize-cluster capacity; the SKU API does not guarantee this. |\n| Backup | Recoverable backup/restore and conversion-route backup policy prerequisites. |\n| AsrConversion | ASR prerequisites when the selected route requires generation conversion. |\n| ApplicationValidation | Owner-approved application, performance, dependency and HA/failover tests. |\n| Rollback | A documented and rehearsed recovery/rollback route. |\n\n**Evidence fields:** Prerequisites explains target-specific actions; Validation lists evidence and remaining work. VmGeneration comes from disk metadata or a labelled image hint; ConversionRequired/NvmeRequired describe the chosen target. OsEvidence, EncryptionEvidence and ImageProvenance are observations/hints, not guest certification. OsHintSource, NvmeOsHint, ManaOsHint and their reference/date fields identify the captured OS guidance. NvmeDriverValidation/ManaDriverValidation remain unverified until tested. ResourceId links back to the Azure resource."},"name":"assessment-column-key","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AssessView","comparison":"isEqualTo","value":"paths"},"name":"grp-paths"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Choose the supported operation, not just a target SKU\n\nReview **Details** for observed ADE, suspected appliance, placement and ownership signals. Missing evidence is Unknown, not cleared. Guest OS/encryption and vendor certification require customer confirmation. The global lifecycle display filter does not hide ownership/dependency evidence here."},"name":"routes-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets',\n    'microsoft.network/networkinterfaces', 'microsoft.compute/disks',\n    'microsoft.compute/virtualmachines/extensions', 'microsoft.sqlvirtualmachine/sqlvirtualmachines')\n| extend IsVmss = type =~ 'microsoft.compute/virtualmachinescalesets',\n         IsCompute = type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets'),\n         IsNic = type =~ 'microsoft.network/networkinterfaces', IsDisk = type =~ 'microsoft.compute/disks',\n         IsRegistration = type =~ 'microsoft.sqlvirtualmachine/sqlvirtualmachines',\n         IsExtension = type =~ 'microsoft.compute/virtualmachines/extensions'\n| extend IsSqlExtension = IsExtension and tostring(properties.publisher) =~ 'Microsoft.SqlServer.Management'\n            and (tostring(properties.type) =~ 'SqlIaaSAgent' or tostring(properties.typePropertiesType) =~ 'SqlIaaSAgent'),\n         IsAdeExtension = IsExtension and tostring(properties.publisher) in~ ('Microsoft.Azure.Security', 'Microsoft.Azure.Security.Edp')\n            and tostring(properties.type) in~ ('AzureDiskEncryption', 'AzureDiskEncryptionForLinux'),\n         IsSapExtension = IsExtension and tostring(properties.publisher) in~ ('Microsoft.AzureCAT.AzureEnhancedMonitoring', 'Microsoft.OSTCExtensions')\n            and tostring(properties.type) in~ ('MonitorX64Windows', 'MonitorX64Linux', 'AzureEnhancedMonitorForLinux', 'AzureCATExtensionHandler')\n| extend ComputeProfile = iff(IsVmss, properties.virtualMachineProfile, properties)\n| extend Keys = case(IsCompute, array_concat(pack_array(id),\n            coalesce(ComputeProfile.storageProfile.dataDisks, dynamic([])),\n            pack_array(tostring(ComputeProfile.storageProfile.osDisk.managedDisk.id))),\n        IsNic, pack_array(tostring(properties.virtualMachine.id)),\n        IsRegistration, pack_array(tostring(properties.virtualMachineResourceId)),\n        IsExtension, pack_array(tostring(split(tolower(id), '/extensions/')[0])),\n        IsDisk, pack_array(id), dynamic([]))\n| mv-expand Key = Keys limit 2000\n| extend VmId = tolower(iff(isnotempty(tostring(Key.managedDisk.id)), tostring(Key.managedDisk.id), tostring(Key)))\n| where isnotempty(VmId)\n| extend IsSelf = IsCompute and tolower(id) == VmId\n| summarize ComputeRows = countif(IsSelf),\n        VM = take_anyif(pack('id', id, 'type', type, 'name', name, 'resourceGroup', resourceGroup, 'subscriptionId', subscriptionId,\n            'location', location, 'properties', properties, 'sku', sku, 'tags', tags,\n            'identity', identity, 'plan', plan, 'managedBy', managedBy, 'zones', zones), IsSelf),\n        AttachedVmIds = make_set_if(tolower(id), IsCompute and not(IsSelf), 2000),\n        NicRows = countif(IsNic), AcceleratedNicRows = countif(IsNic and tobool(properties.enableAcceleratedNetworking) == true),\n        NicFlagRows = countif(IsNic and isnotnull(tobool(properties.enableAcceleratedNetworking))),\n        DiskRows = countif(IsDisk), SharedDiskRows = countif(IsDisk and toint(properties.maxShares) > 1),\n        AdeDiskRows = countif(IsDisk and tobool(properties.encryptionSettingsCollection.enabled) == true),\n        DiskIops = sumif(tolong(properties.diskIOPSReadWrite), IsDisk),\n        DiskMBps = sumif(toreal(properties.diskMBpsReadWrite), IsDisk),\n        DiskIopsKnown = countif(IsDisk and isnotnull(tolong(properties.diskIOPSReadWrite))),\n        DiskMBpsKnown = countif(IsDisk and isnotnull(toreal(properties.diskMBpsReadWrite))),\n        AdeExtensionRows = countif(IsAdeExtension), SapExtensionRows = countif(IsSapExtension),\n        SqlExtensionRows = countif(IsSqlExtension), SqlRegistrationRows = countif(IsRegistration),\n        SqlGroupIds = make_set_if(tostring(properties.sqlVirtualMachineGroupResourceId), IsRegistration, 20)\n    by VmId\n| extend ComputeKeys = iff(ComputeRows > 0, pack_array(VmId), AttachedVmIds)\n| mv-expand ComputeKey = ComputeKeys limit 2000\n| summarize VM = take_anyif(VM, ComputeRows > 0), ComputeRows = sum(ComputeRows),\n        NicRows = sum(NicRows), AcceleratedNicRows = sum(AcceleratedNicRows), NicFlagRows = sum(NicFlagRows),\n        DiskRows = sum(DiskRows), SharedDiskRows = sum(SharedDiskRows), AdeExtensionRows = sum(AdeExtensionRows),\n        AdeDiskRows = sum(AdeDiskRows), DiskIops = sum(DiskIops), DiskMBps = sum(DiskMBps),\n        DiskIopsKnown = sum(DiskIopsKnown), DiskMBpsKnown = sum(DiskMBpsKnown),\n        SapExtensionRows = sum(SapExtensionRows), SqlExtensionRows = sum(SqlExtensionRows),\n        SqlRegistrationRows = sum(SqlRegistrationRows), SqlGroupIds = take_anyif(SqlGroupIds, ComputeRows > 0)\n    by VmId = tostring(ComputeKey)\n| where ComputeRows == 1\n| extend ResourceId = tostring(VM.id), Name = tostring(VM.name), ResourceGroup = tostring(VM.resourceGroup),\n         SubscriptionId = tostring(VM.subscriptionId), Region = tostring(VM.location),\n         IsVmss = tostring(VM.type) =~ 'microsoft.compute/virtualmachinescalesets',\n         Profile = iff(tostring(VM.type) =~ 'microsoft.compute/virtualmachinescalesets', VM.properties.virtualMachineProfile, VM.properties)\n| extend VmSize = iff(IsVmss, tostring(VM.sku.name), tostring(Profile.hardwareProfile.vmSize)),\n         RgId = tolower(strcat('/subscriptions/', SubscriptionId, '/resourceGroups/', ResourceGroup)),\n         ExpectedNics = array_length(Profile.networkProfile.networkInterfaces),\n         DataDiskCount = array_length(Profile.storageProfile.dataDisks),\n         ImagePublisher = tostring(Profile.storageProfile.imageReference.publisher),\n         ImageOffer = tostring(Profile.storageProfile.imageReference.offer), ImageSku = tostring(Profile.storageProfile.imageReference.sku),\n         GuestOsName = tostring(VM.properties.extended.instanceView.osName)\n| extend ExpectedDisks = coalesce(DataDiskCount, 0) + iff(isnotempty(tostring(Profile.storageProfile.osDisk.managedDisk.id)), 1, 0)\n| extend DiskVisibilityComplete = not(IsVmss) and isnotnull(DataDiskCount) and DiskRows == ExpectedDisks and ExpectedDisks > 0,\n         NicVisibilityComplete = not(IsVmss) and isnotnull(ExpectedNics) and NicRows == ExpectedNics,\n         PlacementEvidence = strcat('Zones: ', tostring(VM.zones),\n             '; Availability set: ', tostring(VM.properties.availabilitySet.id),\n             '; Dedicated Host: ', tostring(VM.properties.host.id),\n             '; Host group: ', tostring(VM.properties.hostGroup.id),\n             '; PPG: ', tostring(VM.properties.proximityPlacementGroup.id),\n             '; Capacity reservation: ', tostring(Profile.capacityReservation.capacityReservationGroup.id),\n             '; Empty/missing associations do not verify target placement'),\n         ApplianceEvidence = iff(ImagePublisher in~ ('fortinet', 'paloaltonetworks', 'cisco',\n             'checkpoint', 'barracudanetworks', 'f5-networks', 'sophos', 'netapp', 'veeam',\n             'cohesity', 'rubrik') or tostring(VM.plan.publisher) in~ ('fortinet', 'paloaltonetworks',\n             'cisco', 'checkpoint', 'barracudanetworks', 'f5-networks', 'sophos', 'netapp',\n             'veeam', 'cohesity', 'rubrik'), strcat('Suspected vendor appliance - image/plan publishers: ',\n             ImagePublisher, '/', tostring(VM.plan.publisher),\n             '; verify exact product/version and target/NIC/driver/HA certification'),\n             'Unknown - image/plan and application owner review required; Marketplace alone is not an appliance signal')\n| extend ProvisionedDiskIops = iff(DiskVisibilityComplete and DiskIopsKnown == ExpectedDisks, DiskIops, tolong('')),\n         ProvisionedDiskMBps = iff(DiskVisibilityComplete and DiskMBpsKnown == ExpectedDisks, DiskMBps, toreal(''))\n| extend AcceleratedNetworking = case(IsVmss, 'Review scale-set NIC configurations',\n            isnull(ExpectedNics) or NicRows != ExpectedNics or NicFlagRows != NicRows, 'Unknown - incomplete NIC evidence',\n            strcat(AcceleratedNicRows, ' of ', ExpectedNics, ' NICs enabled')),\n         SharedDiskEvidence = case(SharedDiskRows > 0, 'Detected - review clustering and migration sequencing',\n            IsVmss or DiskRows != ExpectedDisks or ExpectedDisks == 0, 'Unknown - incomplete attached-disk evidence',\n            'No sharing-enabled attached disks observed'),\n         EphemeralOsDisk = case(tostring(Profile.storageProfile.osDisk.diffDiskSettings.option) =~ 'Local', 'Configured - rebuild/persistence review',\n            isempty(tostring(Profile.storageProfile.osDisk)), 'Unknown', 'Not configured in indexed model'),\n         UnmanagedDiskEvidence = iff(isnotempty(tostring(Profile.storageProfile.osDisk.vhd.uri)) or tostring(Profile.storageProfile.dataDisks) contains 'vhd',\n            'Detected - managed-disk migration review', 'No unmanaged disk reference observed'),\n         Hibernation = case(tobool(VM.properties.additionalCapabilities.hibernationEnabled) == true, 'Enabled - target support review',\n            isnull(VM.properties.additionalCapabilities.hibernationEnabled), 'Unknown - not recorded', 'Disabled in indexed model'),\n         SecurityType = iff(isempty(tostring(Profile.securityProfile.securityType)), 'Not recorded - verify effective security type', tostring(Profile.securityProfile.securityType)),\n         SystemAssignedIdentity = iff(tostring(VM.identity.type) contains 'SystemAssigned', 'Present - preserve/re-authorize if rebuilding', 'No system-assigned identity recorded'),\n         MarketplacePlan = strcat(tostring(VM.plan.publisher), ' / ', tostring(VM.plan.product)),\n         AdeEvidence = case(AdeExtensionRows > 0, 'Extension observed - guest encryption state unverified',\n             AdeDiskRows > 0, 'Attached-disk ADE configuration observed - confirm OS/data and guest state',\n             'Guest encryption state unverified'),\n         InventoryRole = case(IsVmss, 'Scale-set model', isnotempty(tostring(Profile.virtualMachineScaleSet.id)), 'Flexible member detail - do not add to model capacity', 'Standalone VM')\n| join kind=leftouter (\n    resources\n    | where type in~ ('microsoft.containerservice/managedclusters', 'microsoft.databricks/workspaces',\n        'microsoft.solutions/applications', 'microsoft.redhatopenshift/openshiftclusters')\n    | extend OwnerKind = case(type =~ 'microsoft.containerservice/managedclusters', 'AKS',\n             type =~ 'microsoft.databricks/workspaces', 'Databricks',\n             type =~ 'microsoft.redhatopenshift/openshiftclusters', 'ARO', 'Managed application')\n    | extend RgId = tolower(case(OwnerKind == 'AKS', strcat('/subscriptions/', subscriptionId, '/resourceGroups/', tostring(properties.nodeResourceGroup)),\n             OwnerKind == 'ARO', tostring(properties.clusterProfile.resourceGroupId), tostring(properties.managedResourceGroupId)))\n    | project RgId, OwnerKind, OwnerId = tolower(id)\n    | union (\n        resourcecontainers\n        | where type =~ 'microsoft.resources/subscriptions/resourcegroups' and isnotempty(tostring(managedBy))\n        | extend OwnerId = tolower(tostring(managedBy))\n        | project RgId = tolower(id), OwnerId, OwnerKind = case(\n            OwnerId contains '/microsoft.containerservice/managedclusters/', 'AKS',\n            OwnerId contains '/microsoft.databricks/workspaces/', 'Databricks',\n            OwnerId contains '/microsoft.batch/', 'Batch', 'Managed service')\n      )\n    | where isnotempty(RgId) and isnotempty(OwnerId)\n    | summarize OwnerIds = make_set(OwnerId, 20), OwnerKinds = make_set(OwnerKind, 20) by RgId\n  ) on RgId\n| join kind=leftouter (\n    desktopvirtualizationresources\n    | where type =~ 'microsoft.desktopvirtualization/hostpools/sessionhosts'\n    | extend VmId = tolower(tostring(properties.resourceId))\n    | where isnotempty(VmId)\n    | summarize AvdHostPoolIds = make_set(tostring(split(tolower(id), '/sessionhosts/')[0]), 20) by VmId\n  ) on VmId\n| extend Workload = trim('; ', strcat(\n        iff(array_length(OwnerKinds) > 0, strcat(strcat_array(OwnerKinds, '; '), '; '), ''),\n        iff(isnotempty(tostring(VM.managedBy)) and coalesce(array_length(OwnerKinds), 0) == 0, 'Managed service (compute managedBy); ', ''),\n        iff(array_length(AvdHostPoolIds) > 0, 'AVD; ', ''),\n        iff(SqlExtensionRows > 0 or SqlRegistrationRows > 0, 'SQL; ', ''),\n        iff(SapExtensionRows > 0 or tostring(Profile.licenseType) contains 'SLES_SAP' or ImageOffer contains 'sap', 'SAP signal; ', '')))\n| extend Workload = iff(isempty(Workload), 'Unclassified - guest/workload assessment required', Workload),\n         AssociationEvidence = strcat('Compute managedBy: ', tostring(VM.managedBy), '; Managed owners: ', tostring(OwnerIds), '; AVD host pools: ', tostring(AvdHostPoolIds),\n            '; SQL extensions/registrations: ', SqlExtensionRows, '/', SqlRegistrationRows, '; SAP extensions: ', SapExtensionRows),\n         MigrationMethod = case(array_length(OwnerIds) > 1, 'Multiple owner associations - resolve ownership before changes',\n            tostring(OwnerKinds) contains 'AKS', 'AKS node-pool workflow; validate surge, PDBs, persistence and capacity',\n            tostring(OwnerKinds) contains 'Databricks', 'Databricks-supported node type/runtime and cluster restart/recreation',\n            array_length(AvdHostPoolIds) > 0, 'AVD host replacement; check pooled/personal type, sessions, profiles and persistence',\n            tostring(OwnerKinds) contains 'Batch', 'Batch pool replacement; drain tasks and review autoscale/quotas',\n            array_length(OwnerKinds) > 0 or isnotempty(tostring(VM.managedBy)), 'Use owning service/vendor migration workflow; do not directly resize managed compute',\n            SqlExtensionRows > 0 or SqlRegistrationRows > 0 or Workload contains 'SAP', 'Stateful/vendor assessment before resize or rebuild; validate HA, licensing, backup and rollback',\n            'Determine application owner/state; then validate resize versus rebuild and rollback'),\n         MigrationApproval = 'Not assessed - application, HA, backup and rollback require evidence'\n\n| extend OsHintSource = iff(isnotempty(GuestOsName), 'Guest OS metadata', 'Image hint only - current guest unverified'),\n         OsHintText = tolower(iff(isnotempty(GuestOsName), GuestOsName, strcat(ImagePublisher, ' ', ImageOffer, ' ', ImageSku)))\n| extend NvmeOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2019|2022|2025)($|[^0-9])', 'Listed OS family - validate image, generation and boot',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(18[._-]04|20[._-]04|22[._-]04|24[._-]04)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        OsHintText matches regex @'debian[^0-9]{0,30}(11|12)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        'Review official NVMe OS list - not classified by captured subset'),\n         ManaOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2016|2019|2022|2025)($|[^0-9])', 'Listed OS family - install/verify current MANA driver',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(22[._-]04|24[._-]04|26[._-]04)($|[^0-9])', 'Listed OS family - verify minimum kernel and MANA driver',\n        'Review official MANA OS/kernel list - not classified by captured subset')\n| extend NvmeDriverValidation = 'Unknown - guest driver and target boot not tested',\n         ManaDriverValidation = 'Unknown - target hardware, driver and traffic not tested',\n         NvmeOsReference = 'https://learn.microsoft.com/azure/virtual-machines/enable-nvme-interface',\n         ManaOsReference = 'https://learn.microsoft.com/azure/virtual-network/accelerated-networking-overview',\n         OsReferenceChecked = '2026-11-18'\n| extend CatalogueRecord = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| extend CatalogueCoverage = iff(isempty(CatalogueRecord), 'Not assessed - SKU absent from captured catalogue', tostring(split(CatalogueRecord, '|')[0]))\n\n| project Name, ResourceGroup, SubscriptionId, Region, VmSize, CatalogueCoverage, Workload, MigrationMethod,\n    AcceleratedNetworking, ExpectedNics, DataDiskCount, SharedDiskEvidence, EphemeralOsDisk,\n    UnmanagedDiskEvidence, Hibernation, SecurityType, SystemAssignedIdentity, MarketplacePlan, AdeEvidence,\n    AdeDiskRows, ApplianceEvidence, PlacementEvidence, DiskVisibilityComplete, NicVisibilityComplete,\n    ProvisionedDiskIops, ProvisionedDiskMBps,\n    OsHintSource, NvmeOsHint, ManaOsHint, NvmeDriverValidation, ManaDriverValidation,\n    OsReferenceChecked, NvmeOsReference, ManaOsReference, AssociationEvidence, OwnerIds, AvdHostPoolIds,\n    SqlGroupIds, MigrationApproval, InventoryRole, ResourceId\n| order by Workload asc, Name asc\n| extend Details = 'Details'","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Workload route evidence - all observed compute, including unassessed sizes","gridSettings":{"formatters":[{"columnMatch":"Name","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"Workload","formatter":0,"formatOptions":{"customColumnWidthSetting":"24fr"}},{"columnMatch":"MigrationMethod","formatter":0,"formatOptions":{"customColumnWidthSetting":"65fr"}},{"columnMatch":"Details","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"10fr"}},{"columnMatch":"ResourceGroup","formatter":5},{"columnMatch":"SubscriptionId","formatter":5},{"columnMatch":"Region","formatter":5},{"columnMatch":"VmSize","formatter":5},{"columnMatch":"CatalogueCoverage","formatter":5},{"columnMatch":"AcceleratedNetworking","formatter":5},{"columnMatch":"ExpectedNics","formatter":5},{"columnMatch":"DataDiskCount","formatter":5},{"columnMatch":"SharedDiskEvidence","formatter":5},{"columnMatch":"EphemeralOsDisk","formatter":5},{"columnMatch":"UnmanagedDiskEvidence","formatter":5},{"columnMatch":"Hibernation","formatter":5},{"columnMatch":"SecurityType","formatter":5},{"columnMatch":"SystemAssignedIdentity","formatter":5},{"columnMatch":"MarketplacePlan","formatter":5},{"columnMatch":"AdeEvidence","formatter":5},{"columnMatch":"AdeDiskRows","formatter":5},{"columnMatch":"ApplianceEvidence","formatter":5},{"columnMatch":"PlacementEvidence","formatter":5},{"columnMatch":"DiskVisibilityComplete","formatter":5},{"columnMatch":"NicVisibilityComplete","formatter":5},{"columnMatch":"ProvisionedDiskIops","formatter":5},{"columnMatch":"ProvisionedDiskMBps","formatter":5},{"columnMatch":"OsHintSource","formatter":5},{"columnMatch":"NvmeOsHint","formatter":5},{"columnMatch":"ManaOsHint","formatter":5},{"columnMatch":"NvmeDriverValidation","formatter":5},{"columnMatch":"ManaDriverValidation","formatter":5},{"columnMatch":"OsReferenceChecked","formatter":5},{"columnMatch":"NvmeOsReference","formatter":5},{"columnMatch":"ManaOsReference","formatter":5},{"columnMatch":"AssociationEvidence","formatter":5},{"columnMatch":"OwnerIds","formatter":5},{"columnMatch":"AvdHostPoolIds","formatter":5},{"columnMatch":"SqlGroupIds","formatter":5},{"columnMatch":"MigrationApproval","formatter":5},{"columnMatch":"InventoryRole","formatter":5},{"columnMatch":"ResourceId","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"routes-evidence","customWidth":"100"},{"type":1,"content":{"json":"### Choose a migration route\n\nThis selector changes guidance, not resources, recommendations or approval. A workload can need more than one operation; read each applicable route. Resolve the per-resource evidence and gates before selecting a supported method."},"name":"assess-route-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"assess-route-select","content":{"version":"LinkItem/1.0","style":"tabs","links":[{"id":"bfe3ee2a-bad2-5dc4-aaac-f964dcc7c701","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Same-VM resize","subTarget":"resize","preText":"","style":"link"},{"id":"c15a5af5-1036-580c-97d3-f470c4f71fd0","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Parallel replacement","subTarget":"parallel","preText":"","style":"link"},{"id":"9d1117b2-ff04-5a38-a466-3b249022b1d6","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Service-owned replacement","subTarget":"service","preText":"","style":"link"},{"id":"6185a37d-668c-546b-ad26-0bec0a989514","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Gen1 to Trusted Launch","subTarget":"gen1","preText":"","style":"link"},{"id":"5d9ca992-9c8c-584f-adc6-1dd25dfd14e8","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"SCSI to NVMe","subTarget":"nvme","preText":"","style":"link"}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Same-VM resize\n\n- Confirm the exact source/target pair supports the existing generation, controller,\n  security/encryption configuration, local-disk topology and supported OS. A matching\n  vCPU/memory size alone does not establish a supported resize.\n- Plan restart/deallocation, IP/address consequences, availability-set/host constraints,\n  extensions and licensed core changes. Enabled hibernation is not proof of a hibernated\n  guest: check runtime state and resume/clear it as required by the supported operation.\n- Recheck family/regional quota and actual allocation capacity. A return to the source\n  size is not guaranteed once deallocated, especially near retirement.\n- Recovery: rehearsed backup/restore and an approved alternative destination if the\n  old family cannot be reallocated. A resize-back is not a universal rollback.\n\n[Supported resize procedure](https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm)\n"},"name":"assess-route-resize-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"resize"},"name":"assess-route-resize"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Parallel replacement\n\nPreferred modernization pattern where workload architecture permits it: build a\nsupported replacement, move state, validate it, then cut over. **A fresh OS disk does\nnot inherit application state from the old OS disk.**\n\n- Inventory OS-disk-only data, local databases, certificates/private keys, licenses,\n  scheduled tasks, service accounts, application configuration and identity permissions.\n- Recreate networking, private DNS, routes, NSGs, load-balancer probes, IP forwarding,\n  IP preservation requirements, backup, monitoring and security integrations.\n- Use full side-by-side target quota, including temporary surge and service quotas.\n  Update images and restore data using a supported, tested application procedure.\n- Recovery: retain a recoverable source for the agreed period; define how writes made\n  after cutover are reconciled. Record the system of record, cutback trigger, authority,\n  RPO/RTO and last safe recovery time before changing traffic.\n\n[Modernization planning](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/sizes-v6-v7-modernization-plan)\n"},"name":"assess-route-parallel-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"parallel"},"name":"assess-route-parallel"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Service-owned replacement\n\nUse the owning service's supported size/node-type list and replacement API/runbook.\nCompute SKU offerability alone does not certify an AKS, Batch, Databricks or AVD target.\nResolve conflicting associations before proceeding. **Do not resize managed backing\nVMs individually.** AVD session hosts still require the appropriate customer-managed\nhost/image procedure, with pooled and personal persistence treated differently.\n\n- AKS/VMSS: test surge, upgrade policy, disruption budgets, storage, scheduling and drain.\n- Batch: create/validate a replacement pool; move job/pool references and autoscale\n  formulas; let tasks complete or explicitly recover/checkpoint them before deletion.\n- Databricks: use a supported node type/runtime for job and all-purpose clusters,\n  pools and policies; validate restart/recreation, jobs, queries and connections.\n- AVD: verify host-pool type and persistence/assignment requirements, not only VM size.\n- Recovery: service-level restoration, pool/cluster recreation and application state\n  recovery must be rehearsed; a backing VM snapshot alone is not a service rollback.\n\nSelect the workload acceptance checklist under **Migrate & validate**.\n"},"name":"assess-route-service-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"service"},"name":"assess-route-service"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Gen1 to Trusted Launch - distinct in-place operation\n\nThis is not a synonym for SKU resize or SCSI-to-NVMe conversion. Confirm the current\ndocumented eligibility, Windows/Linux route, boot layout/EFI space, supported OS,\nsecurity and disk settings, Backup policy and ASR prerequisites before using it.\nWindows Server 2016 and Windows OS encryption restrictions on the documented\nconversion route must be resolved; a separate rebuild route has different prerequisites.\n\n**A Trusted Launch conversion cannot be undone by simply resizing back or changing\nthe controller.** Rehearse recovery from a suitable pre-conversion backup. Gen1 image\nreferences can remain after conversion: reconcile image, patching and reimage behavior.\nPlatform support does not make a community automation script Microsoft-supported.\n\n[Gen1 upgrade prerequisites and recovery](https://learn.microsoft.com/azure/virtual-machines/trusted-launch-existing-vm-gen-1)\n"},"name":"assess-route-gen1-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"gen1"},"name":"assess-route-gen1"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### SCSI to NVMe - distinct in-place operation\n\nChanging the disk controller and resizing are distinct from Gen1/Trusted Launch\nconversion. Confirm the exact VM/security/OS combination is supported by the\ndocumented operation; do not assume any v6/v7 suffix proves compatibility.\n\n- Verify actual image/disk NVMe capability, boot-critical driver, initramfs where\n  applicable and successful boot from the actual converted disk. Image publisher\n  and supported OS metadata are hints, not proof of installed/current guest drivers.\n- Validate MANA and real network traffic independently of NVMe.\n- Inspect fstab, LVM, mount units, application/backup scripts and device-path\n  assumptions; use stable identifiers. Confirm data disks mount correctly.\n- Temporary/local NVMe can be raw or reinitialized after deallocation. Test its\n  initialization plus pagefile, swap, tempdb and scratch placement; it is not durable data.\n- Recovery: use only the operation's documented reversal prerequisites; otherwise\n  recover from the rehearsed backup. A controller switch is not a universal rollback.\n\n[NVMe guidance](https://learn.microsoft.com/azure/virtual-machines/nvme-overview) |\n[Supported modernization operations](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/sizes-v6-v7-modernization-modernize)\n"},"name":"assess-route-nvme-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"nvme"},"name":"assess-route-nvme"},{"type":1,"content":{"json":"### Gates for every route\n\n**ADE has a separate retirement on 15 September 2028**, independent of VM-size\nretirement. Determine OS versus data-disk encryption and Windows versus Linux\nscope using guest and disk evidence. An absent ADE extension does not prove\ndecryption or absence of guest encryption.\n\nADE to encryption at host is **not an in-place conversion**: use the documented\nnew-disk/new-VM migration route. Linux ADE-encrypted OS disks cannot simply be\ndecrypted. Disk encryption history/UDE can persist after decryption, snapshots and\nCopy; do not assume a copied/decrypted disk qualifies for encryption at host.\nFollow the documented supported migration procedure, including its Upload versus\nCopy distinctions, and validate data, keys, recovery and target encryption.\n[ADE migration guidance](https://learn.microsoft.com/azure/virtual-machines/disk-encryption-migrate)\n\n**Vendor certification is a gate.** Known network/storage/backup appliance image\npublishers are only *suspected appliance* signals; a Marketplace image is not\nautomatically an appliance, and unrecognized/custom images are not automatically\ncleared. Confirm the exact vendor product/version, target family, NIC/driver and\nHA certification before choosing a route.\n\n**Placement is more than region offerability.** Review exact zones, availability\nsets, Dedicated Host/host groups, proximity placement groups (PPG), capacity\nreservation groups and service-specific topology. A region-supported SKU does not\nestablish that a host, PPG, reservation or zone can accommodate it.\n\nGuest-only gates stay **Unknown**: signed/current storage, backup and security filter\ndrivers; application data/state; encryption; boot/MANA/NVMe behavior; and recovery.\nDo not install agents or deploy telemetry infrastructure just to use this workbook.\n"},"name":"routes-common-gates","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AssessView","comparison":"isEqualTo","value":"routes"},"name":"grp-routes"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Prerequisites and architecture work\nSome size transitions are a simple resize. Others require work **before** the resize can succeed - converting a Gen1 VM to Gen2, validating NVMe and MANA driver support in the OS image, or removing a dependency on the local temp disk. Each row below is a prerequisite that applies to your fleet, with the number of resources affected."},"name":"pre-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| extend Codes = split(WarnCodes, ',')\n| extend Codes = array_concat(Codes,\n        iff(TargetInRegion == 'No', pack_array('target_not_in_region'), dynamic([])),\n        iff(isnotempty(AvSetId), pack_array('availability_set'), dynamic([])),\n        iff(IsVmss, pack_array('scale_set'), dynamic([])),\n        pack_array('quota_headroom'))\n| mv-expand Code = Codes to typeof(string)\n| where isnotempty(Code)\n| where not(Code == 'g' and VmGeneration == 'V2')\n| where Code != 's'\n| extend D = split(tostring(parse_json('{\"a\":\"CPU architecture port (x64 to Arm64)|Blocking|The target uses a different CPU architecture. Every binary, agent, driver and third-party package must be rebuilt or re-sourced for the target architecture.|x64 and Arm64 binaries are not interchangeable. This is a porting project, not a resize, and needs its own timeline.|Inventory all installed software and confirm Arm64 availability before committing.|https://learn.microsoft.com/azure/virtual-machines/sizes/overview\",\"availability_set\":\"Availability set resize constraint|Plan|This VM is in an availability set. The target size must be available on the same cluster, or every VM in the set must be stopped and resized together.|Availability set members are pinned to a cluster that may not offer the target size.|Stop all VMs in the availability set, resize, then restart.|https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm\",\"g\":\"Generation 1 to Generation 2 (BIOS to UEFI) conversion|Blocking|Convert the OS disk from Generation 1 to Generation 2, or rebuild the VM from a Gen2 image. Confirm the OS version is supported for Gen2 and that any custom or Marketplace image has a Gen2 variant.|The selected target supports Generation 2 only. A Gen1 VM cannot be resized into it without conversion or rebuilding. A compatible v5 target can avoid this requirement.|Windows: MBR2GPT. Linux: distro-specific. Or redeploy from a Gen2 image.|https://learn.microsoft.com/azure/virtual-machines/generation-2\",\"h\":\"MANA and accelerated networking validation|Validate|Check the actual target hardware, guest driver and accelerated networking traffic independently from the storage controller. This can apply to v5 SCSI targets too.|MANA exposure depends on host hardware. Missing hardware is unknown driver readiness, not proof of failure; virtual-switch fallback may preserve connectivity with different performance.|Validate hardware, adapter, driver and traffic for each image lineage on the selected target.|https://learn.microsoft.com/azure/virtual-network/accelerated-networking-mana-overview\",\"m\":\"Memory parity check|Blocking|The same-vCPU target carries less memory than the current size. Confirm real memory utilisation before accepting it, or move to the memory-preserving alternative shown in the Target mapping tab.|Common on G-series and the large memory-optimised sizes. Silently under-provisioning RAM on a database or in-memory workload causes outages.|Baseline 30-90 days of memory metrics, then choose between the default and the memory-preserving target.|https://learn.microsoft.com/azure/virtual-machines/sizes/overview\",\"n\":\"NVMe disk controller support|Validate|Confirm the OS image supports the selected target\\'s NVMe boot controller. Test boot on the target size before bulk migration. MANA networking is evaluated separately.|A target requiring NVMe can fail to boot an incompatible image. Driver presence alone is not boot proof; custom and older images need a target-specific rehearsal.|Check the supported OS list, then validate one VM per image lineage.|https://learn.microsoft.com/azure/virtual-machines/nvme-overview\",\"quota_headroom\":\"Target family quota headroom|Plan|Verify per-family vCPU quota for the target family in the target region and raise a quota request early if short.|Target families have separate quota buckets from the source. A fleet-wide resize can fail midway on quota, and approval is not instant.|az vm list-usage --location <region> -o table|https://learn.microsoft.com/azure/quotas/view-quotas\",\"r\":\"Limited target region availability|Plan|The recommended target is offered in a small number of regions. Confirm availability in the region this workload runs in before planning the move.|Recommending a size that cannot be deployed in the workload\\'s region wastes a migration window.|az vm list-skus --location <region> --resource-type virtualMachines --size <target> --all|https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm\",\"scale_set\":\"Scale set SKU change|Plan|This is a virtual machine scale set. Change the SKU on the scale set model and roll instances through the upgrade policy rather than resizing instances individually.|Scale set instances are governed by the model; editing instances directly drifts the set.|Update the scale set SKU, then apply the rolling upgrade policy.|https://learn.microsoft.com/azure/virtual-machine-scale-sets/virtual-machine-scale-sets-upgrade-scale-set\",\"t\":\"Local temp disk dependency removal|Blocking|Find every dependency on the local temp disk (D:\\\\\\\\ on Windows, /mnt on Linux) - pagefile/swap, SQL Server tempdb, application scratch and cache directories, log staging. Relocate them, or choose a \\'d\\' variant of the target series to keep local storage.|Non-\\'d\\' target series have no local disk. Anything pinned to that path breaks silently on first boot, and SQL tempdb failures take the instance down.|Move the page file and tempdb to a managed data disk, or select the \\'d\\' variant target.|https://learn.microsoft.com/azure/virtual-machines/managed-disks-overview\",\"target_not_in_region\":\"Target size not available in this region|Blocking|The recommended target size is not currently offered in this VM\\'s region. Select an alternate target from the Target mapping tab, or plan a regional move.|The default recommendation cannot be deployed here. Proceeding would fail at resize time.|Review the alternate targets listed for this size, then confirm with az vm list-skus.|https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm\",\"u\":\"No suitable v5 target in the captured catalogue|Plan|Review the newer-generation recommendation manually. No catalogued v5 candidate preserves the required architecture, CPU, memory, local-disk and premium-storage capabilities without requiring NVMe.|V5-first is a preference, not permission to invent a SKU or downgrade workload requirements.|Refresh the target catalogue and confirm a supported migration path before choosing a newer target.|https://learn.microsoft.com/azure/virtual-machines/sizes/overview\",\"v\":\"vCPU count change|Plan|No target exists at the current vCPU count, so the nearest size is larger. Right-size against actual utilisation rather than the current nameplate, and re-check per-core software licensing.|A vCPU increase can trigger a licensing true-up (SQL Server, Oracle, SAP, third-party agents) that outweighs the compute saving.|Baseline CPU utilisation for 30-90 days, then select the size that fits real demand.|https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm\",\"z\":\"Availability zone parity|Plan|The target is not offered across three availability zones in the regions where it is available. If this workload is zone-redundant, validate the zone footprint before moving.|Losing a zone silently reduces the availability SLA of the design.|Check zone availability for the target size in the workload\\'s region.|https://learn.microsoft.com/azure/reliability/availability-zones-overview\"}')[Code]), '|')\n| where array_length(D) > 1\n| summarize Resources = count(), Instances = sum(Instances),\n            Sizes = strcat_array(make_set(VmSize, 12), ', ')\n    by Prerequisite = tostring(D[0]), Severity = tostring(D[1]),\n       WhatToDo = tostring(D[2]), Why = tostring(D[3]), How = tostring(D[4]), Guidance = tostring(D[5])\n| extend SevRank = case(Severity == 'Blocking', 1, Severity == 'Validate', 2, 3)\n| order by SevRank asc, Instances desc\n| project-away SevRank","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Prerequisites triggered by your fleet","gridSettings":{"formatters":[{"columnMatch":"Prerequisite","formatter":1,"formatOptions":{"linkColumn":"Guidance","linkTarget":"Url","customColumnWidthSetting":"16fr"}},{"columnMatch":"Severity","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":"==","thresholdValue":"Blocking","representation":"redBright","text":"{0}{1}"},{"operator":"==","thresholdValue":"Validate","representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"blue","text":"{0}{1}"}],"customColumnWidthSetting":"7fr"}},{"columnMatch":"Resources","formatter":0,"formatOptions":{"customColumnWidthSetting":"5fr"}},{"columnMatch":"Instances","formatter":0,"formatOptions":{"customColumnWidthSetting":"5fr"}},{"columnMatch":"WhatToDo","formatter":0,"formatOptions":{"customColumnWidthSetting":"21fr"}},{"columnMatch":"Why","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"How","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Sizes","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"Guidance","formatter":5}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"WhatToDo","label":"What to do"},{"columnId":"Sizes","label":"Sizes affected"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"pre-grid","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"AssessView","comparison":"isEqualTo","value":"prereq"},"name":"grp-prereq"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## SQL modernization opportunities on retiring VMs\n\nThese **retiring/end-of-life VMs** have SQL VM registration evidence, a SQL IaaS Agent extension with publisher **Microsoft.SqlServer.Management** and handler **SqlIaaSAgent**, or both. VM names and SQL-looking images alone are not evidence. Each VM appears once; extension/registration provisioning states are retained, including failed or unknown states. Registration edition, license type, management mode and group associations are shown. A registered group does not verify active Always On membership or health. Filtering is retirement-only and independent of the global Lifecycle status selector.\n\n**Discovery signal, not certification.** Extension or registration presence does not establish that SQL Server is installed, running, in use or suitable for a managed database service. A stopped VM remains an assessment candidate; its power state is shown when available. VMs without either visible signal are **not proven SQL-free**. Limited permissions, ARG indexing, registration mode and unsupported/unrecognized handlers can cause omissions. Flexible scale-set member VMs are evaluated individually here; scale-set models and Uniform instances without individual ARG VM records are not included.\n\nConfirm engine/version/edition, databases, dependencies (SQL Agent jobs, linked servers, SSIS/SSRS and cross-database features), HA/DR, performance, licensing and downtime. Assess **Azure SQL Managed Instance**, **Azure SQL Database**, or supported SQL Server on modern VMs based on evidence, not extension presence alone.\n\n[SQL IaaS Agent registration](https://learn.microsoft.com/azure/azure-sql/virtual-machines/windows/sql-agent-extension-manually-register-single-vm) | [SQL migration guidance](https://learn.microsoft.com/azure/azure-sql/migration-guides/)"},"name":"sql-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| where Lifecycle != 'OPTIONAL'\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where not(IsVmss)\n| extend VmId = tolower(ResourceId)\n| join kind=inner (\nresources\n| where type in~ ('microsoft.compute/virtualmachines/extensions', 'microsoft.sqlvirtualmachine/sqlvirtualmachines')\n| extend IsRegistration = type =~ 'microsoft.sqlvirtualmachine/sqlvirtualmachines'\n| extend IsSqlExtension = type =~ 'microsoft.compute/virtualmachines/extensions'\n    and tostring(properties.publisher) =~ 'Microsoft.SqlServer.Management'\n    and (tostring(properties.type) =~ 'SqlIaaSAgent' or tostring(properties.typePropertiesType) =~ 'SqlIaaSAgent')\n| where IsRegistration or IsSqlExtension\n| extend ParentOffset = indexof(tolower(id), '/extensions/')\n| extend VmId = iff(IsRegistration, tolower(tostring(properties.virtualMachineResourceId)),\n                   iff(ParentOffset > 0, tolower(substring(id, 0, ParentOffset)), ''))\n| where isnotempty(VmId)\n| extend ExtensionState = iff(isempty(tostring(properties.provisioningState)), 'Unknown', tostring(properties.provisioningState))\n| summarize SqlExtensionCount = countif(IsSqlExtension),\n            SqlExtensions = strcat_array(make_set_if(tostring(split(name, '/')[-1]), IsSqlExtension, 20), ', '),\n            ExtensionStates = strcat_array(make_set_if(ExtensionState, IsSqlExtension, 20), ', '),\n            SqlRegistrationCount = countif(IsRegistration),\n            SqlRegistrationIds = strcat_array(make_set_if(id, IsRegistration, 20), ', '),\n            SqlRegistrationStates = strcat_array(make_set_if(ExtensionState, IsRegistration, 20), ', '),\n            SqlEditions = strcat_array(make_set_if(tostring(properties.sqlImageSku), IsRegistration, 20), ', '),\n            SqlLicenseTypes = strcat_array(make_set_if(tostring(properties.sqlServerLicenseType), IsRegistration, 20), ', '),\n            SqlManagementModes = strcat_array(make_set_if(tostring(properties.sqlManagement), IsRegistration, 20), ', '),\n            SqlGroupIds = strcat_array(make_set_if(tostring(properties.sqlVirtualMachineGroupResourceId), IsRegistration, 20), ', ')\n    by VmId\n  ) on VmId\n| extend DiscoverySignals = case(SqlExtensionCount > 0 and SqlRegistrationCount > 0, 'SQL IaaS extension and SQL VM registration',\n             SqlExtensionCount > 0, 'SQL IaaS extension only', 'SQL VM registration only'),\n         Opportunity = 'Retiring VM with SQL evidence - assess modernization',\n         SqlRuntime = 'Unverified - extension or registration does not prove SQL is running',\n         HaEvidence = iff(isempty(SqlGroupIds), 'HA topology not established', 'SQL VM group registered - active HA membership/health unverified'),\n         Assessment = 'Validate SQL instances/version/edition, database compatibility, dependencies, HA/DR, performance, licensing and downtime; assess Azure SQL Managed Instance, Azure SQL Database or supported SQL on modern VMs.',\n         Guidance = 'https://learn.microsoft.com/azure/azure-sql/migration-guides/'\n| project Name, ResourceGroup, Region, VmSize, Lifecycle, RetiresOn, PowerState,\n          DiscoverySignals, SqlExtensions, ExtensionStates, SqlExtensionCount,\n          SqlRegistrationCount, SqlRegistrationIds, SqlRegistrationStates, SqlEditions,\n          SqlLicenseTypes, SqlManagementModes, SqlGroupIds, HaEvidence, Opportunity,\n          SqlRuntime, Assessment, RecommendedTarget, Guidance, ResourceId\n| order by RetiresOn asc, Name asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching SQL registration/extension evidence for retiring VMs in this scope. This does not prove SQL is absent. Check subscription access and workload inventory.","title":"Retiring VMs with SQL extension and/or registration evidence","gridSettings":{"formatters":[{"columnMatch":"Name","formatter":1,"formatOptions":{"linkColumn":"ResourceId","linkTarget":"Resource","linkIsContextBlade":true,"customColumnWidthSetting":"20fr"}},{"columnMatch":"ResourceGroup","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"13fr"}},{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"RetiresOn","formatter":6,"dateFormat":{"showUtcTime":true,"formatName":"shortDatePattern"},"formatOptions":{"customColumnWidthSetting":"13fr"}},{"columnMatch":"PowerState","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"ExtensionStates","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Opportunity","formatter":0,"formatOptions":{"customColumnWidthSetting":"42fr"}},{"columnMatch":"Assessment","formatter":0,"formatOptions":{"customColumnWidthSetting":"55fr"}},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"Guidance","formatter":1,"formatOptions":{"linkTarget":"Url"}}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"VmSize","label":"Retiring size"},{"columnId":"ExtensionStates","label":"Extension state"},{"columnId":"SqlRuntime","label":"SQL runtime evidence"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"sql-modernization-grid","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"AssessView","comparison":"isEqualTo","value":"sql"},"name":"grp-sql"},{"type":11,"name":"workflow-next-assess","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"5026557b-5e21-5c98-8891-3f34849fe070","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Previous: 1. Inventory","subTarget":"inventory","preText":"","style":"link"},{"id":"8ff958d8-fc1c-55f3-94df-1c8c1b687dfe","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Next: 3. Plan","subTarget":"planning","preText":"","style":"primary"},{"id":"569bafe3-4f9e-552d-9610-13f2f046cdeb","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Help: Methodology & references","subTarget":"about","preText":"","style":"link"}]}}]},"conditionalVisibility":{"parameterName":"WorkflowStage","comparison":"isEqualTo","value":"assess"},"name":"stage-assess"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## 3. Plan - what resources and sequencing will I need?\n\n**Goal:** Create a feasible, owner-approved plan for target availability, quota, remediation, pilots and waves.\n\n**What to do:** Use Live target availability for the selected target's subscription/region/zone access. Use Capacity & quota for fleet demand and regional/family limits. Review target specifications and adapt suggested waves to application dependencies.\n\n**Before moving on:** Confirm target eligibility and actual capacity separately, request quota where needed, schedule prerequisite work, and agree pilot, downtime, backup and rollback plans.\n\n**Outcome / interpretation:** An execution plan. Quota headroom is not physical capacity or transferable quota; the quota model defaults to V5-first; select the matching V5/V6/V7 scenario explicitly. Managed-pool peak/surge demand needs separate planning."},"name":"workflow-guide-planning","styleSettings":{"margin":"0","padding":"0"}},{"type":1,"content":{"json":"**Evidence key:** catalogue/reference dates are shown in Start here. Inventory, ownership, Advisor and quota are **indexed ARG** data at refresh, not real-time allocation or guest telemetry. The selected SKU record is **live ARM** at inspection. Guest/application/recovery evidence is **customer-confirmed** and stays Unknown here until independently verified. **Captured as of:** catalogue 2026-09-22T18:03:33; quota family/CPU map 2026-11-17T17:43:27.5429677Z."},"name":"workflow-evidence-planning","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"workflow-views-planning","content":{"version":"LinkItem/1.0","style":"tabs","links":[{"id":"e8b78867-be27-5d2a-a1f3-2d803c7a01fe","cellValue":"PlanView","linkTarget":"parameter","linkLabel":"Live target availability","subTarget":"availability","preText":"","style":"link"},{"id":"271c7ad1-d24b-52e3-bc8a-ab8c18e58ea4","cellValue":"PlanView","linkTarget":"parameter","linkLabel":"Capacity & quota","subTarget":"quota","preText":"","style":"link"},{"id":"718b66f2-0209-50a1-b81b-018749cc79b5","cellValue":"PlanView","linkTarget":"parameter","linkLabel":"Target specifications","subTarget":"mapping","preText":"","style":"link"},{"id":"757ca2e8-af2c-5a7b-a92b-f730c0ff5eef","cellValue":"PlanView","linkTarget":"parameter","linkLabel":"Compatible alternatives","subTarget":"alternatives","preText":"","style":"link"},{"id":"2aa1843d-53a9-541b-9a58-823df2612427","cellValue":"PlanView","linkTarget":"parameter","linkLabel":"Suggested waves","subTarget":"plan","preText":"","style":"link"}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Live target availability\n\n**Select a subscription / region / zone / target SKU combination.** Reselect after changing the path.\n\n**Loading:** access results may take a few seconds; wait before retrying an initial **Unknown**. Persistent Unknown is not a pass.\n\n**Green - Not restricted:** no applicable access restriction. **Red - Restricted:** follow the support/quota action. **Amber - Unknown:** missing, failed or unadvertised evidence; never a pass. Empty results are not a pass.\n\n**Green is SKU access only**, not a quota, Azure Policy, physical-capacity or migration approval. **Result detail** shows capabilities, the key or raw evidence.\n\n**Next:** **Plan > Capacity & quota**, with the matching scenario. This placement selection does not filter fleet quota demand or change recommendations."},"name":"eligibility-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":9,"name":"eligibility-parameters","content":{"version":"KqlParameterItem/1.0","style":"pills","parameters":[{"version":"KqlParameterItem/1.0","name":"EligibilityGeneration","type":2,"label":"Inspect upgrade path","isRequired":true,"value":"5","jsonData":"[{\"value\":\"5\",\"label\":\"V5\"},{\"value\":\"6\",\"label\":\"V6\"},{\"value\":\"7\",\"label\":\"V7\"}]"},{"version":"KqlParameterItem/1.0","name":"LiveEvidence","type":2,"label":"Result detail","isRequired":true,"value":"summary","jsonData":"[{\"value\":\"summary\",\"label\":\"Customer summary\"},{\"value\":\"capabilities\",\"label\":\"Resource capability checks\"},{\"value\":\"key\",\"label\":\"Placement key & interpretation\"},{\"value\":\"raw\",\"label\":\"Advanced raw evidence\"}]"},{"version":"KqlParameterItem/1.0","name":"LiveSubscription","type":1,"value":"","isHiddenWhenLocked":true},{"version":"KqlParameterItem/1.0","name":"LiveRegion","type":1,"value":"","isHiddenWhenLocked":true},{"version":"KqlParameterItem/1.0","name":"LiveTarget","type":1,"value":"","isHiddenWhenLocked":true},{"version":"KqlParameterItem/1.0","name":"LiveZone","type":1,"value":"","isHiddenWhenLocked":true}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Placement key & interpretation\n\n**Scope:** each row groups affected resources in the workbook's selected subscriptions by subscription / region / zone / target SKU. **Regional** means no zone specified, not support in every zone. Multi-zone scale-set resources repeat across zone rows; their per-zone instance counts stay Unknown (blank). Missing/invalid model capacity also keeps the combination's count Unknown. Do not sum these rows as fleet capacity.\n\n**Restricted:** use the result's support link with the displayed placement. A quota-coded restriction needs a quota increase instead of a region/zone access request. Restrictions for other regions/zones do not block this placement. **Unknown:** retry and verify permissions/placement; a missing target requires manual selection.\n\nThe same read-only Compute SKU response feeds the summary, optional capability checks and raw evidence. It does not attempt allocation, reserve capacity or update catalogue recommendations/prerequisite statuses. See [SKU availability and restrictions](https://learn.microsoft.com/rest/api/compute/resource-skus/list) for API details."},"name":"eligibility-key-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"LiveEvidence","comparison":"isEqualTo","value":"key"},"name":"eligibility-key"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags, PlacementZones = zones\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| where Lifecycle != 'OPTIONAL'\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| extend PathRecord = tostring(case('{EligibilityGeneration}' == '5',\n         parse_json('{V5PathSkuMap}')[VmSize], '{EligibilityGeneration}' == '6',\n         parse_json('{V6PathSkuMap}')[VmSize], parse_json('{V7PathSkuMap}')[VmSize]))\n| extend SelectedTargetSku = tostring(split(PathRecord, '|')[3]), SourceSubscriptionId = SubscriptionId,\n         SourceRegion = Region,\n         PlacementOptions = iff(isnull(PlacementZones) or array_length(PlacementZones) == 0,\n                                dynamic(['Regional']), PlacementZones)\n| mv-expand SourceZone = PlacementOptions limit 2000\n| extend SourceZone = tostring(SourceZone),\n         ZoneInstances = iff(array_length(PlacementZones) > 1, tolong(''), tolong(Instances))\n| summarize AffectedResources = count(), KnownInstances = sum(ZoneInstances),\n            MultiZoneModels = countif(array_length(PlacementZones) > 1),\n            UnknownInstanceResources = countif(isnull(ZoneInstances) or ZoneInstances < 0)\n    by SourceSubscriptionId, SourceRegion, SourceZone, SelectedTargetSku\n| extend AffectedInstances = iff(UnknownInstanceResources > 0, tolong(''), KnownInstances)\n| project SourceSubscriptionId, SourceRegion, SourceZone, SelectedTargetSku,\n          AffectedResources, AffectedInstances, MultiZoneModels, UnknownInstanceResources\n| order by SourceSubscriptionId asc, SourceRegion asc, SourceZone asc, SelectedTargetSku asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Select one subscription / region / zone / target SKU combination","gridSettings":{"formatters":[{"columnMatch":"SourceSubscriptionId","formatter":0,"formatOptions":{"customColumnWidthSetting":"27fr"}},{"columnMatch":"SourceRegion","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"SourceZone","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"SelectedTargetSku","formatter":0,"formatOptions":{"customColumnWidthSetting":"25fr"}},{"columnMatch":"AffectedResources","formatter":0,"formatOptions":{"customColumnWidthSetting":"13fr"}},{"columnMatch":"AffectedInstances","formatter":0,"formatOptions":{"customColumnWidthSetting":"13fr"}},{"columnMatch":"MultiZoneModels","formatter":5},{"columnMatch":"UnknownInstanceResources","formatter":5}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"SourceSubscriptionId","label":"Subscription"},{"columnId":"SourceRegion","label":"Region"},{"columnId":"SourceZone","label":"Zone / regional"},{"columnId":"SelectedTargetSku","label":"Target SKU"},{"columnId":"AffectedResources","label":"Resources"},{"columnId":"AffectedInstances","label":"Instances (blank = unknown)"}]},"showExportToExcel":true,"exportToExcelOptions":"all","exportedParameters":[{"fieldName":"SourceSubscriptionId","parameterName":"LiveSubscription","parameterType":1},{"fieldName":"SourceRegion","parameterName":"LiveRegion","parameterType":1},{"fieldName":"SelectedTargetSku","parameterName":"LiveTarget","parameterType":1},{"fieldName":"SourceZone","parameterName":"LiveZone","parameterType":1}]},"name":"eligibility-sources","customWidth":"100"},{"type":1,"content":{"json":"Current selection: target **{LiveTarget}**, subscription **{LiveSubscription}**, region **{LiveRegion}**, zone / regional **{LiveZone}**."},"name":"eligibility-selection","styleSettings":{"margin":"0","padding":"0"}},{"type":12,"name":"eligibility-result","conditionalVisibility":{"parameterName":"LiveTarget","comparison":"isNotEqualTo","value":""},"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":3,"name":"eligibility-live","conditionalVisibility":{"parameterName":"LiveEvidence","comparison":"isEqualTo","value":"raw"},"content":{"version":"KqlItem/1.0","queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GETARRAY\",\"data\":null,\"headers\":[],\"path\":\"/subscriptions/{LiveSubscription}/providers/Microsoft.Compute/skus?api-version=2021-07-01&$filter=location eq '{LiveRegion}'\",\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$[?(@.resourceType=='virtualMachines' && @.name=='{LiveTarget}')]\",\"columns\":[{\"path\":\"$\",\"columnid\":\"SkuRecord\"},{\"path\":\"$.name\",\"columnid\":\"Target\"},{\"path\":\"$.family\",\"columnid\":\"Family\"},{\"path\":\"$.locations\",\"columnid\":\"Locations\"},{\"path\":\"$.locationInfo\",\"columnid\":\"LocationAndZones\"},{\"path\":\"$.restrictions\",\"columnid\":\"Restrictions\"},{\"path\":\"$.capabilities\",\"columnid\":\"Capabilities\"}]}}]}","title":"Advanced: raw Compute SKU evidence","size":1,"visualization":"table","showExportToExcel":true,"noDataMessage":"Unknown: no matching target SKU returned. Check selection, API permissions and region.","gridSettings":{"formatters":[{"columnMatch":"Target","formatter":0,"formatOptions":{"customColumnWidthSetting":"24fr"}},{"columnMatch":"Restrictions","formatter":0,"formatOptions":{"customColumnWidthSetting":"80fr"}},{"columnMatch":"SkuRecord","formatter":5}],"rowLimit":100,"filter":true}},"customWidth":"100"},{"type":9,"name":"eligibility-record-parameter","content":{"version":"KqlParameterItem/1.0","style":"pills","parameters":[{"version":"KqlParameterItem/1.0","name":"LiveSkuRecord","type":1,"isHiddenWhenLocked":true,"value":"","queryType":7,"query":"{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e0dc6ed2-412d-49ca-8259-335a03ce4188\",\"mergeType\":\"table\",\"leftTable\":\"eligibility-live\"}],\"projectRename\":[{\"originalName\":\"[eligibility-live].SkuRecord\",\"mergedName\":\"SkuRecord\",\"fromId\":\"e0dc6ed2-412d-49ca-8259-335a03ce4188\"}]}"}]}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| take 1\n| project SkuJson = tostring(dynamic({LiveSkuRecord:json})),\n          CheckedSubscription = '{LiveSubscription}', CheckedRegion = tolower('{LiveRegion}'),\n          CheckedZone = '{LiveZone}', CheckedTarget = '{LiveTarget}'\n| extend Sku = parse_json(SkuJson)\n| extend LocationRows = iff(array_length(Sku.locationInfo) > 0, Sku.locationInfo, dynamic([{}]))\n| mv-expand LocationRow = LocationRows limit 2000\n| summarize AdvertisedZoneEntries = countif(\n        tostring(LocationRow.location) =~ CheckedRegion and\n        array_index_of(LocationRow.zones, CheckedZone) >= 0)\n    by SkuJson, CheckedSubscription, CheckedRegion, CheckedZone, CheckedTarget\n| extend Sku = parse_json(SkuJson), RegionalPlacement = CheckedZone =~ 'Regional'\n| extend RecordMatches = tostring(Sku.name) =~ CheckedTarget and isnotempty(CheckedTarget)\n                            and tostring(Sku.resourceType) =~ 'virtualMachines'\n                            and isnotempty(CheckedSubscription) and isnotempty(CheckedRegion)\n                            and isnotempty(CheckedZone),\n         RegionAdvertised = coalesce(array_index_of(parse_json(tolower(tostring(Sku.locations))), CheckedRegion) >= 0, false),\n         RestrictionsKnown = isnotnull(array_length(Sku.restrictions)) and array_length(Sku.restrictions) <= 2000,\n         HasRestrictions = coalesce(array_length(Sku.restrictions) > 0, false)\n| extend RestrictionRows = iff(HasRestrictions, Sku.restrictions, dynamic([{}]))\n| mv-expand Restriction = RestrictionRows limit 2000\n| extend RestrictionType = tostring(Restriction.type),\n         InfoLocations = parse_json(tolower(tostring(Restriction.restrictionInfo.locations))),\n         ValueLocations = parse_json(tolower(tostring(Restriction['values'])))\n| extend ScopeLocations = iff(array_length(InfoLocations) > 0, InfoLocations,\n                              iff(RestrictionType =~ 'Location', ValueLocations, dynamic(null)))\n| extend ScopeKnown = coalesce(array_length(ScopeLocations) > 0, false),\n         ScopeMatches = coalesce(array_index_of(ScopeLocations, CheckedRegion) >= 0, false),\n         MalformedLocationScope = RestrictionType =~ 'Location' and (\n             (isnotempty(tostring(Restriction.restrictionInfo.locations)) and isnull(array_length(InfoLocations))) or\n             (isnotempty(tostring(Restriction['values'])) and isnull(array_length(ValueLocations)))),\n         ConflictingLocations = coalesce(RestrictionType =~ 'Location' and array_length(InfoLocations) > 0\n             and array_length(ValueLocations) > 0\n             and ((array_index_of(InfoLocations, CheckedRegion) >= 0) !=\n                  (array_index_of(ValueLocations, CheckedRegion) >= 0)), false),\n         ZonesKnown = coalesce(array_length(Restriction.restrictionInfo.zones) > 0, false),\n         ZoneMatches = coalesce(array_index_of(Restriction.restrictionInfo.zones, CheckedZone) >= 0, false)\n| extend RegionBlocked = HasRestrictions and RestrictionType =~ 'Location'\n                            and ScopeKnown and ScopeMatches and not(ConflictingLocations) and not(MalformedLocationScope),\n         ZoneBlocked = HasRestrictions and RestrictionType =~ 'Zone' and not(RegionalPlacement)\n                            and ScopeKnown and ScopeMatches and ZonesKnown and ZoneMatches,\n         UncertainRestriction = HasRestrictions and (\n             RestrictionType !in~ ('Location', 'Zone') or\n             (RestrictionType =~ 'Location' and (not(ScopeKnown) or ConflictingLocations or MalformedLocationScope)) or\n             (RestrictionType =~ 'Zone' and not(RegionalPlacement) and\n                 (not(ScopeKnown) or (ScopeMatches and not(ZonesKnown)))))\n| summarize RegionalBlocks = countif(RegionBlocked), ZonalBlocks = countif(ZoneBlocked),\n            UncertainRestrictions = countif(UncertainRestriction),\n            QuotaBlocks = countif((RegionBlocked or ZoneBlocked) and tostring(Restriction.reasonCode) =~ 'QuotaId')\n    by CheckedSubscription, CheckedRegion, CheckedZone, CheckedTarget,\n       RecordMatches, RegionAdvertised, RestrictionsKnown, AdvertisedZoneEntries, RegionalPlacement\n| extend AccessStatus = case(\n        not(RecordMatches), 'Unknown',\n        RegionalBlocks > 0 or ZonalBlocks > 0, 'Restricted',\n        not(RestrictionsKnown) or UncertainRestrictions > 0 or not(RegionAdvertised)\n            or (not(RegionalPlacement) and AdvertisedZoneEntries == 0), 'Unknown',\n        'Not restricted')\n| extend Reason = case(\n        not(RecordMatches), 'The current SKU check did not return a matching record. No access decision is available.',\n        RegionalBlocks > 0, 'This subscription has an access restriction for the selected SKU in this region.',\n        ZonalBlocks > 0, 'This subscription has an access restriction for the selected SKU in this zone.',\n        not(RestrictionsKnown) or UncertainRestrictions > 0, 'Restriction information is missing or cannot be safely interpreted.',\n        not(RegionAdvertised), 'The selected region is not advertised by this SKU record; access cannot be confirmed.',\n        not(RegionalPlacement) and AdvertisedZoneEntries == 0, 'The selected zone is not advertised by this SKU record; access cannot be confirmed.',\n        'No applicable region or zone access restriction was returned.')\n| extend NextStep = case(\n        AccessStatus == 'Restricted' and QuotaBlocks > 0, 'Request a quota increase for this SKU/family and region; see Plan > Capacity & quota.',\n        AccessStatus == 'Restricted', 'Open a region/zone access support request for this subscription, target SKU and placement.',\n        AccessStatus == 'Not restricted', 'No access ticket indicated. Continue with quota, policy and migration checks.',\n        'Retry the check and verify permissions/placement. If unresolved, contact Azure support; do not treat this as clear.'),\n         Help = iff(AccessStatus == 'Restricted', 'Open support request',\n                    iff(AccessStatus == 'Unknown', 'Troubleshooting', '')),\n         HelpUrl = case(AccessStatus == 'Restricted',\n             'https://portal.azure.com/#view/Microsoft_Azure_Support/HelpAndSupportBlade/~/overview',\n             AccessStatus == 'Unknown', 'https://learn.microsoft.com/azure/azure-resource-manager/troubleshooting/error-sku-not-available',\n             '')\n| project AccessStatus, Reason, NextStep, Help, HelpUrl,\n          CheckedSubscription, CheckedRegion, CheckedZone, CheckedTarget","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"Unknown: the live access check did not return a result. Retry and check permissions; this is not a green result.","title":"Does this subscription need SKU region/zone access?","gridSettings":{"formatters":[{"columnMatch":"AccessStatus","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":"==","thresholdValue":"Restricted","representation":"red","text":"{0}{1}"},{"operator":"==","thresholdValue":"Not restricted","representation":"green","text":"{0}{1}"},{"operator":"==","thresholdValue":"Unknown","representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"orange","text":"Unknown"}],"customColumnWidthSetting":"15fr"}},{"columnMatch":"Reason","formatter":0,"formatOptions":{"customColumnWidthSetting":"30fr"}},{"columnMatch":"NextStep","formatter":0,"formatOptions":{"customColumnWidthSetting":"40fr"}},{"columnMatch":"Help","formatter":1,"formatOptions":{"linkTarget":"Url","linkColumn":"HelpUrl","customColumnWidthSetting":"15fr"}},{"columnMatch":"HelpUrl","formatter":5},{"columnMatch":"CheckedSubscription","formatter":5},{"columnMatch":"CheckedRegion","formatter":5},{"columnMatch":"CheckedZone","formatter":5},{"columnMatch":"CheckedTarget","formatter":5}],"rowLimit":100,"labelSettings":[{"columnId":"AccessStatus","label":"SKU access"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"eligibility-status","customWidth":"100"},{"type":12,"name":"eligibility-capabilities","conditionalVisibility":{"parameterName":"LiveEvidence","comparison":"isEqualTo","value":"capabilities"},"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Per-resource target capability details\n\nAttached/model counts are not guest measurements; VMSS instance visibility stays Unknown. Disk totals require complete indexed disk evidence: **ceilings, not observed demand**. Cached/uncached limits are **not additive**. Quota uses `vCPUs`, not constrained `vCPUsAvailable`; CPU architecture is not manufacturer. Blank means Unknown. Select **Details** for limits and placement evidence. Count checks do not approve performance, zone/PPG/host/reservation placement or application readiness."},"name":"eligibility-fit-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets',\n    'microsoft.network/networkinterfaces', 'microsoft.compute/disks',\n    'microsoft.compute/virtualmachines/extensions', 'microsoft.sqlvirtualmachine/sqlvirtualmachines')\n| extend IsVmss = type =~ 'microsoft.compute/virtualmachinescalesets',\n         IsCompute = type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets'),\n         IsNic = type =~ 'microsoft.network/networkinterfaces', IsDisk = type =~ 'microsoft.compute/disks',\n         IsRegistration = type =~ 'microsoft.sqlvirtualmachine/sqlvirtualmachines',\n         IsExtension = type =~ 'microsoft.compute/virtualmachines/extensions'\n| extend IsSqlExtension = IsExtension and tostring(properties.publisher) =~ 'Microsoft.SqlServer.Management'\n            and (tostring(properties.type) =~ 'SqlIaaSAgent' or tostring(properties.typePropertiesType) =~ 'SqlIaaSAgent'),\n         IsAdeExtension = IsExtension and tostring(properties.publisher) in~ ('Microsoft.Azure.Security', 'Microsoft.Azure.Security.Edp')\n            and tostring(properties.type) in~ ('AzureDiskEncryption', 'AzureDiskEncryptionForLinux'),\n         IsSapExtension = IsExtension and tostring(properties.publisher) in~ ('Microsoft.AzureCAT.AzureEnhancedMonitoring', 'Microsoft.OSTCExtensions')\n            and tostring(properties.type) in~ ('MonitorX64Windows', 'MonitorX64Linux', 'AzureEnhancedMonitorForLinux', 'AzureCATExtensionHandler')\n| extend ComputeProfile = iff(IsVmss, properties.virtualMachineProfile, properties)\n| extend Keys = case(IsCompute, array_concat(pack_array(id),\n            coalesce(ComputeProfile.storageProfile.dataDisks, dynamic([])),\n            pack_array(tostring(ComputeProfile.storageProfile.osDisk.managedDisk.id))),\n        IsNic, pack_array(tostring(properties.virtualMachine.id)),\n        IsRegistration, pack_array(tostring(properties.virtualMachineResourceId)),\n        IsExtension, pack_array(tostring(split(tolower(id), '/extensions/')[0])),\n        IsDisk, pack_array(id), dynamic([]))\n| mv-expand Key = Keys limit 2000\n| extend VmId = tolower(iff(isnotempty(tostring(Key.managedDisk.id)), tostring(Key.managedDisk.id), tostring(Key)))\n| where isnotempty(VmId)\n| extend IsSelf = IsCompute and tolower(id) == VmId\n| summarize ComputeRows = countif(IsSelf),\n        VM = take_anyif(pack('id', id, 'type', type, 'name', name, 'resourceGroup', resourceGroup, 'subscriptionId', subscriptionId,\n            'location', location, 'properties', properties, 'sku', sku, 'tags', tags,\n            'identity', identity, 'plan', plan, 'managedBy', managedBy, 'zones', zones), IsSelf),\n        AttachedVmIds = make_set_if(tolower(id), IsCompute and not(IsSelf), 2000),\n        NicRows = countif(IsNic), AcceleratedNicRows = countif(IsNic and tobool(properties.enableAcceleratedNetworking) == true),\n        NicFlagRows = countif(IsNic and isnotnull(tobool(properties.enableAcceleratedNetworking))),\n        DiskRows = countif(IsDisk), SharedDiskRows = countif(IsDisk and toint(properties.maxShares) > 1),\n        AdeDiskRows = countif(IsDisk and tobool(properties.encryptionSettingsCollection.enabled) == true),\n        DiskIops = sumif(tolong(properties.diskIOPSReadWrite), IsDisk),\n        DiskMBps = sumif(toreal(properties.diskMBpsReadWrite), IsDisk),\n        DiskIopsKnown = countif(IsDisk and isnotnull(tolong(properties.diskIOPSReadWrite))),\n        DiskMBpsKnown = countif(IsDisk and isnotnull(toreal(properties.diskMBpsReadWrite))),\n        AdeExtensionRows = countif(IsAdeExtension), SapExtensionRows = countif(IsSapExtension),\n        SqlExtensionRows = countif(IsSqlExtension), SqlRegistrationRows = countif(IsRegistration),\n        SqlGroupIds = make_set_if(tostring(properties.sqlVirtualMachineGroupResourceId), IsRegistration, 20)\n    by VmId\n| extend ComputeKeys = iff(ComputeRows > 0, pack_array(VmId), AttachedVmIds)\n| mv-expand ComputeKey = ComputeKeys limit 2000\n| summarize VM = take_anyif(VM, ComputeRows > 0), ComputeRows = sum(ComputeRows),\n        NicRows = sum(NicRows), AcceleratedNicRows = sum(AcceleratedNicRows), NicFlagRows = sum(NicFlagRows),\n        DiskRows = sum(DiskRows), SharedDiskRows = sum(SharedDiskRows), AdeExtensionRows = sum(AdeExtensionRows),\n        AdeDiskRows = sum(AdeDiskRows), DiskIops = sum(DiskIops), DiskMBps = sum(DiskMBps),\n        DiskIopsKnown = sum(DiskIopsKnown), DiskMBpsKnown = sum(DiskMBpsKnown),\n        SapExtensionRows = sum(SapExtensionRows), SqlExtensionRows = sum(SqlExtensionRows),\n        SqlRegistrationRows = sum(SqlRegistrationRows), SqlGroupIds = take_anyif(SqlGroupIds, ComputeRows > 0)\n    by VmId = tostring(ComputeKey)\n| where ComputeRows == 1\n| extend ResourceId = tostring(VM.id), Name = tostring(VM.name), ResourceGroup = tostring(VM.resourceGroup),\n         SubscriptionId = tostring(VM.subscriptionId), Region = tostring(VM.location),\n         IsVmss = tostring(VM.type) =~ 'microsoft.compute/virtualmachinescalesets',\n         Profile = iff(tostring(VM.type) =~ 'microsoft.compute/virtualmachinescalesets', VM.properties.virtualMachineProfile, VM.properties)\n| extend VmSize = iff(IsVmss, tostring(VM.sku.name), tostring(Profile.hardwareProfile.vmSize)),\n         RgId = tolower(strcat('/subscriptions/', SubscriptionId, '/resourceGroups/', ResourceGroup)),\n         ExpectedNics = array_length(Profile.networkProfile.networkInterfaces),\n         DataDiskCount = array_length(Profile.storageProfile.dataDisks),\n         ImagePublisher = tostring(Profile.storageProfile.imageReference.publisher),\n         ImageOffer = tostring(Profile.storageProfile.imageReference.offer), ImageSku = tostring(Profile.storageProfile.imageReference.sku),\n         GuestOsName = tostring(VM.properties.extended.instanceView.osName)\n| extend ExpectedDisks = coalesce(DataDiskCount, 0) + iff(isnotempty(tostring(Profile.storageProfile.osDisk.managedDisk.id)), 1, 0)\n| extend DiskVisibilityComplete = not(IsVmss) and isnotnull(DataDiskCount) and DiskRows == ExpectedDisks and ExpectedDisks > 0,\n         NicVisibilityComplete = not(IsVmss) and isnotnull(ExpectedNics) and NicRows == ExpectedNics,\n         PlacementEvidence = strcat('Zones: ', tostring(VM.zones),\n             '; Availability set: ', tostring(VM.properties.availabilitySet.id),\n             '; Dedicated Host: ', tostring(VM.properties.host.id),\n             '; Host group: ', tostring(VM.properties.hostGroup.id),\n             '; PPG: ', tostring(VM.properties.proximityPlacementGroup.id),\n             '; Capacity reservation: ', tostring(Profile.capacityReservation.capacityReservationGroup.id),\n             '; Empty/missing associations do not verify target placement'),\n         ApplianceEvidence = iff(ImagePublisher in~ ('fortinet', 'paloaltonetworks', 'cisco',\n             'checkpoint', 'barracudanetworks', 'f5-networks', 'sophos', 'netapp', 'veeam',\n             'cohesity', 'rubrik') or tostring(VM.plan.publisher) in~ ('fortinet', 'paloaltonetworks',\n             'cisco', 'checkpoint', 'barracudanetworks', 'f5-networks', 'sophos', 'netapp',\n             'veeam', 'cohesity', 'rubrik'), strcat('Suspected vendor appliance - image/plan publishers: ',\n             ImagePublisher, '/', tostring(VM.plan.publisher),\n             '; verify exact product/version and target/NIC/driver/HA certification'),\n             'Unknown - image/plan and application owner review required; Marketplace alone is not an appliance signal')\n| extend ProvisionedDiskIops = iff(DiskVisibilityComplete and DiskIopsKnown == ExpectedDisks, DiskIops, tolong('')),\n         ProvisionedDiskMBps = iff(DiskVisibilityComplete and DiskMBpsKnown == ExpectedDisks, DiskMBps, toreal(''))\n| extend AcceleratedNetworking = case(IsVmss, 'Review scale-set NIC configurations',\n            isnull(ExpectedNics) or NicRows != ExpectedNics or NicFlagRows != NicRows, 'Unknown - incomplete NIC evidence',\n            strcat(AcceleratedNicRows, ' of ', ExpectedNics, ' NICs enabled')),\n         SharedDiskEvidence = case(SharedDiskRows > 0, 'Detected - review clustering and migration sequencing',\n            IsVmss or DiskRows != ExpectedDisks or ExpectedDisks == 0, 'Unknown - incomplete attached-disk evidence',\n            'No sharing-enabled attached disks observed'),\n         EphemeralOsDisk = case(tostring(Profile.storageProfile.osDisk.diffDiskSettings.option) =~ 'Local', 'Configured - rebuild/persistence review',\n            isempty(tostring(Profile.storageProfile.osDisk)), 'Unknown', 'Not configured in indexed model'),\n         UnmanagedDiskEvidence = iff(isnotempty(tostring(Profile.storageProfile.osDisk.vhd.uri)) or tostring(Profile.storageProfile.dataDisks) contains 'vhd',\n            'Detected - managed-disk migration review', 'No unmanaged disk reference observed'),\n         Hibernation = case(tobool(VM.properties.additionalCapabilities.hibernationEnabled) == true, 'Enabled - target support review',\n            isnull(VM.properties.additionalCapabilities.hibernationEnabled), 'Unknown - not recorded', 'Disabled in indexed model'),\n         SecurityType = iff(isempty(tostring(Profile.securityProfile.securityType)), 'Not recorded - verify effective security type', tostring(Profile.securityProfile.securityType)),\n         SystemAssignedIdentity = iff(tostring(VM.identity.type) contains 'SystemAssigned', 'Present - preserve/re-authorize if rebuilding', 'No system-assigned identity recorded'),\n         MarketplacePlan = strcat(tostring(VM.plan.publisher), ' / ', tostring(VM.plan.product)),\n         AdeEvidence = case(AdeExtensionRows > 0, 'Extension observed - guest encryption state unverified',\n             AdeDiskRows > 0, 'Attached-disk ADE configuration observed - confirm OS/data and guest state',\n             'Guest encryption state unverified'),\n         InventoryRole = case(IsVmss, 'Scale-set model', isnotempty(tostring(Profile.virtualMachineScaleSet.id)), 'Flexible member detail - do not add to model capacity', 'Standalone VM')\n| join kind=leftouter (\n    resources\n    | where type in~ ('microsoft.containerservice/managedclusters', 'microsoft.databricks/workspaces',\n        'microsoft.solutions/applications', 'microsoft.redhatopenshift/openshiftclusters')\n    | extend OwnerKind = case(type =~ 'microsoft.containerservice/managedclusters', 'AKS',\n             type =~ 'microsoft.databricks/workspaces', 'Databricks',\n             type =~ 'microsoft.redhatopenshift/openshiftclusters', 'ARO', 'Managed application')\n    | extend RgId = tolower(case(OwnerKind == 'AKS', strcat('/subscriptions/', subscriptionId, '/resourceGroups/', tostring(properties.nodeResourceGroup)),\n             OwnerKind == 'ARO', tostring(properties.clusterProfile.resourceGroupId), tostring(properties.managedResourceGroupId)))\n    | project RgId, OwnerKind, OwnerId = tolower(id)\n    | union (\n        resourcecontainers\n        | where type =~ 'microsoft.resources/subscriptions/resourcegroups' and isnotempty(tostring(managedBy))\n        | extend OwnerId = tolower(tostring(managedBy))\n        | project RgId = tolower(id), OwnerId, OwnerKind = case(\n            OwnerId contains '/microsoft.containerservice/managedclusters/', 'AKS',\n            OwnerId contains '/microsoft.databricks/workspaces/', 'Databricks',\n            OwnerId contains '/microsoft.batch/', 'Batch', 'Managed service')\n      )\n    | where isnotempty(RgId) and isnotempty(OwnerId)\n    | summarize OwnerIds = make_set(OwnerId, 20), OwnerKinds = make_set(OwnerKind, 20) by RgId\n  ) on RgId\n| join kind=leftouter (\n    desktopvirtualizationresources\n    | where type =~ 'microsoft.desktopvirtualization/hostpools/sessionhosts'\n    | extend VmId = tolower(tostring(properties.resourceId))\n    | where isnotempty(VmId)\n    | summarize AvdHostPoolIds = make_set(tostring(split(tolower(id), '/sessionhosts/')[0]), 20) by VmId\n  ) on VmId\n| extend Workload = trim('; ', strcat(\n        iff(array_length(OwnerKinds) > 0, strcat(strcat_array(OwnerKinds, '; '), '; '), ''),\n        iff(isnotempty(tostring(VM.managedBy)) and coalesce(array_length(OwnerKinds), 0) == 0, 'Managed service (compute managedBy); ', ''),\n        iff(array_length(AvdHostPoolIds) > 0, 'AVD; ', ''),\n        iff(SqlExtensionRows > 0 or SqlRegistrationRows > 0, 'SQL; ', ''),\n        iff(SapExtensionRows > 0 or tostring(Profile.licenseType) contains 'SLES_SAP' or ImageOffer contains 'sap', 'SAP signal; ', '')))\n| extend Workload = iff(isempty(Workload), 'Unclassified - guest/workload assessment required', Workload),\n         AssociationEvidence = strcat('Compute managedBy: ', tostring(VM.managedBy), '; Managed owners: ', tostring(OwnerIds), '; AVD host pools: ', tostring(AvdHostPoolIds),\n            '; SQL extensions/registrations: ', SqlExtensionRows, '/', SqlRegistrationRows, '; SAP extensions: ', SapExtensionRows),\n         MigrationMethod = case(array_length(OwnerIds) > 1, 'Multiple owner associations - resolve ownership before changes',\n            tostring(OwnerKinds) contains 'AKS', 'AKS node-pool workflow; validate surge, PDBs, persistence and capacity',\n            tostring(OwnerKinds) contains 'Databricks', 'Databricks-supported node type/runtime and cluster restart/recreation',\n            array_length(AvdHostPoolIds) > 0, 'AVD host replacement; check pooled/personal type, sessions, profiles and persistence',\n            tostring(OwnerKinds) contains 'Batch', 'Batch pool replacement; drain tasks and review autoscale/quotas',\n            array_length(OwnerKinds) > 0 or isnotempty(tostring(VM.managedBy)), 'Use owning service/vendor migration workflow; do not directly resize managed compute',\n            SqlExtensionRows > 0 or SqlRegistrationRows > 0 or Workload contains 'SAP', 'Stateful/vendor assessment before resize or rebuild; validate HA, licensing, backup and rollback',\n            'Determine application owner/state; then validate resize versus rebuild and rollback'),\n         MigrationApproval = 'Not assessed - application, HA, backup and rollback require evidence'\n\n| extend OsHintSource = iff(isnotempty(GuestOsName), 'Guest OS metadata', 'Image hint only - current guest unverified'),\n         OsHintText = tolower(iff(isnotempty(GuestOsName), GuestOsName, strcat(ImagePublisher, ' ', ImageOffer, ' ', ImageSku)))\n| extend NvmeOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2019|2022|2025)($|[^0-9])', 'Listed OS family - validate image, generation and boot',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(18[._-]04|20[._-]04|22[._-]04|24[._-]04)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        OsHintText matches regex @'debian[^0-9]{0,30}(11|12)($|[^0-9])', 'Listed OS family - validate image, kernel and boot',\n        'Review official NVMe OS list - not classified by captured subset'),\n         ManaOsHint = case(\n        isempty(trim(' ', OsHintText)), 'Unknown - OS metadata missing',\n        OsHintText matches regex @'windows.?server[^0-9]{0,30}(2016|2019|2022|2025)($|[^0-9])', 'Listed OS family - install/verify current MANA driver',\n        OsHintText matches regex @'ubuntu[^0-9]{0,30}(22[._-]04|24[._-]04|26[._-]04)($|[^0-9])', 'Listed OS family - verify minimum kernel and MANA driver',\n        'Review official MANA OS/kernel list - not classified by captured subset')\n| extend NvmeDriverValidation = 'Unknown - guest driver and target boot not tested',\n         ManaDriverValidation = 'Unknown - target hardware, driver and traffic not tested',\n         NvmeOsReference = 'https://learn.microsoft.com/azure/virtual-machines/enable-nvme-interface',\n         ManaOsReference = 'https://learn.microsoft.com/azure/virtual-network/accelerated-networking-overview',\n         OsReferenceChecked = '2026-11-18'\n| extend CatalogueRecord = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| extend CatalogueCoverage = iff(isempty(CatalogueRecord), 'Not assessed - SKU absent from captured catalogue', tostring(split(CatalogueRecord, '|')[0]))\n\n| project Name, ResourceGroup, SubscriptionId, Region, VmSize, CatalogueCoverage, Workload, MigrationMethod,\n    AcceleratedNetworking, ExpectedNics, DataDiskCount, SharedDiskEvidence, EphemeralOsDisk,\n    UnmanagedDiskEvidence, Hibernation, SecurityType, SystemAssignedIdentity, MarketplacePlan, AdeEvidence,\n    AdeDiskRows, ApplianceEvidence, PlacementEvidence, DiskVisibilityComplete, NicVisibilityComplete,\n    ProvisionedDiskIops, ProvisionedDiskMBps,\n    OsHintSource, NvmeOsHint, ManaOsHint, NvmeDriverValidation, ManaDriverValidation,\n    OsReferenceChecked, NvmeOsReference, ManaOsReference, AssociationEvidence, OwnerIds, AvdHostPoolIds,\n    SqlGroupIds, MigrationApproval, InventoryRole, ResourceId\n| order by Workload asc, Name asc\n| where SubscriptionId =~ '{LiveSubscription}' and Region =~ '{LiveRegion}'\n| extend SelectedPath = case('{EligibilityGeneration}' == '5', parse_json('{V5PathSkuMap}')[VmSize],\n        '{EligibilityGeneration}' == '6', parse_json('{V6PathSkuMap}')[VmSize],\n        parse_json('{V7PathSkuMap}')[VmSize])\n| where tostring(split(tostring(SelectedPath), '|')[3]) =~ '{LiveTarget}' and isnotempty('{LiveTarget}')\n| extend Sku = dynamic({LiveSkuRecord:json})\n| extend RecordMatches = tostring(Sku.name) =~ '{LiveTarget}' and tostring(Sku.resourceType) =~ 'virtualMachines',\n         CapabilityRows = iff(array_length(Sku.capabilities) > 0 and array_length(Sku.capabilities) <= 2000,\n             Sku.capabilities, dynamic([{}]))\n| mv-expand Capability = CapabilityRows limit 2000\n| summarize Caps = make_bag(pack(tostring(Capability.name), tostring(Capability.value))),\n         DiskLimitRecords = countif(tostring(Capability.name) == 'MaxDataDiskCount'),\n         NicLimitRecords = countif(tostring(Capability.name) == 'MaxNetworkInterfaces'),\n         Context = take_any(pack('Name', Name, 'Source', VmSize, 'IsVmss', InventoryRole == 'Scale-set model',\n             'DataDisks', DataDiskCount, 'Nics', ExpectedNics, 'DiskVisibilityComplete', DiskVisibilityComplete,\n             'NicVisibilityComplete', NicVisibilityComplete, 'ProvisionedDiskIops', ProvisionedDiskIops,\n             'ProvisionedDiskMBps', ProvisionedDiskMBps, 'Placement', PlacementEvidence,\n             'RecordMatches', RecordMatches))\n    by ResourceId\n| extend DataDisks = toint(Context.DataDisks), Nics = toint(Context.Nics),\n         MaxDataDisks = iff(tobool(Context.RecordMatches) and DiskLimitRecords == 1, toint(Caps.MaxDataDiskCount), toint('')),\n         MaxNics = iff(tobool(Context.RecordMatches) and NicLimitRecords == 1, toint(Caps.MaxNetworkInterfaces), toint(''))\n| extend DiskCountCheck = case(isnull(MaxDataDisks) or MaxDataDisks < 0 or isnull(DataDisks)\n             or not(tobool(Context.DiskVisibilityComplete)) or tobool(Context.IsVmss), 'Unknown',\n             DataDisks > MaxDataDisks, 'Not met', 'Met - count only'),\n         NicCountCheck = case(isnull(MaxNics) or MaxNics < 1 or isnull(Nics)\n             or not(tobool(Context.NicVisibilityComplete)) or tobool(Context.IsVmss), 'Unknown',\n             Nics > MaxNics, 'Not met', 'Met - count only')\n| project Resource = tostring(Context.Name), Source = tostring(Context.Source), Target = '{LiveTarget}',\n          DataDisks, MaxDataDisks, DiskCountCheck, Nics, MaxNics, NicCountCheck,\n          QuotaVcpus = iff(tobool(Context.RecordMatches), toint(Caps.vCPUs), toint('')),\n          EffectiveVcpus = iff(tobool(Context.RecordMatches), toint(Caps.vCPUsAvailable), toint('')),\n          CpuArchitecture = iff(tobool(Context.RecordMatches), tostring(Caps.CpuArchitectureType), ''),\n          CpuVendor = iff(tobool(Context.RecordMatches), tostring(Caps.CpuManufacturer), ''),\n          ProvisionedDiskIops = tolong(Context.ProvisionedDiskIops),\n          ProvisionedDiskMBps = toreal(Context.ProvisionedDiskMBps),\n          TargetUncachedIops = iff(tobool(Context.RecordMatches), tolong(Caps.UncachedDiskIOPS), tolong('')),\n          TargetUncachedMBps = iff(tobool(Context.RecordMatches), toreal(Caps.UncachedDiskBytesPerSecond) / 1000000.0, toreal('')),\n          TargetCachedIops = iff(tobool(Context.RecordMatches), tolong(Caps.CachedDiskIOPS), tolong('')),\n          TargetCachedMBps = iff(tobool(Context.RecordMatches), toreal(Caps.CachedDiskBytesPerSecond) / 1000000.0, toreal('')),\n          Placement = tostring(Context.Placement), PerformanceCheck = 'Unknown - validate workload demand and cache paths',\n          CheckedAt = now()\n| order by Resource asc\n| extend Details = 'Details'","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Resource counts versus live target limits - select Details for capability evidence","gridSettings":{"formatters":[{"columnMatch":"Resource","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"DataDisks","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"MaxDataDisks","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"DiskCountCheck","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Nics","formatter":0,"formatOptions":{"customColumnWidthSetting":"8fr"}},{"columnMatch":"MaxNics","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"NicCountCheck","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Details","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"10fr"}},{"columnMatch":"Source","formatter":5},{"columnMatch":"Target","formatter":5},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"QuotaVcpus","formatter":5},{"columnMatch":"EffectiveVcpus","formatter":5},{"columnMatch":"CpuArchitecture","formatter":5},{"columnMatch":"CpuVendor","formatter":5},{"columnMatch":"ProvisionedDiskIops","formatter":5},{"columnMatch":"ProvisionedDiskMBps","formatter":5},{"columnMatch":"TargetUncachedIops","formatter":5},{"columnMatch":"TargetUncachedMBps","formatter":5},{"columnMatch":"TargetCachedIops","formatter":5},{"columnMatch":"TargetCachedMBps","formatter":5},{"columnMatch":"Placement","formatter":5},{"columnMatch":"PerformanceCheck","formatter":5},{"columnMatch":"CheckedAt","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"eligibility-fit","customWidth":"100"}]}}]}}]},"conditionalVisibility":{"parameterName":"PlanView","comparison":"isEqualTo","value":"availability"},"name":"grp-availability"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Capacity & quota\n\nRetirement/EOL migration quota estimates.\n\n**Current cores** = source quota-vCPUs, including deallocated inventory; **Target cores** = target quota-vCPUs; **Delta** = target minus current, not the quota request.\n\n**In-place (default):** resize existing VMs. Regional quota models positive core growth; a different target family still needs full target-family cores. Unverified sources get no core credit; this model does not confirm that resizing is supported.\n\n**Side-by-side:** deploy replacements while keeping sources allocated; quota must cover both fleets.\n\n**Conservative:** full target cores for deallocated/unknown sources. **Red:** insufficient quota. **Amber:** missing quota/target data. **Green:** quota only, not physical capacity or migration approval. Missing targets stay Unknown; spare quota elsewhere cannot cancel a shortfall.\n\nIndependent of Live target availability. **Show detail** opens breakdowns, shortfalls, groups or the key."},"name":"quota-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":9,"name":"quota-parameters","content":{"version":"KqlParameterItem/1.0","style":"pills","parameters":[{"name":"QuotaScope","type":2,"isRequired":true,"label":"Planning scope","jsonData":"[{\"value\":\"selected\",\"label\":\"Selected subscriptions\"},{\"value\":\"tenant\",\"label\":\"Tenant - all readable subscriptions\"}]","value":"selected","version":"KqlParameterItem/1.0"},{"name":"QuotaMigrationMode","type":2,"isRequired":true,"label":"Migration approach","jsonData":"[{\"value\":\"sidebyside\",\"label\":\"Side-by-side (keep sources)\"},{\"value\":\"inplace\",\"label\":\"In-place (conservative if needed)\"}]","value":"inplace","version":"KqlParameterItem/1.0"},{"name":"QuotaDetails","type":2,"isRequired":true,"label":"Show detail","jsonData":"[{\"value\":\"none\",\"label\":\"Summary only\"},{\"value\":\"migration\",\"label\":\"Migration breakdown\"},{\"value\":\"checks\",\"label\":\"Quota checks and shortfalls\"},{\"value\":\"headroom\",\"label\":\"Tenant headroom / quota group discussion\"},{\"value\":\"groups\",\"label\":\"Live quota-group inspector\"},{\"value\":\"key\",\"label\":\"Column key & assumptions\"}]","value":"none","version":"KqlParameterItem/1.0"},{"name":"QuotaGeneration","type":2,"isRequired":true,"label":"Target scenario","jsonData":"[{\"value\":\"default\",\"label\":\"Default V5-first\"},{\"value\":\"5\",\"label\":\"V5 only\"},{\"value\":\"6\",\"label\":\"V6 only\"},{\"value\":\"7\",\"label\":\"V7 only\"}]","value":"default","version":"KqlParameterItem/1.0"},{"name":"QuotaAllSubscriptions","type":6,"isRequired":true,"multiSelect":true,"isHiddenWhenLocked":true,"quote":"'","delimiter":",","typeSettings":{"additionalResourceOptions":["value::all"],"includeAll":true,"showDefault":false},"value":["value::all"],"version":"KqlParameterItem/1.0"}]}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| extend QuotaPath = case('{QuotaGeneration}' == '5', parse_json('{V5PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '6', parse_json('{V6PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '7', parse_json('{V7PathSkuMap}')[VmSize], '')\n| extend RecommendedTarget = iff('{QuotaGeneration}' == 'default', RecommendedTarget,\n         tostring(split(tostring(QuotaPath), '|')[3]))\n| where '{QuotaScope}' == 'tenant' or SubscriptionId in~ ({Subscriptions})\n    or strcat('/subscriptions/', SubscriptionId) in~ ({Subscriptions})\n    or 'value::all' in~ ({Subscriptions})\n| extend SourceQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(VmSize)]),\n         TargetQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(RecommendedTarget)]),\n         SourceCores = tolong(parse_json('{QuotaCoreMap}')[tolower(VmSize)]) * tolong(Instances),\n         TargetCores = tolong(parse_json('{QuotaCoreMap}')[tolower(RecommendedTarget)]) * tolong(Instances)\n| extend SourceCredit = PowerState in~ ('running', 'stopped')\n        and isnotempty(SourceQuotaFamily) and isnotnull(SourceCores) and SourceCores >= 0,\n         Unresolved = isempty(TargetQuotaFamily) or isnull(TargetCores) or Instances < 0\n        or ComputePriority =~ 'Spot' or TargetCores < 0\n| extend RegionalIncrement = case(not(SourceCredit), TargetCores,\n        TargetCores > SourceCores, TargetCores - SourceCores, tolong(0))\n| extend FamilyIncrement = iff(SourceQuotaFamily == TargetQuotaFamily,\n        RegionalIncrement, TargetCores)\n| extend Metric = pack_array('cores', iff(isempty(TargetQuotaFamily), 'unknown', TargetQuotaFamily))\n| mv-expand Metric\n| extend Metric = tolower(tostring(Metric)),\n         InPlaceAdditional = iff(Metric == 'cores', RegionalIncrement, FamilyIncrement)\n| summarize CurrentCores = sum(SourceCores), TargetCores = sum(TargetCores),\n        CurrentUnknown = countif(isnull(SourceCores) or SourceCores < 0),\n        TargetUnknown = countif(isnull(TargetCores) or TargetCores < 0),\n        SideBySideAdditionalCores = sum(TargetCores),\n        InPlaceAdditionalCores = sum(InPlaceAdditional),\n        InPlaceUnverifiedResources = countif(not(SourceCredit)),\n        UnresolvedResources = countif(Unresolved) by SubscriptionId, Region, Metric\n| join kind=leftouter (\nQuotaResources\n| where type =~ 'microsoft.compute/locations/usages'\n| mv-expand Quota = properties.value limit 2000\n| project SubscriptionId = tolower(subscriptionId), Region = tolower(location),\n          Metric = tolower(tostring(Quota.name.value)),\n          QuotaLimit = tolong(Quota['limit']), QuotaUsage = tolong(Quota.currentValue)\n| summarize MetricRecords = count(), Limit = max(QuotaLimit), Usage = max(QuotaUsage)\n    by SubscriptionId, Region, Metric\n) on SubscriptionId, Region, Metric\n| extend Available = Limit - Usage,\n         QuotaUnknown = isnull(MetricRecords) or MetricRecords != 1\n             or isnull(Limit) or isnull(Usage) or Limit < 0 or Usage < 0 or UnresolvedResources > 0\n| extend SideBySideShortfall = iff(QuotaUnknown, tolong(''),\n             iff(SideBySideAdditionalCores > Limit - Usage, SideBySideAdditionalCores - (Limit - Usage), tolong(0))),\n         InPlaceShortfall = iff(QuotaUnknown, tolong(''),\n             iff(InPlaceAdditionalCores > Limit - Usage, InPlaceAdditionalCores - (Limit - Usage), tolong(0)))\n| extend SideBySideStatus = case(QuotaUnknown,\n            'Unknown - quota/metadata missing', SideBySideShortfall > 0, 'Not met - quota shortfall', 'Met - quota only'),\n         InPlaceStatus = case(QuotaUnknown,\n            'Unknown - quota/metadata missing',\n            InPlaceShortfall > 0, 'Not met - quota shortfall', 'Met - quota only')\n| extend AdditionalCores = iff('{QuotaMigrationMode}' == 'inplace', InPlaceAdditionalCores, SideBySideAdditionalCores),\n         Shortfall = iff('{QuotaMigrationMode}' == 'inplace', InPlaceShortfall, SideBySideShortfall),\n         SelectedStatus = iff('{QuotaMigrationMode}' == 'inplace', InPlaceStatus, SideBySideStatus)\n| extend Conservative = '{QuotaMigrationMode}' == 'inplace' and InPlaceUnverifiedResources > 0\n| extend QuotaStatus = case(SelectedStatus startswith 'Unknown', SelectedStatus,\n              Shortfall > 0 and Conservative, 'Insufficient quota (conservative)',\n              Shortfall > 0, 'Insufficient quota',\n              Conservative, 'Sufficient - conservative quota check', 'Sufficient - quota only'),\n         Delta = iff(CurrentUnknown > 0 or TargetUnknown > 0, tolong(''), TargetCores - CurrentCores),\n         CurrentCores = iff(CurrentUnknown > 0, tolong(''), CurrentCores),\n         TargetCores = iff(TargetUnknown > 0, tolong(''), TargetCores),\n         QuotaCheck = iff(Metric == 'cores', 'Regional total', Metric),\n         DemandEvaluatedAt = now()\n| project SubscriptionId, Region, Metric, Limit, Usage, Available,\n          CurrentCores, TargetCores, Delta, CurrentUnknown, TargetUnknown,\n          AdditionalCores, Shortfall, QuotaStatus, QuotaCheck,\n          SideBySideAdditionalCores, SideBySideShortfall, SideBySideStatus,\n          InPlaceAdditionalCores, InPlaceShortfall, InPlaceStatus, InPlaceUnverifiedResources, UnresolvedResources, DemandEvaluatedAt\n| order by SubscriptionId asc, Region asc, Metric asc\n| extend SummaryScopes = pack_array(SubscriptionId, '__total__')\n| mv-expand SummaryScopes\n| summarize CurrentCores = sumif(CurrentCores, Metric == 'cores'),\n        TargetCores = sumif(TargetCores, Metric == 'cores'),\n        CurrentUnknown = sumif(CurrentUnknown, Metric == 'cores'),\n        TargetUnknown = sumif(TargetUnknown, Metric == 'cores'),\n        FailedChecks = countif(QuotaStatus startswith 'Insufficient'),\n        UnknownChecks = countif(QuotaStatus startswith 'Unknown'),\n        ConservativeChecks = countif(QuotaStatus contains 'conservative')\n    by SubscriptionId = tostring(SummaryScopes)\n| join kind=leftouter (\n    ResourceContainers\n    | where type =~ 'microsoft.resources/subscriptions'\n    | project SubscriptionId = tolower(subscriptionId), SubscriptionName = name\n) on SubscriptionId\n| extend CurrentCores = iff(CurrentUnknown > 0, tolong(''), CurrentCores),\n         TargetCores = iff(TargetUnknown > 0, tolong(''), TargetCores),\n         TotalOrder = iff(SubscriptionId == '__total__', 0, 1),\n         Scope = iff(SubscriptionId == '__total__',\n             iff('{QuotaScope}' == 'tenant', 'TENANT TOTAL (readable subscriptions)', 'SELECTED SUBSCRIPTIONS TOTAL'),\n             coalesce(SubscriptionName, SubscriptionId)),\n         QuotaStatus = case(FailedChecks > 0 and UnknownChecks > 0, 'Insufficient quota / incomplete checks',\n             FailedChecks > 0, 'Insufficient quota', UnknownChecks > 0, 'Unknown - incomplete checks',\n             ConservativeChecks > 0, 'Sufficient - conservative quota check', 'Sufficient - quota only')\n| order by TotalOrder asc, Scope asc\n| project Scope, ['Current cores'] = CurrentCores, ['Target cores'] = TargetCores,\n          ['Delta (+/-)'] = TargetCores - CurrentCores, ['Quota status'] = QuotaStatus,\n          SubscriptionId, FailedChecks, UnknownChecks","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{QuotaAllSubscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Core migration plan: total and per subscription","gridSettings":{"formatters":[{"columnMatch":"Scope","formatter":0,"formatOptions":{"customColumnWidthSetting":"3fr"}},{"columnMatch":"Current cores","formatter":0,"formatOptions":{"customColumnWidthSetting":"2fr"}},{"columnMatch":"Target cores","formatter":0,"formatOptions":{"customColumnWidthSetting":"2fr"}},{"columnMatch":"Delta (+/-)","formatter":0,"formatOptions":{"customColumnWidthSetting":"2fr"}},{"columnMatch":"Quota status","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":"contains","thresholdValue":"Insufficient","representation":"red","text":"{0}{1}"},{"operator":"contains","thresholdValue":"Unknown","representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"green","text":"{0}{1}"}],"customColumnWidthSetting":"3fr"}},{"columnMatch":"SubscriptionId","formatter":5},{"columnMatch":"FailedChecks","formatter":5},{"columnMatch":"UnknownChecks","formatter":5}],"rowLimit":100},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"quota-summary","customWidth":"100"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| extend QuotaPath = case('{QuotaGeneration}' == '5', parse_json('{V5PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '6', parse_json('{V6PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '7', parse_json('{V7PathSkuMap}')[VmSize], '')\n| extend RecommendedTarget = iff('{QuotaGeneration}' == 'default', RecommendedTarget,\n         tostring(split(tostring(QuotaPath), '|')[3]))\n| where '{QuotaScope}' == 'tenant' or SubscriptionId in~ ({Subscriptions})\n    or strcat('/subscriptions/', SubscriptionId) in~ ({Subscriptions})\n    or 'value::all' in~ ({Subscriptions})\n| extend SourceQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(VmSize)]),\n         TargetQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(RecommendedTarget)]),\n         SourceCores = tolong(parse_json('{QuotaCoreMap}')[tolower(VmSize)]) * tolong(Instances),\n         TargetCores = tolong(parse_json('{QuotaCoreMap}')[tolower(RecommendedTarget)]) * tolong(Instances)\n| extend SourceCredit = PowerState in~ ('running', 'stopped')\n        and isnotempty(SourceQuotaFamily) and isnotnull(SourceCores) and SourceCores >= 0,\n         Unresolved = isempty(TargetQuotaFamily) or isnull(TargetCores) or Instances < 0\n        or ComputePriority =~ 'Spot' or TargetCores < 0\n| extend RegionalIncrement = case(not(SourceCredit), TargetCores,\n        TargetCores > SourceCores, TargetCores - SourceCores, tolong(0))\n| extend FamilyIncrement = iff(SourceQuotaFamily == TargetQuotaFamily,\n        RegionalIncrement, TargetCores)\n| summarize Resources = count(), Instances = sum(Instances),\n        CurrentCores = sum(SourceCores), SideBySideAdditionalCores = sum(TargetCores),\n        CurrentUnknown = countif(isnull(SourceCores) or SourceCores < 0),\n        TargetUnknown = countif(isnull(TargetCores) or TargetCores < 0),\n        InPlaceAdditionalFamilyCores = sum(FamilyIncrement),\n        InPlaceAdditionalRegionalCores = sum(RegionalIncrement),\n        UnresolvedResources = countif(Unresolved),\n        InPlaceUnverifiedResources = countif(not(SourceCredit)),\n        TargetSizes = strcat_array(make_set(RecommendedTarget, 100), ', ')\n    by SubscriptionId, Region, TargetQuotaFamily\n| extend TargetQuotaFamily = iff(isempty(TargetQuotaFamily), 'Unknown', TargetQuotaFamily),\n         TargetCores = iff(TargetUnknown > 0, tolong(''), SideBySideAdditionalCores),\n         CurrentCores = iff(CurrentUnknown > 0, tolong(''), CurrentCores),\n         EstimateStatus = iff(UnresolvedResources > 0, 'Unknown - incomplete metadata', 'Estimated - validate live quota')\n| extend Delta = TargetCores - CurrentCores\n| order by SubscriptionId asc, Region asc, TargetQuotaFamily asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{QuotaAllSubscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Migration breakdown: subscription, region and target family","gridSettings":{"formatters":[{"columnMatch":"SubscriptionId","formatter":0,"formatOptions":{"customColumnWidthSetting":"30fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"TargetQuotaFamily","formatter":0,"formatOptions":{"customColumnWidthSetting":"28fr"}},{"columnMatch":"CurrentCores","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"TargetCores","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"Delta","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"Resources","formatter":5},{"columnMatch":"Instances","formatter":5},{"columnMatch":"SideBySideAdditionalCores","formatter":5},{"columnMatch":"InPlaceAdditionalFamilyCores","formatter":5},{"columnMatch":"InPlaceAdditionalRegionalCores","formatter":5},{"columnMatch":"UnresolvedResources","formatter":5},{"columnMatch":"InPlaceUnverifiedResources","formatter":5},{"columnMatch":"TargetSizes","formatter":5},{"columnMatch":"EstimateStatus","formatter":5},{"columnMatch":"CurrentUnknown","formatter":5},{"columnMatch":"TargetUnknown","formatter":5}],"rowLimit":100},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"quota-demand","conditionalVisibility":{"parameterName":"QuotaDetails","comparison":"isEqualTo","value":"migration"},"customWidth":"100"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| extend QuotaPath = case('{QuotaGeneration}' == '5', parse_json('{V5PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '6', parse_json('{V6PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '7', parse_json('{V7PathSkuMap}')[VmSize], '')\n| extend RecommendedTarget = iff('{QuotaGeneration}' == 'default', RecommendedTarget,\n         tostring(split(tostring(QuotaPath), '|')[3]))\n| where '{QuotaScope}' == 'tenant' or SubscriptionId in~ ({Subscriptions})\n    or strcat('/subscriptions/', SubscriptionId) in~ ({Subscriptions})\n    or 'value::all' in~ ({Subscriptions})\n| extend SourceQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(VmSize)]),\n         TargetQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(RecommendedTarget)]),\n         SourceCores = tolong(parse_json('{QuotaCoreMap}')[tolower(VmSize)]) * tolong(Instances),\n         TargetCores = tolong(parse_json('{QuotaCoreMap}')[tolower(RecommendedTarget)]) * tolong(Instances)\n| extend SourceCredit = PowerState in~ ('running', 'stopped')\n        and isnotempty(SourceQuotaFamily) and isnotnull(SourceCores) and SourceCores >= 0,\n         Unresolved = isempty(TargetQuotaFamily) or isnull(TargetCores) or Instances < 0\n        or ComputePriority =~ 'Spot' or TargetCores < 0\n| extend RegionalIncrement = case(not(SourceCredit), TargetCores,\n        TargetCores > SourceCores, TargetCores - SourceCores, tolong(0))\n| extend FamilyIncrement = iff(SourceQuotaFamily == TargetQuotaFamily,\n        RegionalIncrement, TargetCores)\n| extend Metric = pack_array('cores', iff(isempty(TargetQuotaFamily), 'unknown', TargetQuotaFamily))\n| mv-expand Metric\n| extend Metric = tolower(tostring(Metric)),\n         InPlaceAdditional = iff(Metric == 'cores', RegionalIncrement, FamilyIncrement)\n| summarize CurrentCores = sum(SourceCores), TargetCores = sum(TargetCores),\n        CurrentUnknown = countif(isnull(SourceCores) or SourceCores < 0),\n        TargetUnknown = countif(isnull(TargetCores) or TargetCores < 0),\n        SideBySideAdditionalCores = sum(TargetCores),\n        InPlaceAdditionalCores = sum(InPlaceAdditional),\n        InPlaceUnverifiedResources = countif(not(SourceCredit)),\n        UnresolvedResources = countif(Unresolved) by SubscriptionId, Region, Metric\n| join kind=leftouter (\nQuotaResources\n| where type =~ 'microsoft.compute/locations/usages'\n| mv-expand Quota = properties.value limit 2000\n| project SubscriptionId = tolower(subscriptionId), Region = tolower(location),\n          Metric = tolower(tostring(Quota.name.value)),\n          QuotaLimit = tolong(Quota['limit']), QuotaUsage = tolong(Quota.currentValue)\n| summarize MetricRecords = count(), Limit = max(QuotaLimit), Usage = max(QuotaUsage)\n    by SubscriptionId, Region, Metric\n) on SubscriptionId, Region, Metric\n| extend Available = Limit - Usage,\n         QuotaUnknown = isnull(MetricRecords) or MetricRecords != 1\n             or isnull(Limit) or isnull(Usage) or Limit < 0 or Usage < 0 or UnresolvedResources > 0\n| extend SideBySideShortfall = iff(QuotaUnknown, tolong(''),\n             iff(SideBySideAdditionalCores > Limit - Usage, SideBySideAdditionalCores - (Limit - Usage), tolong(0))),\n         InPlaceShortfall = iff(QuotaUnknown, tolong(''),\n             iff(InPlaceAdditionalCores > Limit - Usage, InPlaceAdditionalCores - (Limit - Usage), tolong(0)))\n| extend SideBySideStatus = case(QuotaUnknown,\n            'Unknown - quota/metadata missing', SideBySideShortfall > 0, 'Not met - quota shortfall', 'Met - quota only'),\n         InPlaceStatus = case(QuotaUnknown,\n            'Unknown - quota/metadata missing',\n            InPlaceShortfall > 0, 'Not met - quota shortfall', 'Met - quota only')\n| extend AdditionalCores = iff('{QuotaMigrationMode}' == 'inplace', InPlaceAdditionalCores, SideBySideAdditionalCores),\n         Shortfall = iff('{QuotaMigrationMode}' == 'inplace', InPlaceShortfall, SideBySideShortfall),\n         SelectedStatus = iff('{QuotaMigrationMode}' == 'inplace', InPlaceStatus, SideBySideStatus)\n| extend Conservative = '{QuotaMigrationMode}' == 'inplace' and InPlaceUnverifiedResources > 0\n| extend QuotaStatus = case(SelectedStatus startswith 'Unknown', SelectedStatus,\n              Shortfall > 0 and Conservative, 'Insufficient quota (conservative)',\n              Shortfall > 0, 'Insufficient quota',\n              Conservative, 'Sufficient - conservative quota check', 'Sufficient - quota only'),\n         Delta = iff(CurrentUnknown > 0 or TargetUnknown > 0, tolong(''), TargetCores - CurrentCores),\n         CurrentCores = iff(CurrentUnknown > 0, tolong(''), CurrentCores),\n         TargetCores = iff(TargetUnknown > 0, tolong(''), TargetCores),\n         QuotaCheck = iff(Metric == 'cores', 'Regional total', Metric),\n         DemandEvaluatedAt = now()\n| project SubscriptionId, Region, Metric, Limit, Usage, Available,\n          CurrentCores, TargetCores, Delta, CurrentUnknown, TargetUnknown,\n          AdditionalCores, Shortfall, QuotaStatus, QuotaCheck,\n          SideBySideAdditionalCores, SideBySideShortfall, SideBySideStatus,\n          InPlaceAdditionalCores, InPlaceShortfall, InPlaceStatus, InPlaceUnverifiedResources, UnresolvedResources, DemandEvaluatedAt\n| order by SubscriptionId asc, Region asc, Metric asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{QuotaAllSubscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Automatic quota checks: every affected subscription / region / family","gridSettings":{"formatters":[{"columnMatch":"SubscriptionId","formatter":0,"formatOptions":{"customColumnWidthSetting":"30fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"QuotaCheck","formatter":0,"formatOptions":{"customColumnWidthSetting":"28fr"}},{"columnMatch":"AdditionalCores","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"Available","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"Shortfall","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":">","thresholdValue":"0","representation":"red","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"12fr"}},{"columnMatch":"QuotaStatus","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":"contains","thresholdValue":"Insufficient","representation":"red","text":"{0}{1}"},{"operator":"contains","thresholdValue":"Unknown","representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"green","text":"{0}{1}"}],"customColumnWidthSetting":"32fr"}},{"columnMatch":"Metric","formatter":5},{"columnMatch":"Limit","formatter":5},{"columnMatch":"Usage","formatter":5},{"columnMatch":"CurrentCores","formatter":5},{"columnMatch":"TargetCores","formatter":5},{"columnMatch":"Delta","formatter":5},{"columnMatch":"CurrentUnknown","formatter":5},{"columnMatch":"TargetUnknown","formatter":5},{"columnMatch":"SideBySideAdditionalCores","formatter":5},{"columnMatch":"SideBySideShortfall","formatter":5},{"columnMatch":"SideBySideStatus","formatter":5},{"columnMatch":"InPlaceAdditionalCores","formatter":5},{"columnMatch":"InPlaceShortfall","formatter":5},{"columnMatch":"InPlaceStatus","formatter":5},{"columnMatch":"InPlaceUnverifiedResources","formatter":5},{"columnMatch":"UnresolvedResources","formatter":5},{"columnMatch":"DemandEvaluatedAt","formatter":5}],"rowLimit":100},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"quota-check","conditionalVisibility":{"parameterName":"QuotaDetails","comparison":"isEqualTo","value":"checks"},"customWidth":"100"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| extend QuotaPath = case('{QuotaGeneration}' == '5', parse_json('{V5PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '6', parse_json('{V6PathSkuMap}')[VmSize],\n         '{QuotaGeneration}' == '7', parse_json('{V7PathSkuMap}')[VmSize], '')\n| extend RecommendedTarget = iff('{QuotaGeneration}' == 'default', RecommendedTarget,\n         tostring(split(tostring(QuotaPath), '|')[3]))\n| where '{QuotaScope}' == 'tenant' or SubscriptionId in~ ({Subscriptions})\n    or strcat('/subscriptions/', SubscriptionId) in~ ({Subscriptions})\n    or 'value::all' in~ ({Subscriptions})\n| extend SourceQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(VmSize)]),\n         TargetQuotaFamily = tostring(parse_json('{QuotaFamilyMap}')[tolower(RecommendedTarget)]),\n         SourceCores = tolong(parse_json('{QuotaCoreMap}')[tolower(VmSize)]) * tolong(Instances),\n         TargetCores = tolong(parse_json('{QuotaCoreMap}')[tolower(RecommendedTarget)]) * tolong(Instances)\n| extend SourceCredit = PowerState in~ ('running', 'stopped')\n        and isnotempty(SourceQuotaFamily) and isnotnull(SourceCores) and SourceCores >= 0,\n         Unresolved = isempty(TargetQuotaFamily) or isnull(TargetCores) or Instances < 0\n        or ComputePriority =~ 'Spot' or TargetCores < 0\n| extend RegionalIncrement = case(not(SourceCredit), TargetCores,\n        TargetCores > SourceCores, TargetCores - SourceCores, tolong(0))\n| extend FamilyIncrement = iff(SourceQuotaFamily == TargetQuotaFamily,\n        RegionalIncrement, TargetCores)\n| where isnotempty(TargetQuotaFamily)\n| summarize by Region, TargetQuotaFamily\n| join kind=inner (\nQuotaResources\n| where type =~ 'microsoft.compute/locations/usages'\n| mv-expand Quota = properties.value limit 2000\n| project SubscriptionId = tolower(subscriptionId), Region = tolower(location),\n          Metric = tolower(tostring(Quota.name.value)),\n          QuotaLimit = tolong(Quota['limit']), QuotaUsage = tolong(Quota.currentValue)\n| summarize MetricRecords = count(), Limit = max(QuotaLimit), Usage = max(QuotaUsage)\n    by SubscriptionId, Region, Metric\n| summarize Limits = make_bag(pack(Metric, Limit)), Usages = make_bag(pack(Metric, Usage)),\n        Counts = make_bag(pack(Metric, MetricRecords)) by SubscriptionId, Region\n) on Region\n| extend Family = tolower(TargetQuotaFamily)\n| extend FamilyAvailable = tolong(Limits[Family]) - tolong(Usages[Family]),\n         RegionalAvailable = tolong(Limits['cores']) - tolong(Usages['cores']),\n         QuotaUnknown = isnull(Counts[Family]) or isnull(Counts['cores'])\n             or tolong(Counts[Family]) != 1 or tolong(Counts['cores']) != 1\n             or isnull(tolong(Limits[Family])) or isnull(tolong(Usages[Family]))\n             or isnull(tolong(Limits['cores'])) or isnull(tolong(Usages['cores']))\n             or tolong(Limits[Family]) < 0 or tolong(Usages[Family]) < 0\n             or tolong(Limits['cores']) < 0 or tolong(Usages['cores']) < 0\n| extend AvailableCores = iff(QuotaUnknown, tolong(''),\n             iff(FamilyAvailable < RegionalAvailable, FamilyAvailable, RegionalAvailable))\n| extend HeadroomStatus = case(QuotaUnknown, 'Unknown - quota missing',\n             AvailableCores <= 0, 'No unused quota', 'Potential headroom - assess quota group eligibility')\n| project SubscriptionId, Region, TargetQuotaFamily, AvailableCores, HeadroomStatus\n| order by Region asc, TargetQuotaFamily asc, AvailableCores desc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{QuotaAllSubscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Quota discussion leads: unused quota across readable tenant subscriptions","gridSettings":{"formatters":[{"columnMatch":"SubscriptionId","formatter":0,"formatOptions":{"customColumnWidthSetting":"30fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"TargetQuotaFamily","formatter":0,"formatOptions":{"customColumnWidthSetting":"28fr"}},{"columnMatch":"AvailableCores","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"HeadroomStatus","formatter":0,"formatOptions":{"customColumnWidthSetting":"48fr"}}],"rowLimit":100},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"quota-headroom","conditionalVisibility":{"parameterName":"QuotaDetails","comparison":"isEqualTo","value":"headroom"},"customWidth":"100"},{"type":12,"name":"quota-group-inspector","conditionalVisibility":{"parameterName":"QuotaDetails","comparison":"isEqualTo","value":"groups"},"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Live quota-group inspector\n\nSelect a management group, quota group, subscription, region and metric. Discovery follows API pages. **One selected scope, not a tenant-wide scan**; independent of fleet filters/scenarios. Empty lists/API errors do not prove no group exists.\n\nAPI membership is **not inferred from management-group ancestry**. Allocate pool quota first, then refresh family and regional subscription checks. Already allocated quota is not added again. Pool/allocation continuation pages stay Unknown; review Azure Quotas for full coverage. Donor shareable quota, subscription eligibility and physical capacity are not assessed. No group, membership or quota is changed. [Quota-group guidance](https://learn.microsoft.com/azure/quotas/quota-groups)."},"name":"group-quota-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":9,"name":"group-quota-controls","content":{"version":"KqlParameterItem/1.0","style":"pills","parameters":[{"version":"KqlParameterItem/1.0","name":"QuotaGroupManagementGroup","label":"Readable management group","type":2,"isRequired":true,"queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GETARRAY\",\"path\":\"/providers/Microsoft.Management/managementGroups?api-version=2020-05-01\",\"headers\":[],\"data\":null,\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"columnid\":\"value\",\"path\":\"$.id\"},{\"columnid\":\"label\",\"path\":\"$.name\"}]}}]}","typeSettings":{"showDefault":false}},{"version":"KqlParameterItem/1.0","name":"QuotaGroupId","label":"Quota group","type":2,"isRequired":true,"queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GETARRAY\",\"path\":\"{QuotaGroupManagementGroup}/providers/Microsoft.Quota/groupQuotas?api-version=2025-09-01\",\"headers\":[],\"data\":null,\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"columnid\":\"value\",\"path\":\"$.id\"},{\"columnid\":\"label\",\"path\":\"$.name\"}]}}]}","typeSettings":{"showDefault":false}},{"version":"KqlParameterItem/1.0","name":"QuotaGroupSubscription","type":6,"label":"Subscription to inspect","isRequired":true,"typeSettings":{"additionalResourceOptions":["value::1"],"showDefault":false},"value":"value::1"},{"version":"KqlParameterItem/1.0","name":"QuotaGroupRegion","label":"Region to inspect","type":2,"isRequired":true,"jsonData":"[{\"value\":\"australiacentral\",\"label\":\"australiacentral\"},{\"value\":\"australiacentral2\",\"label\":\"australiacentral2\"},{\"value\":\"australiaeast\",\"label\":\"australiaeast\"},{\"value\":\"australiasoutheast\",\"label\":\"australiasoutheast\"},{\"value\":\"austriaeast\",\"label\":\"austriaeast\"},{\"value\":\"belgiumcentral\",\"label\":\"belgiumcentral\"},{\"value\":\"brazilsouth\",\"label\":\"brazilsouth\"},{\"value\":\"canadacentral\",\"label\":\"canadacentral\"},{\"value\":\"canadaeast\",\"label\":\"canadaeast\"},{\"value\":\"centralindia\",\"label\":\"centralindia\"},{\"value\":\"centralus\",\"label\":\"centralus\"},{\"value\":\"centraluseuap\",\"label\":\"centraluseuap\"},{\"value\":\"chilecentral\",\"label\":\"chilecentral\"},{\"value\":\"denmarkeast\",\"label\":\"denmarkeast\"},{\"value\":\"eastasia\",\"label\":\"eastasia\"},{\"value\":\"eastus\",\"label\":\"eastus\"},{\"value\":\"eastus2\",\"label\":\"eastus2\"},{\"value\":\"eastus2euap\",\"label\":\"eastus2euap\"},{\"value\":\"eastus3\",\"label\":\"eastus3\"},{\"value\":\"francecentral\",\"label\":\"francecentral\"},{\"value\":\"germanywestcentral\",\"label\":\"germanywestcentral\"},{\"value\":\"indiasouthcentral\",\"label\":\"indiasouthcentral\"},{\"value\":\"indonesiacentral\",\"label\":\"indonesiacentral\"},{\"value\":\"israelcentral\",\"label\":\"israelcentral\"},{\"value\":\"israelnorthwest\",\"label\":\"israelnorthwest\"},{\"value\":\"italynorth\",\"label\":\"italynorth\"},{\"value\":\"japaneast\",\"label\":\"japaneast\"},{\"value\":\"japanwest\",\"label\":\"japanwest\"},{\"value\":\"jioindiacentral\",\"label\":\"jioindiacentral\"},{\"value\":\"jioindiawest\",\"label\":\"jioindiawest\"},{\"value\":\"koreacentral\",\"label\":\"koreacentral\"},{\"value\":\"koreasouth\",\"label\":\"koreasouth\"},{\"value\":\"malaysiasouth\",\"label\":\"malaysiasouth\"},{\"value\":\"malaysiawest\",\"label\":\"malaysiawest\"},{\"value\":\"mexicocentral\",\"label\":\"mexicocentral\"},{\"value\":\"newzealandnorth\",\"label\":\"newzealandnorth\"},{\"value\":\"northcentralus\",\"label\":\"northcentralus\"},{\"value\":\"northeastus5\",\"label\":\"northeastus5\"},{\"value\":\"northeurope\",\"label\":\"northeurope\"},{\"value\":\"norwayeast\",\"label\":\"norwayeast\"},{\"value\":\"polandcentral\",\"label\":\"polandcentral\"},{\"value\":\"qatarcentral\",\"label\":\"qatarcentral\"},{\"value\":\"saudiarabiaeast\",\"label\":\"saudiarabiaeast\"},{\"value\":\"southafricanorth\",\"label\":\"southafricanorth\"},{\"value\":\"southcentralus\",\"label\":\"southcentralus\"},{\"value\":\"southcentralus2\",\"label\":\"southcentralus2\"},{\"value\":\"southcentralusstg\",\"label\":\"southcentralusstg\"},{\"value\":\"southeastasia\",\"label\":\"southeastasia\"},{\"value\":\"southeastasia3\",\"label\":\"southeastasia3\"},{\"value\":\"southeastus\",\"label\":\"southeastus\"},{\"value\":\"southeastus3\",\"label\":\"southeastus3\"},{\"value\":\"southeastus5\",\"label\":\"southeastus5\"},{\"value\":\"southindia\",\"label\":\"southindia\"},{\"value\":\"southwestus\",\"label\":\"southwestus\"},{\"value\":\"spaincentral\",\"label\":\"spaincentral\"},{\"value\":\"swedencentral\",\"label\":\"swedencentral\"},{\"value\":\"switzerlandnorth\",\"label\":\"switzerlandnorth\"},{\"value\":\"taiwannorth\",\"label\":\"taiwannorth\"},{\"value\":\"uaenorth\",\"label\":\"uaenorth\"},{\"value\":\"uksouth\",\"label\":\"uksouth\"},{\"value\":\"ukwest\",\"label\":\"ukwest\"},{\"value\":\"westcentralus\",\"label\":\"westcentralus\"},{\"value\":\"westcentralusfre\",\"label\":\"westcentralusfre\"},{\"value\":\"westeurope\",\"label\":\"westeurope\"},{\"value\":\"westus\",\"label\":\"westus\"},{\"value\":\"westus2\",\"label\":\"westus2\"},{\"value\":\"westus3\",\"label\":\"westus3\"}]","value":"australiacentral"},{"version":"KqlParameterItem/1.0","name":"QuotaGroupMetric","label":"Quota metric to inspect","type":2,"isRequired":true,"jsonData":"[{\"value\":\"cores\",\"label\":\"cores\"},{\"value\":\"Standard NCASv3_T4 Family\",\"label\":\"Standard NCASv3_T4 Family\"},{\"value\":\"StandardDadsv7Family\",\"label\":\"StandardDadsv7Family\"},{\"value\":\"StandardDaldsv7Family\",\"label\":\"StandardDaldsv7Family\"},{\"value\":\"StandardDalsv7Family\",\"label\":\"StandardDalsv7Family\"},{\"value\":\"StandardDasv7Family\",\"label\":\"StandardDasv7Family\"},{\"value\":\"StandardDdsv6Family\",\"label\":\"StandardDdsv6Family\"},{\"value\":\"StandardDldsv6Family\",\"label\":\"StandardDldsv6Family\"},{\"value\":\"StandardDlsv6Family\",\"label\":\"StandardDlsv6Family\"},{\"value\":\"StandardDndv6Family\",\"label\":\"StandardDndv6Family\"},{\"value\":\"StandardDnldv6Family\",\"label\":\"StandardDnldv6Family\"},{\"value\":\"StandardDnlv6Family\",\"label\":\"StandardDnlv6Family\"},{\"value\":\"StandardDnv6Family\",\"label\":\"StandardDnv6Family\"},{\"value\":\"StandardDpdsv6Family\",\"label\":\"StandardDpdsv6Family\"},{\"value\":\"StandardDpldsv6Family\",\"label\":\"StandardDpldsv6Family\"},{\"value\":\"StandardDplsv6Family\",\"label\":\"StandardDplsv6Family\"},{\"value\":\"StandardDpsv6Family\",\"label\":\"StandardDpsv6Family\"},{\"value\":\"StandardDsv6Family\",\"label\":\"StandardDsv6Family\"},{\"value\":\"StandardEadsv7Family\",\"label\":\"StandardEadsv7Family\"},{\"value\":\"StandardEasv7Family\",\"label\":\"StandardEasv7Family\"},{\"value\":\"StandardEdsv6Family\",\"label\":\"StandardEdsv6Family\"},{\"value\":\"StandardEndv6Family\",\"label\":\"StandardEndv6Family\"},{\"value\":\"StandardEnv6Family\",\"label\":\"StandardEnv6Family\"},{\"value\":\"StandardEpdsv6Family\",\"label\":\"StandardEpdsv6Family\"},{\"value\":\"StandardEpsv6Family\",\"label\":\"StandardEpsv6Family\"},{\"value\":\"StandardEsv6Family\",\"label\":\"StandardEsv6Family\"},{\"value\":\"StandardFXmdsv2Family\",\"label\":\"StandardFXmdsv2Family\"},{\"value\":\"StandardFXmsv2Family\",\"label\":\"StandardFXmsv2Family\"},{\"value\":\"StandardFadsv7Family\",\"label\":\"StandardFadsv7Family\"},{\"value\":\"StandardFaldsv7Family\",\"label\":\"StandardFaldsv7Family\"},{\"value\":\"StandardFalsv6Family\",\"label\":\"StandardFalsv6Family\"},{\"value\":\"