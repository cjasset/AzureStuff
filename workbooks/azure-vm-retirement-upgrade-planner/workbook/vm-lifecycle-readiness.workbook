ily\"},{\"value\":\"standardEav6Family\",\"label\":\"standardEav6Family\"},{\"value\":\"standardEv3Family\",\"label\":\"standardEv3Family\"},{\"value\":\"standardEv4Family\",\"label\":\"standardEv4Family\"},{\"value\":\"standardEv5Family\",\"label\":\"standardEv5Family\"},{\"value\":\"standardFFamily\",\"label\":\"standardFFamily\"},{\"value\":\"standardFSFamily\",\"label\":\"standardFSFamily\"},{\"value\":\"standardFSv2Family\",\"label\":\"standardFSv2Family\"},{\"value\":\"standardGFamily\",\"label\":\"standardGFamily\"},{\"value\":\"standardGSFamily\",\"label\":\"standardGSFamily\"},{\"value\":\"standardHCSFamily\",\"label\":\"standardHCSFamily\"},{\"value\":\"standardLASv3Family\",\"label\":\"standardLASv3Family\"},{\"value\":\"standardLSFamily\",\"label\":\"standardLSFamily\"},{\"value\":\"standardLSv2Family\",\"label\":\"standardLSv2Family\"},{\"value\":\"standardLSv3Family\",\"label\":\"standardLSv3Family\"},{\"value\":\"standardLaosv4Family\",\"label\":\"standardLaosv4Family\"},{\"value\":\"standardLasv4Family\",\"label\":\"standardLasv4Family\"},{\"value\":\"standardLasv5Family\",\"label\":\"standardLasv5Family\"},{\"value\":\"standardLsv4Family\",\"label\":\"standardLsv4Family\"},{\"value\":\"standardMDSHighMemoryv3Family\",\"label\":\"standardMDSHighMemoryv3Family\"},{\"value\":\"standardMDSMediumMemoryv2Family\",\"label\":\"standardMDSMediumMemoryv2Family\"},{\"value\":\"standardMDSMediumMemoryv3Family\",\"label\":\"standardMDSMediumMemoryv3Family\"},{\"value\":\"standardMIDSHighMemoryv3Family\",\"label\":\"standardMIDSHighMemoryv3Family\"},{\"value\":\"standardMIDSMediumMemoryv2Family\",\"label\":\"standardMIDSMediumMemoryv2Family\"},{\"value\":\"standardMISHighMemoryv3Family\",\"label\":\"standardMISHighMemoryv3Family\"},{\"value\":\"standardMISMediumMemoryv2Family\",\"label\":\"standardMISMediumMemoryv2Family\"},{\"value\":\"standardMSFamily\",\"label\":\"standardMSFamily\"},{\"value\":\"standardMSHighMemoryv3Family\",\"label\":\"standardMSHighMemoryv3Family\"},{\"value\":\"standardMSMediumMemoryv2Family\",\"label\":\"standardMSMediumMemoryv2Family\"},{\"value\":\"standardMSMediumMemoryv3Family\",\"label\":\"standardMSMediumMemoryv3Family\"},{\"value\":\"standardMSv2Family\",\"label\":\"standardMSv2Family\"},{\"value\":\"standardNDISRGB300V6Family\",\"label\":\"standardNDISRGB300V6Family\"},{\"value\":\"standardNVSv4Family\",\"label\":\"standardNVSv4Family\"},{\"value\":\"standardXEIDSv4Family\",\"label\":\"standardXEIDSv4Family\"},{\"value\":\"standardXEISv4Family\",\"label\":\"standardXEISv4Family\"}]","value":"cores"},{"version":"KqlParameterItem/1.0","name":"QuotaGroupEvidence","label":"Evidence detail","type":2,"isRequired":true,"value":"summary","jsonData":"[{\"value\":\"summary\",\"label\":\"Summary\"},{\"value\":\"raw\",\"label\":\"Summary + raw API evidence\"}]"}]}},{"type":3,"name":"group-quota-membership","content":{"version":"KqlItem/1.0","queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GET\",\"path\":\"{QuotaGroupId}/subscriptions/{QuotaGroupSubscription}?api-version=2025-09-01\",\"headers\":[],\"data\":null,\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"columnid\":\"Record\",\"path\":\"$\"}]}}]}","title":"Live membership evidence","size":3,"visualization":"table","gridSettings":{"formatters":[{"columnMatch":"Record","formatter":0,"formatOptions":{"customColumnWidthSetting":"100fr"}}],"rowLimit":100},"noDataMessage":"Unknown: no API evidence. Check permissions, selected scope and API errors."},"conditionalVisibility":{"parameterName":"QuotaGroupEvidence","comparison":"isEqualTo","value":"raw"},"customWidth":"100"},{"type":9,"name":"group-quota-membership-record","content":{"version":"KqlParameterItem/1.0","parameters":[{"version":"KqlParameterItem/1.0","name":"QuotaGroupMemberRecord","type":1,"isHiddenWhenLocked":true,"value":"","queryType":7,"query":"{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"2b1a9f9c-57d2-5f21-b60d-a0f5a51e620e\",\"mergeType\":\"table\",\"leftTable\":\"group-quota-membership\"}],\"projectRename\":[{\"originalName\":\"[group-quota-membership].Record\",\"mergedName\":\"Record\",\"fromId\":\"2b1a9f9c-57d2-5f21-b60d-a0f5a51e620e\"}]}"}]}},{"type":3,"name":"group-quota-pool","content":{"version":"KqlItem/1.0","queryType":12,"query":"{\"version\":\"ARMEndpoint/1.0\",\"method\":\"GET\",\"path\":\"{QuotaGroupId}/resourceProviders/Microsoft.Compute/groupQuotaLimits/{QuotaGroupRegion}?api-version=2025-09-01\",\"headers\":[],\"data\":null,\"urlParams\":[],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"columnid\":\"Record\",\"path\":\"$\"}]}}]}","title":"Live regional group-pool evidence","size":3,"visualization":"table","gridSettings":{"formatters":[{"columnMatch":"Record","formatter":0,"formatOptions":{"customColumnWidthSetting":"100fr"}}],"rowLimit":100},"noDataMessage":"Unknown: no API evidence. Check permissions, selected scope and API errors."},"conditionalVisibility":{"parameterName":"QuotaGroupEvidence","comparison":"isEqualTo","value":"raw"},"customWidth":"100"},{"type":9,"name":"group-quota-pool-record","content":{"version":"KqlParameterItem/1.0","parameters":[{"version":"KqlParameterItem/1.0","name":"QuotaGroupPoolRecord","type":1,"isHiddenWhenLocked":true,"value":"","queryType":7,"query":"{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"f393feb7-f5b8-5674-b08c-b1330c5fdfd8\",\"mergeType\":\"table\",\"leftTable\":\"group-quota-pool\"}],\"projectRename\":[{\"originalName\":\"[group-quota-pool].Record\",\"mergedName\":\"Record\",\"fromId\":\"f393feb7-f5b8-5674-b08c-b1330c5fdfd8\"}]}"}]}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resourcecontainers\n| take 1\n| summarize Seed=count()\n| project Member=dynamic({QuotaGroupMemberRecord:json}), Pool=dynamic({QuotaGroupPoolRecord:json}),\n    SelectedGroup=tostring(dynamic({QuotaGroupId:json})),\n    SelectedSubscription=tolower(tostring(dynamic({QuotaGroupSubscription:json}))),\n    SelectedRegion=tolower(tostring(dynamic({QuotaGroupRegion:json}))),\n    SelectedMetric=tolower(tostring(dynamic({QuotaGroupMetric:json})))\n| extend Member=iff(gettype(Member) == 'string', parse_json(tostring(Member)), Member),\n         Pool=iff(gettype(Pool) == 'string', parse_json(tostring(Pool)), Pool)\n| extend ExpectedMember=tolower(strcat(SelectedGroup, '/subscriptions/', SelectedSubscription)),\n    ExpectedPool=tolower(strcat(SelectedGroup,\n        '/resourceProviders/Microsoft.Compute/groupQuotaLimits/', SelectedRegion)),\n    MemberState=tostring(Member.properties.provisioningState),\n    PoolState=tostring(Pool.properties.provisioningState),\n    HasMorePages=isnotempty(tostring(Pool.properties.nextLink)) or isnotempty(tostring(Pool.nextLink)),\n    Values=Pool.properties.value\n| extend MemberVerified=isnotempty(SelectedGroup) and isnotempty(SelectedSubscription)\n        and tolower(tostring(Member.id)) == ExpectedMember\n        and tolower(tostring(Member.properties.subscriptionId)) == SelectedSubscription\n        and MemberState =~ 'Succeeded',\n    PoolScopeVerified=isnotempty(SelectedGroup) and isnotempty(SelectedRegion)\n        and tolower(tostring(Pool.id)) == ExpectedPool and PoolState =~ 'Succeeded',\n    ValuesTruncated=array_length(Values) > 2000\n| extend Values=iff(coalesce(array_length(Values), 0) > 0, Values, dynamic([{}]))\n| mv-expand Value=Values limit 2000\n| extend Family=tolower(coalesce(tostring(Value.properties.name.value),\n                                  tostring(Value.properties.resourceName)))\n| extend Matches=isnotempty(SelectedMetric) and Family == SelectedMetric,\n    InvalidValue=isnull(tolong(Value.properties['limit']))\n        or isnull(tolong(Value.properties.availableLimit))\n        or tolong(Value.properties['limit']) < 0 or tolong(Value.properties.availableLimit) < 0\n        or tolong(Value.properties.availableLimit) > tolong(Value.properties['limit'])\n| summarize MetricRecords=countif(Matches), InvalidValues=countif(Matches and InvalidValue),\n    MatchingValues=make_list_if(Value, Matches, 2)\n    by SelectedGroup, SelectedSubscription, SelectedRegion, SelectedMetric, MemberVerified,\n       MemberState, PoolScopeVerified, PoolState, HasMorePages, ValuesTruncated\n| extend Value=MatchingValues[0]\n| extend GroupLimit=tolong(Value.properties['limit']),\n    Unallocated=tolong(Value.properties.availableLimit),\n    AllocationPage=Value.properties.allocatedToSubscriptions\n| extend Allocations=AllocationPage.value\n| extend AllocationsTruncated=array_length(Allocations) > 2000,\n    AllocationHasMore=isnotempty(tostring(AllocationPage.nextLink)),\n    AllocationsShape=gettype(Allocations)\n| extend Allocations=iff(coalesce(array_length(Allocations), 0) > 0,\n                         Allocations, dynamic([{}]))\n| mv-expand Allocation=Allocations limit 2000\n| extend SelectedAllocation=tolower(tostring(Allocation.subscriptionId)) == SelectedSubscription\n    and isnotempty(SelectedSubscription)\n| summarize AllocationRecords=countif(SelectedAllocation),\n    Allocated=maxif(tolong(Allocation.quotaAllocated), SelectedAllocation),\n    AllocationIncomplete=countif(AllocationsTruncated or AllocationHasMore\n        or AllocationsShape != 'array'),\n    InvalidAllocations=countif(SelectedAllocation and\n        (isnull(tolong(Allocation.quotaAllocated)) or tolong(Allocation.quotaAllocated) < 0))\n    by SelectedGroup, SelectedSubscription, SelectedRegion, SelectedMetric, MemberVerified,\n       MemberState, PoolScopeVerified, PoolState, HasMorePages, ValuesTruncated,\n       MetricRecords, InvalidValues, GroupLimit, Unallocated\n| extend PoolVerified=PoolScopeVerified and not(HasMorePages) and not(ValuesTruncated)\n    and MetricRecords == 1 and InvalidValues == 0,\n    AllocationVerified=AllocationRecords <= 1 and AllocationIncomplete == 0\n        and InvalidAllocations == 0\n| extend Evidence=case(not(MemberVerified), 'Unknown - membership not verified',\n    not(PoolVerified), 'Unknown - pool missing, partial or invalid',\n    not(AllocationVerified), 'Unknown - allocation incomplete or invalid',\n    'Verified - selected scope only')\n| project ManagementGroupAndQuotaGroup=SelectedGroup, Subscription=SelectedSubscription,\n    Region=SelectedRegion, Metric=SelectedMetric,\n    Membership=iff(MemberVerified, 'Verified member', 'Unknown - verify membership/access'),\n    ['Group quota evidence']=Evidence,\n    ['Group limit']=iff(PoolVerified, GroupLimit, tolong('')),\n    ['Unallocated group cores']=iff(PoolVerified, Unallocated, tolong('')),\n    ['Already allocated to subscription']=iff(PoolVerified and MemberVerified and AllocationVerified,\n        coalesce(Allocated, tolong(0)), tolong('')),\n    ['Next action']=case(Evidence startswith 'Unknown',\n        'Resolve API errors, membership and evidence coverage in Azure Quotas',\n        Unallocated > 0, 'Allocation required; then refresh subscription quota checks',\n        'No unallocated pool quota; assess an increase or verified eligible transfer'),\n    CheckedAtUtc=now()","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Quota-group evidence - separate from subscription quota checks","gridSettings":{"formatters":[{"columnMatch":"Subscription","formatter":0,"formatOptions":{"customColumnWidthSetting":"30fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}},{"columnMatch":"Metric","formatter":0,"formatOptions":{"customColumnWidthSetting":"25fr"}},{"columnMatch":"Membership","formatter":0,"formatOptions":{"customColumnWidthSetting":"24fr"}},{"columnMatch":"Group quota evidence","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":"contains","thresholdValue":"Unknown","representation":"orange","text":"{0}{1}"},{"operator":"Default","representation":"blue","text":"{0}{1}"}],"customColumnWidthSetting":"34fr"}},{"columnMatch":"Group limit","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"Unallocated group cores","formatter":0,"formatOptions":{"customColumnWidthSetting":"16fr"}},{"columnMatch":"Already allocated to subscription","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"Next action","formatter":0,"formatOptions":{"customColumnWidthSetting":"45fr"}},{"columnMatch":"ManagementGroupAndQuotaGroup","formatter":5},{"columnMatch":"CheckedAtUtc","formatter":5}],"rowLimit":100},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"group-quota-evidence","customWidth":"100"}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Column key & assumptions\n\nTotals plus subscription rows. **Planning scope:** selected or all readable tenant subscriptions; other tabs keep their scope.\n\n| Column | Key |\n| --- | --- |\n| Current cores | Retirement/EOL configured quota-vCPUs including deallocated inventory; VMSS counted once. Not subscription usage. |\n| Target cores | Scenario quota-vCPUs in current regions. Independent V5/V6/V7 paths; no fallback. Missing targets stay Unknown. |\n| Delta (+/-) | Target minus current, not the quota request; independent of approach. |\n| Quota status | Red: regional/family shortfall. Orange: missing quota/target data or Spot. Green: quota only. Conservative: no unverified source credit. |\n\n**Every affected subscription/region/family is checked automatically** against indexed Compute `QuotaResources`. Both constraints must pass; spare quota elsewhere cannot cancel shortfalls. Indexing lags: recheck Azure Quotas/CLI before migration. Missing records are Unknown, not unlimited.\n\n**In-place** grants source credit only for running/stopped allocations with known source metadata. Otherwise full target cores are conservative; downsizing gives no negative credits. A conservative shortfall does not prove every optimized resize fails.\n\n**Quota checks:** AdditionalCores is required headroom; Available is limit minus current usage; Shortfall is max(additional minus available, zero); blank means Unknown. Regional demand includes all families. **Tenant headroom** is unused family quota capped by regional headroom, not post-migration surplus or pooled quota. **Live quota-group inspector** checks one selected management group/group/subscription/region/metric, not tenant-wide membership or transfer eligibility. No quota is moved; verify membership, eligibility, limits and approvals separately.\n\n**Quota is not physical capacity or resize approval.** Validate SKU/zone access, policy, boot/drivers and allocation. Targets use `vCPUs`, not constrained `vCPUsAvailable`. Lifecycle filters do not remove demand; scenarios do not change Inventory recommendations. Plan service quotas, autoscaler maxima, surge and Batch separately. See [VM vCPU quotas](https://learn.microsoft.com/azure/quotas/per-vm-quota-requests)."},"name":"quota-key-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"QuotaDetails","comparison":"isEqualTo","value":"key"},"name":"quota-key"}]},"conditionalVisibility":{"parameterName":"PlanView","comparison":"isEqualTo","value":"quota"},"name":"grp-quota"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Recommended target mapping\nOne row per affected size in your fleet. **Recommended target** is the default same-or-better replacement. **Memory-preserving target** is the alternative when the default reduces RAM. Always right-size against 30-90 days of real utilisation rather than the current nameplate."},"name":"map-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where '{LifecycleFilter}' has Lifecycle\n| extend SpecNotes = tostring(parse_json('{\"Amv2\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Av2\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Blsv1\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Bmsv1\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Bsv1\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Dadsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dasv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Dasv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dav4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ddsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ddsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Ddv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ddv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dldsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dlsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dpdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dpldsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dplsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dpsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dsv1\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dsv2\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dsv3\":\"Same as D/Ds/Dv2/Dsv2. Driver here is RI ineligibility after 2026-07-01, not retirement.\",\"Dsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Dsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dv1\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dv2\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dv3\":\"Same as D/Ds/Dv2/Dsv2. Driver here is RI ineligibility after 2026-07-01, not retirement.\",\"Dv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Dv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eadsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Easv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Easv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eav4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ebdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Ebsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Edsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Edsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Edv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Edv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eiadsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eiasv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Eiasv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eibdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eibsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eidsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Eidsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eidv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eisv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Eisv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eiv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Epdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Epsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Esv3\":\"Same as D-family. Driver is RI ineligibility after 2026-07-01, not retirement.\",\"Esv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Esv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Ev3\":\"Same as D-family. Driver is RI ineligibility after 2026-07-01, not retirement.\",\"Ev4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ev5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Fsv1\":\"v5 SCSI; v6 NVMe. Remote storage 4167 IOPS / 124 MBps.\",\"Fsv2\":\"v5 SCSI; v6 NVMe. Remote storage 4167 IOPS / 124 MBps.\",\"Fv1\":\"v5 SCSI; v6 NVMe. Remote storage 4167 IOPS / 124 MBps.\",\"Gsv1\":\"Lv3/Lv4 controller SCSI and NVMe. Remote storage 12800 IOPS / 200 MBps.\",\"Gv1\":\"Lv3/Lv4 controller SCSI and NVMe. Remote storage 12800 IOPS / 200 MBps.\",\"HBrsv2\":\"Newer AMD EPYC (Milan/Genoa/Zen4) and newer InfiniBand (HDR on HBv3 to NDR on HBv4/HBv5). Validate MPI performance, memory bandwidth and RDMA compatibility.\",\"Lsv1\":\"Local storage NVMe. Remote storage 12800 IOPS / 200 MBps. Controller SCSI and NVMe.\",\"Lsv2\":\"Local storage NVMe. Remote storage 12800 IOPS / 200 MBps. Controller SCSI and NVMe.\",\"Mbdsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mbsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mdmsv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mdsv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mdsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Midmsv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Midsv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Midsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mimsv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Misv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Misv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mlsv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mmsv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mmsv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mmv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Msv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Msv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Msv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mtsv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"NPsv1\":\"FPGA (AMD Xilinx Alveo U250) to GPU. Workloads must be ported from Vitis/XRT to CUDA. This is a re-architecture, not a resize.\",\"NVasv4\":\"AMD Radeon Instinct MI25 partial GPU to NVIDIA A10 partitions. Validate GPU driver stack and any AMD-specific tooling.\",\"NVsv3\":\"NVIDIA M60 to A10. Validate GPU driver and remote-visualization stack.\"}')[Series])\n| extend AnnouncementUrl = tostring(parse_json('{\"Av2_Amv2\":\"https://azure.microsoft.com/updates?id=500682\",\"Bv1\":\"https://azure.microsoft.com/updates?id=500682\",\"D_Ds_Dv2_Dsv2\":\"https://azure.microsoft.com/updates?id=485569\",\"F_Fs\":\"https://azure.microsoft.com/updates?id=500682\",\"Fsv2\":\"https://azure.microsoft.com/updates?id=500682\",\"G_Gs\":\"https://azure.microsoft.com/updates?id=500682\",\"Ls\":\"https://azure.microsoft.com/updates?id=485569\",\"Lsv2\":\"https://azure.microsoft.com/updates?id=500682\",\"NP\":\"https://azure.microsoft.com/updates?id=548497\",\"NVv3\":\"https://azure.microsoft.com/updates?id=516070\",\"NVv4\":\"https://azure.microsoft.com/updates?id=516070\"}')[SeriesGroup])\n| summarize Resources = count(), Instances = sum(Instances),\n            Regions = strcat_array(make_set(Region, 20), ', '),\n            AvgReadiness = round(avg(todouble(ReadinessScore)), 0)\n    by VmSize, Series, SeriesGroup, ActionCategory, RetirementDate, CurrentVcpu, CurrentMemoryGB,\n       RecommendedTarget, TargetVcpu, TargetMemoryGB, MemoryPreservingTarget, MpVcpu, MpMemoryGB,\n       AlternateTargets, SizeConsiderations, SpecNotes, RiEnded, RiStatus, PriceUpdate2027, AnnouncementUrl\n| extend Current = strcat(CurrentVcpu, ' vCPU / ', CurrentMemoryGB, ' GB')\n| extend Target = strcat(TargetVcpu, ' vCPU / ', TargetMemoryGB, ' GB')\n| extend MemoryPreserving = iff(isempty(MemoryPreservingTarget), '-',\n            strcat(MemoryPreservingTarget, '  (', MpVcpu, ' vCPU / ', MpMemoryGB, ' GB)'))\n| project VmSize, ActionCategory, RetirementDate, Instances, Current,\n          RecommendedTarget, Target, MemoryPreserving, AvgReadiness, AnnouncementUrl\n| order by Instances desc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Recommended targets","gridSettings":{"formatters":[{"columnMatch":"VmSize","formatter":1,"formatOptions":{"linkColumn":"AnnouncementUrl","linkTarget":"Url","customColumnWidthSetting":"12fr"}},{"columnMatch":"ActionCategory","formatter":0,"formatOptions":{"customColumnWidthSetting":"11fr"}},{"columnMatch":"RetirementDate","formatter":6,"dateFormat":{"showUtcTime":true,"formatName":"shortDatePattern"},"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"Instances","formatter":0,"formatOptions":{"customColumnWidthSetting":"6fr"}},{"columnMatch":"Current","formatter":0,"formatOptions":{"customColumnWidthSetting":"11fr"}},{"columnMatch":"RecommendedTarget","formatter":0,"formatOptions":{"customColumnWidthSetting":"14fr"}},{"columnMatch":"Target","formatter":0,"formatOptions":{"customColumnWidthSetting":"11fr"}},{"columnMatch":"MemoryPreserving","formatter":0,"formatOptions":{"customColumnWidthSetting":"21fr"}},{"columnMatch":"AvgReadiness","formatter":8,"formatOptions":{"palette":"redGreen","min":0,"max":100,"customColumnWidthSetting":"5fr"}},{"columnMatch":"AnnouncementUrl","formatter":5}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"VmSize","label":"Current size"},{"columnId":"ActionCategory","label":"Lifecycle status"},{"columnId":"RetirementDate","label":"Retires on"},{"columnId":"Current","label":"Current spec"},{"columnId":"RecommendedTarget","label":"Recommended target"},{"columnId":"Target","label":"Target spec"},{"columnId":"MemoryPreserving","label":"Memory-preserving target"},{"columnId":"AvgReadiness","label":"Avg platform score"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"map-grid","customWidth":"100"},{"type":1,"content":{"json":"#### Alternates, series notes and commercial impact\nThe same sizes again, with the other targets worth evaluating, what changes at the series level, and the commercial position: whether the separate legacy-series 1 February 2027 pricing update applies to the series, and the series-wide RI purchase/renewal cutoff.\n\n> Reserved Instance purchases and renewals for these series ended **1 July 2026**. **This is not a customer's reservation expiry date or evidence of current pay-as-you-go billing.** See Inventory > Reservation exposure for visible purchased records. Matching benefit coverage, other discounts and billing are not inspected. ([Azure update 560948](https://azure.microsoft.com/updates?id=560948)). For the rates that apply to your agreement, see the official [Windows](https://azure.microsoft.com/pricing/details/virtual-machines/windows/) and [Linux](https://azure.microsoft.com/pricing/details/virtual-machines/linux/) VM pricing pages, and your own Azure Service Health notification."},"name":"map-detail-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where '{LifecycleFilter}' has Lifecycle\n| extend SpecNotes = tostring(parse_json('{\"Amv2\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Av2\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Blsv1\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Bmsv1\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Bsv1\":\"B/Bav2 and D/Ev5 disk controller SCSI; D/Ev6 NVMe. Remote storage 3750 IOPS / 85 MBps.\",\"Dadsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dasv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Dasv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dav4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ddsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ddsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Ddv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ddv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dldsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dlsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dpdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dpldsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dplsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dpsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dsv1\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dsv2\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dsv3\":\"Same as D/Ds/Dv2/Dsv2. Driver here is RI ineligibility after 2026-07-01, not retirement.\",\"Dsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Dsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Dv1\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dv2\":\"v5 disk controller SCSI; v6/v7 disk controller NVMe. Local storage 9000 IOPS / 125 MBps. Remote storage 3750 IOPS / 82 MBps.\",\"Dv3\":\"Same as D/Ds/Dv2/Dsv2. Driver here is RI ineligibility after 2026-07-01, not retirement.\",\"Dv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Dv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eadsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Easv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Easv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eav4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ebdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Ebsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Edsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Edsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Edv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Edv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eiadsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eiasv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Eiasv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eibdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eibsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eidsv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Eidsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eidv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eisv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Eisv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Eiv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Epdsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Epsv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Esv3\":\"Same as D-family. Driver is RI ineligibility after 2026-07-01, not retirement.\",\"Esv4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Esv5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Ev3\":\"Same as D-family. Driver is RI ineligibility after 2026-07-01, not retirement.\",\"Ev4\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking. Not a retirement - an optional price-performance upgrade.\",\"Ev5\":\"v6/v7 use an NVMe disk controller, are Generation 2 only, and require MANA networking.\",\"Fsv1\":\"v5 SCSI; v6 NVMe. Remote storage 4167 IOPS / 124 MBps.\",\"Fsv2\":\"v5 SCSI; v6 NVMe. Remote storage 4167 IOPS / 124 MBps.\",\"Fv1\":\"v5 SCSI; v6 NVMe. Remote storage 4167 IOPS / 124 MBps.\",\"Gsv1\":\"Lv3/Lv4 controller SCSI and NVMe. Remote storage 12800 IOPS / 200 MBps.\",\"Gv1\":\"Lv3/Lv4 controller SCSI and NVMe. Remote storage 12800 IOPS / 200 MBps.\",\"HBrsv2\":\"Newer AMD EPYC (Milan/Genoa/Zen4) and newer InfiniBand (HDR on HBv3 to NDR on HBv4/HBv5). Validate MPI performance, memory bandwidth and RDMA compatibility.\",\"Lsv1\":\"Local storage NVMe. Remote storage 12800 IOPS / 200 MBps. Controller SCSI and NVMe.\",\"Lsv2\":\"Local storage NVMe. Remote storage 12800 IOPS / 200 MBps. Controller SCSI and NVMe.\",\"Mbdsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mbsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mdmsv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mdsv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mdsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Midmsv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Midsv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Midsv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mimsv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Misv2\":\"Validate SAP HANA certification for the target size before committing.\",\"Misv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mlsv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mmsv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mmsv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mmv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Msv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Msv2\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Msv3\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mtsv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"Mv1\":\"Msv3/Mdsv3 run newer silicon with better memory bandwidth per core. Confirm the target size is SAP HANA certified before committing.\",\"NPsv1\":\"FPGA (AMD Xilinx Alveo U250) to GPU. Workloads must be ported from Vitis/XRT to CUDA. This is a re-architecture, not a resize.\",\"NVasv4\":\"AMD Radeon Instinct MI25 partial GPU to NVIDIA A10 partitions. Validate GPU driver stack and any AMD-specific tooling.\",\"NVsv3\":\"NVIDIA M60 to A10. Validate GPU driver and remote-visualization stack.\"}')[Series])\n| extend AnnouncementUrl = tostring(parse_json('{\"Av2_Amv2\":\"https://azure.microsoft.com/updates?id=500682\",\"Bv1\":\"https://azure.microsoft.com/updates?id=500682\",\"D_Ds_Dv2_Dsv2\":\"https://azure.microsoft.com/updates?id=485569\",\"F_Fs\":\"https://azure.microsoft.com/updates?id=500682\",\"Fsv2\":\"https://azure.microsoft.com/updates?id=500682\",\"G_Gs\":\"https://azure.microsoft.com/updates?id=500682\",\"Ls\":\"https://azure.microsoft.com/updates?id=485569\",\"Lsv2\":\"https://azure.microsoft.com/updates?id=500682\",\"NP\":\"https://azure.microsoft.com/updates?id=548497\",\"NVv3\":\"https://azure.microsoft.com/updates?id=516070\",\"NVv4\":\"https://azure.microsoft.com/updates?id=516070\"}')[SeriesGroup])\n| summarize Resources = count(), Instances = sum(Instances),\n            Regions = strcat_array(make_set(Region, 20), ', '),\n            AvgReadiness = round(avg(todouble(ReadinessScore)), 0)\n    by VmSize, Series, SeriesGroup, ActionCategory, RetirementDate, CurrentVcpu, CurrentMemoryGB,\n       RecommendedTarget, TargetVcpu, TargetMemoryGB, MemoryPreservingTarget, MpVcpu, MpMemoryGB,\n       AlternateTargets, SizeConsiderations, SpecNotes, RiEnded, RiStatus, PriceUpdate2027, AnnouncementUrl\n| extend Current = strcat(CurrentVcpu, ' vCPU / ', CurrentMemoryGB, ' GB')\n| extend Target = strcat(TargetVcpu, ' vCPU / ', TargetMemoryGB, ' GB')\n| extend MemoryPreserving = iff(isempty(MemoryPreservingTarget), '-',\n            strcat(MemoryPreservingTarget, '  (', MpVcpu, ' vCPU / ', MpMemoryGB, ' GB)'))\n| extend AlternateTargets = replace_string(AlternateTargets, ',', ', ')\n| project VmSize, Series, AlternateTargets, SizeConsiderations, SpecNotes,\n          PriceUpdate2027, RiEnded, RiStatus\n| order by VmSize asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Alternates, series detail and commercial impact","gridSettings":{"formatters":[{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"Series","formatter":0,"formatOptions":{"customColumnWidthSetting":"6fr"}},{"columnMatch":"AlternateTargets","formatter":0,"formatOptions":{"customColumnWidthSetting":"16fr"}},{"columnMatch":"SizeConsiderations","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"SpecNotes","formatter":0,"formatOptions":{"customColumnWidthSetting":"20fr"}},{"columnMatch":"PriceUpdate2027","formatter":18,"formatOptions":{"thresholdsOptions":"icons","thresholdsGrid":[{"operator":"==","thresholdValue":"Yes","representation":"2","text":"1 Feb 2027"},{"operator":"Default","representation":"success","text":"Not affected"}],"customColumnWidthSetting":"10fr"}},{"columnMatch":"RiEnded","formatter":6,"dateFormat":{"showUtcTime":true,"formatName":"shortDatePattern"},"formatOptions":{"customColumnWidthSetting":"8fr"}},{"columnMatch":"RiStatus","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"VmSize","label":"Current size"},{"columnId":"AlternateTargets","label":"Alternate targets"},{"columnId":"SizeConsiderations","label":"Considerations"},{"columnId":"SpecNotes","label":"Series notes"},{"columnId":"PriceUpdate2027","label":"Pricing update"},{"columnId":"RiEnded","label":"Series RI purchase/renewal cutoff"},{"columnId":"RiStatus","label":"Cutoff status - coverage not assessed"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"map-detail","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"PlanView","comparison":"isEqualTo","value":"mapping"},"name":"grp-mapping"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Small compatible target shortlist\n\nUp to two closest captured candidates per generation plus that generation's preferred path, not every possible Azure size. The **default remains V5-first**. Select Details for architecture versus CPU vendor, quota versus effective CPUs, memory, local-disk and controller tradeoffs. Candidate filters preserve captured CPU architecture, CPU/memory, local-disk presence and known capacity and premium IO. V6/V7 unknown local-disk capacity remains an explicit validation gate. No target record means no assessed candidate, never a suffix-invented SKU.\n\nVendor and effective CPUs are Unknown if the catalogue does not supply them; inspect the live target SKU record and product/vendor certification. Use **Plan > Live target availability** for the selected target's count/performance ceilings. This is not utilization-based right-sizing, service-supported node-type certification or a region/zone/quota approval."},"name":"alternatives-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type in~ ('microsoft.compute/virtualmachines', 'microsoft.compute/virtualmachinescalesets')\n| extend IsVmss = type =~ 'microsoft.compute/virtualmachinescalesets'\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Targets = parse_json('{CompatibleTargetMap}')[VmSize]\n| mv-expand Target = Targets limit 10\n| extend Spec = parse_json('{TargetSpecMap}')[tostring(Target)]\n| project Resource = name, Source = VmSize, Target = tostring(Target),\n          Generation = toint(Spec[0]), CpuArchitecture = tostring(Spec[1]),\n          CpuVendor = tostring(Spec[2]), QuotaVcpus = toint(Spec[3]),\n          EffectiveVcpus = 'Unknown - inspect live vCPUsAvailable; not quota CPUs',\n          MemoryGB = toreal(Spec[4]), LocalDiskGB = toreal(Spec[5]),\n          LocalDisk = tostring(Spec[6]), NvmeRequired = tobool(Spec[7]),\n          HyperVGenerations = tostring(Spec[8]), PremiumIO = tobool(Spec[9]),\n          Decision = 'Captured compatible candidate - not guest, vendor, quota or placement approval',\n          ResourceId = id, Region = location, SubscriptionId = subscriptionId\n| order by Resource asc, Generation asc, QuotaVcpus asc, MemoryGB asc\n| extend Details = 'Details'","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Captured compatible candidates for retiring/EOL resources","gridSettings":{"formatters":[{"columnMatch":"Resource","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"Source","formatter":0,"formatOptions":{"customColumnWidthSetting":"22fr"}},{"columnMatch":"Target","formatter":0,"formatOptions":{"customColumnWidthSetting":"25fr"}},{"columnMatch":"Generation","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"QuotaVcpus","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"MemoryGB","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"Details","formatter":1,"formatOptions":{"linkTarget":"GenericDetails","linkIsContextBlade":true,"customColumnWidthSetting":"10fr"}},{"columnMatch":"CpuArchitecture","formatter":5},{"columnMatch":"CpuVendor","formatter":5},{"columnMatch":"EffectiveVcpus","formatter":5},{"columnMatch":"LocalDiskGB","formatter":5},{"columnMatch":"LocalDisk","formatter":5},{"columnMatch":"NvmeRequired","formatter":5},{"columnMatch":"HyperVGenerations","formatter":5},{"columnMatch":"PremiumIO","formatter":5},{"columnMatch":"Decision","formatter":5},{"columnMatch":"ResourceId","formatter":5},{"columnMatch":"Region","formatter":5},{"columnMatch":"SubscriptionId","formatter":5}],"rowLimit":100,"filter":true},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"target-alternatives","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"PlanView","comparison":"isEqualTo","value":"alternatives"},"name":"grp-alternatives"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Suggested migration sequence\nWaves are ordered to bank low-risk wins first and to leave enough runway for the workloads that need prerequisite work. Front-load anything already Generation 2 and NVMe-capable; start the Gen1 conversion track in parallel because it has the longest lead time.\n\n| Wave | Scope | Why it goes here |\n| --- | --- | --- |\n| 1 | Few scored platform changes, non-production tag | Validate ownership and rehearse; not a no-risk claim |\n| 2 | Few scored platform changes, production or unverified | Assess application, HA, backup and rollback before scheduling |\n| 3 | Moderate scored platform changes | Validate NVMe/MANA and temp-disk dependencies |\n| 4 | Substantial scored platform changes | Plan conversion, memory or region changes |\n| 5 | Major scored platform changes | Assess redesign requirements and dependencies |\n\nThese are **platform triage suggestions**, not approved migration waves or application complexity ratings.\n\n**How environment is determined.** Most fleets do not tag every VM, so the workbook resolves environment through a cascade and reports which signal it used:\n\n| Order | Signal | Notes |\n| ---: | --- | --- |\n| 1 | **Resource tag** | `Environment`, `Env`, `Tier`, `Stage` or `Usage`, any casing |\n| 2 | **Resource group tag** | Same keys on the parent resource group |\n| 3 | **Subscription tag** | Same keys on the subscription |\n| 4 | **Dev/Test subscription offer** | A Visual Studio or Enterprise Dev/Test subscription cannot host production under the Azure offer terms |\n| 5 | **Naming convention** | `dev`, `test`, `qa`, `uat`, `sandbox`, `staging` in the subscription or resource group name. Only ever read as non-production, never as production, because a name is weaker evidence than a tag |\n\nValues are normalised, so `non-prod`, `non_prod` and `nonprod` read alike. **Anything the cascade cannot resolve is sequenced as production**, not non-production, because the cost of guessing wrong is a production outage during what was sold as a no-risk pilot.\n\nThe **Environment** and **Signal** columns below show the verdict and its source. If most rows read *Unverified*, the fastest fix is one `Environment` tag on each resource group - that alone resolves the whole estate through step 2."},"name":"plan-intro","styleSettings":{"margin":"0","padding":"0"},"customWidth":"50"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| where DaysToRetirement >= 0\n| extend Quarter = strcat(format_datetime(RetiresOn, 'yyyy'), ' Q', toint((getmonth(RetiresOn) - 1) / 3) + 1)\n| summarize Instances = sum(Instances) by Quarter\n| order by Quarter asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"barchart","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Instances to migrate by retirement quarter"},"name":"plan-burndown","customWidth":"50"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n// Environment is resolved through a cascade, because most fleets do not tag\n// every VM. The most specific signal wins, and the source is reported so the\n// the signal it used is visible.\n//\n// A note on why this is not a tag-bag scan: the earlier `tostring(Tags) has\n// 'prod'` test was wrong in both directions. KQL `has` matches whole terms, so\n// \"Production\" did not match the term \"prod\" and a production VM was reported\n// as non-production, while \"non-prod\" tokenised to [\"non\",\"prod\"] and matched,\n// and an unrelated tag such as Product=prod-catalog matched too.\n| extend EnvSelf = tolower(tostring(coalesce(Tags['Environment'], Tags['environment'], Tags['ENVIRONMENT'], Tags['Env'], Tags['env'], Tags['ENV'], Tags['Tier'], Tags['tier'], Tags['Stage'], Tags['stage'], Tags['Usage'], Tags['usage'])))\n| extend RgKey = tolower(strcat(SubscriptionId, '/', ResourceGroup))\n| join kind=leftouter (\n    resourcecontainers\n    | where type =~ 'microsoft.resources/subscriptions/resourcegroups'\n    | project RgKey = tolower(strcat(subscriptionId, '/', name)),\n              EnvRg = tolower(tostring(coalesce(tags['Environment'], tags['environment'], tags['ENVIRONMENT'], tags['Env'], tags['env'], tags['ENV'], tags['Tier'], tags['tier'], tags['Stage'], tags['stage'], tags['Usage'], tags['usage'])))\n  ) on RgKey\n| join kind=leftouter (\n    resourcecontainers\n    | where type =~ 'microsoft.resources/subscriptions'\n    | project SubscriptionId = subscriptionId,\n              EnvSub = tolower(tostring(coalesce(tags['Environment'], tags['environment'], tags['ENVIRONMENT'], tags['Env'], tags['env'], tags['ENV'], tags['Tier'], tags['tier'], tags['Stage'], tags['stage'], tags['Usage'], tags['usage']))),\n              QuotaId = tolower(tostring(properties.subscriptionPolicies.quotaId)),\n              SubName = tolower(name)\n  ) on SubscriptionId\n// A Visual Studio or Enterprise Dev/Test subscription cannot host production\n// under the Azure offer terms, so the offer itself is a reliable signal.\n| extend IsDevTestOffer = (QuotaId has 'devtest' or QuotaId startswith 'msdn')\n// Last resort: many estates encode environment in the subscription or resource\n// group name. Only read as non-production, never as production, because a name\n// is weaker evidence than a tag.\n| extend NameHint = strcat(' ', replace_regex(strcat(SubName, ' ', tolower(ResourceGroup)), '[^a-z0-9]', ' '), ' ')\n| extend NameSaysNonProd = (NameHint has ' dev ' or NameHint has ' test ' or NameHint has ' qa '\n        or NameHint has ' uat ' or NameHint has ' sandbox ' or NameHint has ' nonprod '\n        or NameHint has ' staging ' or NameHint has ' demo ')\n| extend EnvSource = case(\n        isnotempty(EnvSelf), 'Resource tag',\n        isnotempty(EnvRg), 'Resource group tag',\n        isnotempty(EnvSub), 'Subscription tag',\n        IsDevTestOffer, 'Dev/Test subscription offer',\n        NameSaysNonProd, 'Naming convention',\n        'No signal')\n| extend EnvRaw = case(\n        isnotempty(EnvSelf), EnvSelf,\n        isnotempty(EnvRg), EnvRg,\n        isnotempty(EnvSub), EnvSub,\n        IsDevTestOffer or NameSaysNonProd, 'devtest',\n        '')\n// Normalise so non-prod, non_prod and nonprod collapse to one token.\n| extend EnvNorm = replace_regex(EnvRaw, '[^a-z0-9]', '')\n| extend Environment = case(\n        isempty(EnvNorm), 'Unverified - no signal',\n        EnvNorm startswith 'non' or EnvNorm startswith 'pre'\n            or EnvNorm in ('dev','devtest','development','test','testing','qa','uat','stg',\n                           'stage','staging','sandbox','sbx','demo','poc','lab',\n                           'sit','training'), 'Non-production',\n        EnvNorm in ('prod','production','prd','live','prdn'), 'Production',\n        'Unverified - unrecognised value')\n// Only a confirmed non-production signal earns the wave 1 pilot slot. Anything\n// unverified is sequenced as production, because the cost of being wrong is a\n// production outage during what was sold as a no-risk pilot.\n| extend Wave = case(\n        ReadinessScore >= 85 and Environment == 'Non-production', 'Wave 1 - fewer platform changes, non-production tag',\n        ReadinessScore >= 85, 'Wave 2 - fewer platform changes, production or unverified',\n        ReadinessScore >= 60, 'Wave 3 - platform validation',\n        ReadinessScore >= 35, 'Wave 4 - prerequisites required',\n        'Wave 5 - re-architecture')\n| summarize Resources = count(), Instances = sum(Instances),\n            EarliestRetirement = min(RetiresOn),\n            AvgReadiness = round(avg(todouble(ReadinessScore)), 0),\n            Sizes = strcat_array(make_set(VmSize, 10), ', ')\n    by Wave, Environment, EnvSource\n| order by Wave asc","size":4,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Migration waves","gridSettings":{"formatters":[{"columnMatch":"Wave","formatter":0,"formatOptions":{"customColumnWidthSetting":"18fr"}},{"columnMatch":"Environment","formatter":18,"formatOptions":{"thresholdsOptions":"colors","thresholdsGrid":[{"operator":"==","thresholdValue":"Production","representation":"orange","text":"{0}{1}"},{"operator":"==","thresholdValue":"Non-production","representation":"green","text":"{0}{1}"},{"operator":"Default","representation":"gray","text":"{0}{1}"}],"customColumnWidthSetting":"14fr"}},{"columnMatch":"EnvSource","formatter":0,"formatOptions":{"customColumnWidthSetting":"14fr"}},{"columnMatch":"Resources","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"Instances","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"EarliestRetirement","formatter":6,"dateFormat":{"showUtcTime":true,"formatName":"shortDatePattern"},"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"AvgReadiness","formatter":8,"formatOptions":{"palette":"redGreen","min":0,"max":100,"customColumnWidthSetting":"9fr"}},{"columnMatch":"Sizes","formatter":0,"formatOptions":{"customColumnWidthSetting":"15fr"}}],"rowLimit":100,"labelSettings":[{"columnId":"EnvSource","label":"Signal"},{"columnId":"EarliestRetirement","label":"Earliest retirement"},{"columnId":"AvgReadiness","label":"Avg platform score"},{"columnId":"Sizes","label":"Sizes in wave"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"plan-waves","customWidth":"100"},{"type":3,"content":{"version":"KqlItem/1.0","query":"resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend ComputePriority = iff(IsVmss, tostring(properties.virtualMachineProfile.priority), tostring(properties.priority))\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend ImageOffer = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.offer), tostring(properties.storageProfile.imageReference.offer))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, ComputePriority, Zone, ImageSku, ImageId, ImagePublisher, ImageOffer, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// This series-wide cutoff is not a customer's reservation expiry or billing coverage.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'No cutoff in captured catalogue; coverage not assessed',\n        todatetime(RiEnded) < now(), 'Series purchase/renewal cutoff passed; coverage not assessed',\n        'Series purchase/renewal cutoff upcoming; coverage not assessed')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Few scored platform changes - validation required',\n        ReadinessScore >= 60, 'Moderate scored platform changes',\n        ReadinessScore >= 35, 'Substantial scored platform changes',\n        'Major scored platform changes')\n| extend MigrationApproval = 'Not assessed - guest, application, HA, backup and rollback evidence required'\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend OfficialLifecycleStage = case(\n        Lifecycle == 'EOL', 'End of life - captured announcement',\n        'Unknown - reconcile official Current/Extended/End-of-life/Retired stage; announcement alone is not stage proof')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| where ReadinessScore < 60\n| project Name, ResourceGroup, Region, VmSize, VmGeneration, RecommendedTarget,\n          ReadinessScore, Blockers, RetiresOn, DaysToRetirement, ResourceId\n| order by DaysToRetirement asc, ReadinessScore asc","size":1,"queryType":1,"resourceType":"microsoft.resourcegraph/resources","crossComponentResources":["{Subscriptions}"],"visualization":"table","noDataMessage":"No matching rows in the selected scope and filters. Check subscription access, filters and catalogue coverage; an empty result is not migration approval.","title":"Long-pole workloads - start these first","gridSettings":{"formatters":[{"columnMatch":"Name","formatter":1,"formatOptions":{"linkColumn":"ResourceId","linkTarget":"Resource","linkIsContextBlade":true,"customColumnWidthSetting":"12fr"}},{"columnMatch":"ResourceGroup","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"Region","formatter":0,"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"VmSize","formatter":0,"formatOptions":{"customColumnWidthSetting":"10fr"}},{"columnMatch":"VmGeneration","formatter":0,"formatOptions":{"customColumnWidthSetting":"8fr"}},{"columnMatch":"RecommendedTarget","formatter":0,"formatOptions":{"customColumnWidthSetting":"12fr"}},{"columnMatch":"ReadinessScore","formatter":8,"formatOptions":{"palette":"redGreen","min":0,"max":100,"customColumnWidthSetting":"8fr"}},{"columnMatch":"Blockers","formatter":0,"formatOptions":{"customColumnWidthSetting":"14fr"}},{"columnMatch":"RetiresOn","formatter":6,"dateFormat":{"showUtcTime":true,"formatName":"shortDatePattern"},"formatOptions":{"customColumnWidthSetting":"9fr"}},{"columnMatch":"DaysToRetirement","formatter":0,"formatOptions":{"customColumnWidthSetting":"8fr"}},{"columnMatch":"ResourceId","formatter":5}],"rowLimit":100,"filter":true,"labelSettings":[{"columnId":"ResourceGroup","label":"Resource group"},{"columnId":"VmSize","label":"Current size"},{"columnId":"VmGeneration","label":"Gen"},{"columnId":"RecommendedTarget","label":"Recommended target"},{"columnId":"ReadinessScore","label":"Platform score"},{"columnId":"RetiresOn","label":"Retires on"},{"columnId":"DaysToRetirement","label":"Days left"},{"columnId":"ResourceId","label":"Portal"}]},"showExportToExcel":true,"exportToExcelOptions":"all"},"name":"plan-longpole","customWidth":"100"}]},"conditionalVisibility":{"parameterName":"PlanView","comparison":"isEqualTo","value":"plan"},"name":"grp-plan"},{"type":11,"name":"workflow-next-planning","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"e4dddad5-0377-576d-9768-7eb41025c79a","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Previous: 2. Assess","subTarget":"assess","preText":"","style":"link"},{"id":"4af3999d-ce33-5259-832e-7695f4877b46","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Next: 4. Migrate & validate","subTarget":"migrate","preText":"","style":"primary"},{"id":"66948407-721c-508b-978e-ead904a271e8","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Help: Methodology & references","subTarget":"about","preText":"","style":"link"}]}}]},"conditionalVisibility":{"parameterName":"WorkflowStage","comparison":"isEqualTo","value":"planning"},"name":"stage-planning"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## 4. Migrate & validate - how do I execute safely?\n\n**Goal:** Use an approved service-specific runbook, then validate the workload and close out the source.\n\n**What to do:** Work through the checklist below with the application and platform owners. Execute changes outside this read-only workbook using your approved deployment and change-management tools.\n\n**Before moving on:** Obtain explicit owner acceptance of application, performance, resilience and rollback evidence before expanding a wave or deleting old resources.\n\n**Outcome / interpretation:** A customer-maintained execution and acceptance record. This workbook does not execute migrations, track completion, or certify application readiness."},"name":"workflow-guide-migrate","styleSettings":{"margin":"0","padding":"0"}},{"type":1,"content":{"json":"### Choose a migration route\n\nThis selector changes guidance, not resources, recommendations or approval. A workload can need more than one operation; read each applicable route. Resolve the per-resource evidence and gates before selecting a supported method."},"name":"migrate-route-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"migrate-route-select","content":{"version":"LinkItem/1.0","style":"tabs","links":[{"id":"c7ba20cf-84d7-5ab0-9865-9386803fd666","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Same-VM resize","subTarget":"resize","preText":"","style":"link"},{"id":"18e5bc44-b440-5d3b-ad0b-18e2fac11761","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Parallel replacement","subTarget":"parallel","preText":"","style":"link"},{"id":"2aac9ab5-feec-54f7-994f-55d57da8111e","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Service-owned replacement","subTarget":"service","preText":"","style":"link"},{"id":"188bb377-6f65-5379-8595-b4c8bc1d71be","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"Gen1 to Trusted Launch","subTarget":"gen1","preText":"","style":"link"},{"id":"3af048ba-a5fb-5e63-a65b-dad82e14abaa","cellValue":"MigrationRoute","linkTarget":"parameter","linkLabel":"SCSI to NVMe","subTarget":"nvme","preText":"","style":"link"}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Same-VM resize\n\n- Confirm the exact source/target pair supports the existing generation, controller,\n  security/encryption configuration, local-disk topology and supported OS. A matching\n  vCPU/memory size alone does not establish a supported resize.\n- Plan restart/deallocation, IP/address consequences, availability-set/host constraints,\n  extensions and licensed core changes. Enabled hibernation is not proof of a hibernated\n  guest: check runtime state and resume/clear it as required by the supported operation.\n- Recheck family/regional quota and actual allocation capacity. A return to the source\n  size is not guaranteed once deallocated, especially near retirement.\n- Recovery: rehearsed backup/restore and an approved alternative destination if the\n  old family cannot be reallocated. A resize-back is not a universal rollback.\n\n[Supported resize procedure](https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm)\n"},"name":"migrate-route-resize-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"resize"},"name":"migrate-route-resize"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Parallel replacement\n\nPreferred modernization pattern where workload architecture permits it: build a\nsupported replacement, move state, validate it, then cut over. **A fresh OS disk does\nnot inherit application state from the old OS disk.**\n\n- Inventory OS-disk-only data, local databases, certificates/private keys, licenses,\n  scheduled tasks, service accounts, application configuration and identity permissions.\n- Recreate networking, private DNS, routes, NSGs, load-balancer probes, IP forwarding,\n  IP preservation requirements, backup, monitoring and security integrations.\n- Use full side-by-side target quota, including temporary surge and service quotas.\n  Update images and restore data using a supported, tested application procedure.\n- Recovery: retain a recoverable source for the agreed period; define how writes made\n  after cutover are reconciled. Record the system of record, cutback trigger, authority,\n  RPO/RTO and last safe recovery time before changing traffic.\n\n[Modernization planning](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/sizes-v6-v7-modernization-plan)\n"},"name":"migrate-route-parallel-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"parallel"},"name":"migrate-route-parallel"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Service-owned replacement\n\nUse the owning service's supported size/node-type list and replacement API/runbook.\nCompute SKU offerability alone does not certify an AKS, Batch, Databricks or AVD target.\nResolve conflicting associations before proceeding. **Do not resize managed backing\nVMs individually.** AVD session hosts still require the appropriate customer-managed\nhost/image procedure, with pooled and personal persistence treated differently.\n\n- AKS/VMSS: test surge, upgrade policy, disruption budgets, storage, scheduling and drain.\n- Batch: create/validate a replacement pool; move job/pool references and autoscale\n  formulas; let tasks complete or explicitly recover/checkpoint them before deletion.\n- Databricks: use a supported node type/runtime for job and all-purpose clusters,\n  pools and policies; validate restart/recreation, jobs, queries and connections.\n- AVD: verify host-pool type and persistence/assignment requirements, not only VM size.\n- Recovery: service-level restoration, pool/cluster recreation and application state\n  recovery must be rehearsed; a backing VM snapshot alone is not a service rollback.\n\nSelect the workload acceptance checklist under **Migrate & validate**.\n"},"name":"migrate-route-service-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"service"},"name":"migrate-route-service"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Gen1 to Trusted Launch - distinct in-place operation\n\nThis is not a synonym for SKU resize or SCSI-to-NVMe conversion. Confirm the current\ndocumented eligibility, Windows/Linux route, boot layout/EFI space, supported OS,\nsecurity and disk settings, Backup policy and ASR prerequisites before using it.\nWindows Server 2016 and Windows OS encryption restrictions on the documented\nconversion route must be resolved; a separate rebuild route has different prerequisites.\n\n**A Trusted Launch conversion cannot be undone by simply resizing back or changing\nthe controller.** Rehearse recovery from a suitable pre-conversion backup. Gen1 image\nreferences can remain after conversion: reconcile image, patching and reimage behavior.\nPlatform support does not make a community automation script Microsoft-supported.\n\n[Gen1 upgrade prerequisites and recovery](https://learn.microsoft.com/azure/virtual-machines/trusted-launch-existing-vm-gen-1)\n"},"name":"migrate-route-gen1-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"gen1"},"name":"migrate-route-gen1"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### SCSI to NVMe - distinct in-place operation\n\nChanging the disk controller and resizing are distinct from Gen1/Trusted Launch\nconversion. Confirm the exact VM/security/OS combination is supported by the\ndocumented operation; do not assume any v6/v7 suffix proves compatibility.\n\n- Verify actual image/disk NVMe capability, boot-critical driver, initramfs where\n  applicable and successful boot from the actual converted disk. Image publisher\n  and supported OS metadata are hints, not proof of installed/current guest drivers.\n- Validate MANA and real network traffic independently of NVMe.\n- Inspect fstab, LVM, mount units, application/backup scripts and device-path\n  assumptions; use stable identifiers. Confirm data disks mount correctly.\n- Temporary/local NVMe can be raw or reinitialized after deallocation. Test its\n  initialization plus pagefile, swap, tempdb and scratch placement; it is not durable data.\n- Recovery: use only the operation's documented reversal prerequisites; otherwise\n  recover from the rehearsed backup. A controller switch is not a universal rollback.\n\n[NVMe guidance](https://learn.microsoft.com/azure/virtual-machines/nvme-overview) |\n[Supported modernization operations](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/sizes-v6-v7-modernization-modernize)\n"},"name":"migrate-route-nvme-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"MigrationRoute","comparison":"isEqualTo","value":"nvme"},"name":"migrate-route-nvme"},{"type":1,"content":{"json":"### Choose workload acceptance criteria\n\nUse observed ownership and the application owner's assessment to choose a pattern. For AVD, confirm pooled versus personal in Independent service registrations. Selection changes guidance only; it is not a recorded migration decision."},"name":"workflow-acceptance-intro","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"workflow-acceptance-select","content":{"version":"LinkItem/1.0","style":"tabs","links":[{"id":"efebf889-7a8d-5960-96ff-db87c6b1afcf","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"Choose workload","subTarget":"unknown","preText":"","style":"link"},{"id":"c0506c5a-f7bd-5609-bf00-54906ce29ef7","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"Standalone app","subTarget":"standalone","preText":"","style":"link"},{"id":"fbf76be8-aadc-5a8d-80c2-488802bf2414","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"AKS / VMSS / Batch pools","subTarget":"pools","preText":"","style":"link"},{"id":"cdb00589-084f-52e6-bf95-ad46c9711451","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"AVD pooled","subTarget":"avd-pooled","preText":"","style":"link"},{"id":"332ff9eb-42a7-5080-9498-254ac69fcab3","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"AVD personal","subTarget":"avd-personal","preText":"","style":"link"},{"id":"2aa5da34-c483-58b1-bb1e-a88deb7f0289","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"Databricks","subTarget":"databricks","preText":"","style":"link"},{"id":"16f5ae25-642a-582b-8ca2-9dbbbb855c76","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"SQL / SAP / stateful","subTarget":"stateful","preText":"","style":"link"},{"id":"2c98c2c0-ba6f-515b-9c1a-0dbd30a86557","cellValue":"AcceptancePattern","linkTarget":"parameter","linkLabel":"Vendor appliance","subTarget":"appliance","preText":"","style":"link"}]}},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Owner/classification required\n\nUnclassified is **not stateless**. Identify the owner, dependencies and data authority,\nthen choose the appropriate acceptance pattern. These are customer checklists, not\nautomatically recorded pass/fail results. Combine patterns for mixed workloads.\n"},"name":"workflow-acceptance-unknown-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"unknown"},"name":"workflow-acceptance-unknown"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Standalone application - done means\n\n- Real application transactions, data integrity and client/DNS/LB cutover succeed.\n- Latency, throughput, disk/network behavior and availability meet the agreed baseline.\n- OS-disk state, certificates, tasks, licenses, identities and permissions are preserved.\n- The application owner accepts the destination; recovery writes and source disposition\n  are reconciled before the rollback window closes.\n"},"name":"workflow-acceptance-standalone-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"standalone"},"name":"workflow-acceptance-standalone"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Pools - done means\n\n- Workloads/tasks run successfully on supported target nodes and persistent data is intact.\n- Old nodes/pools are drained using the service procedure; no jobs, selectors, taints,\n  autoscale profiles, pool references or VMSS model/images still pin the retired size.\n- AKS PDBs, scheduling, node/pod/network/storage health and upgrade/surge behavior pass.\n- Batch tasks complete or recover correctly, replacement job/pool bindings and autoscale\n  formulas work; zero allocated nodes alone does not prove a retired pool is remediated.\n- Source pools are removed only after owner acceptance and approved recovery retention.\n"},"name":"workflow-acceptance-pools-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"pools"},"name":"workflow-acceptance-pools"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### AVD pooled - done means\n\n- Replacement hosts are Available and actually serve test/user sessions.\n- Profiles/FSLogix, apps, authentication, user data and performance meet acceptance.\n- Drain mode and session handling are verified; old hosts no longer receive sessions.\n- Host-pool/image/scaling configuration no longer creates the retired size; remove\n  old hosts only after sessions drain and recovery/owner approval.\n"},"name":"workflow-acceptance-avd-pooled-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"avd-pooled"},"name":"workflow-acceptance-avd-pooled"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### AVD personal - done means\n\n- Persistent user/OS-disk application state and personal assignments are explicitly\n  preserved or migrated, not assumed portable like a pooled desktop.\n- The assigned user can sign in to the correct replacement; apps, profiles, data,\n  licenses, identity and performance pass.\n- Reassignment, recovery and old-host retirement are owner-approved; do not delete\n  the old persistent desktop merely because the replacement host is Available.\n"},"name":"workflow-acceptance-avd-personal-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"avd-personal"},"name":"workflow-acceptance-avd-personal"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Databricks - done means\n\n- Supported target node types/runtime are applied to relevant clusters, job definitions,\n  pools and policies; no old node-type pinning remains.\n- Representative jobs, queries, libraries, authentication and external connections pass.\n- Local scratch/shuffle behavior, performance and cost are accepted; durable data\n  and recovery do not depend on lost local disks.\n- Old clusters/pools are retired through Databricks after owner acceptance. A terminated\n  old configuration is still a configuration that can restart on the retired type.\n"},"name":"workflow-acceptance-databricks-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"databricks"},"name":"workflow-acceptance-databricks"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Stateful / SQL / SAP - done means\n\n- Replication, quorum, data consistency, backup/restore and HA/failover pass under load.\n- Client endpoints and authentication work; application/database owners accept RPO/RTO\n  and baseline performance, including storage latency, tempdb/log and licensing effects.\n- Vendor support and cluster membership are validated; the old node is removed cleanly\n  after failover and recovery retention. SQL registration alone proves none of this.\n"},"name":"workflow-acceptance-stateful-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"stateful"},"name":"workflow-acceptance-stateful"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"### Vendor appliance - done means\n\n- Vendor certifies the exact product/version, target family, image/boot/security mode,\n  NIC count/order, accelerated networking/MANA drivers and deployment/HA topology.\n- Data-plane traffic, routing, IP forwarding, policy enforcement, management access,\n  licensing and HA/failover pass representative tests.\n- Old appliances leave the traffic/HA path cleanly; supported configuration restore\n  and recovery have been tested. Generic boot success is not appliance certification.\n"},"name":"workflow-acceptance-appliance-text","styleSettings":{"margin":"0","padding":"0"}}]},"conditionalVisibility":{"parameterName":"AcceptancePattern","comparison":"isEqualTo","value":"appliance"},"name":"workflow-acceptance-appliance"},{"type":1,"content":{"json":"### Complete before closing the change\n\nRestore/test agents, backup policies and restore points, security, monitoring,\nextensions and alerting. Reconcile Hybrid Benefit/BYOL and reservation/savings-plan\ncoverage with licensing owners; retail pricing is not actual commercial coverage.\nUpdate Terraform/Bicep, image pipelines, autoscale profiles and operational runbooks\nso the retired size is not recreated. Record evidence, owner acceptance, source\ndisposition and the explicit end of the recovery window in your own change tracker.\n\nRecheck the same subscription/scope and both old **configuration** and live instances.\nA disappeared retirement row, deallocated VM or empty query is not proof of success.\n"},"name":"workflow-closeout","styleSettings":{"margin":"0","padding":"0"}},{"type":1,"content":{"json":"### Execution and acceptance checklist\n\n| When | Customer action | Evidence / decision to record outside the workbook |\n| --- | --- | --- |\n| Before a pilot | Confirm owner, service dependencies, licensing, supportability and target eligibility | Owner-approved target and method; resolved or explicitly accepted unknowns |\n| Before a pilot | Test backup/restore and rollback; agree triggers, downtime and recovery objectives | A rehearsed recovery plan and go/no-go authority |\n| Pilot | Use a representative approved non-production workload where possible | Baseline CPU, memory, disk/network latency and application health |\n| Execute | Follow the supported VM, VMSS or managed-service runbook | Change record, migration logs and boot/driver/encryption evidence |\n| Validate | Test application transactions, performance, monitoring, HA/failover and backup | Compare with baseline and obtain application-owner acceptance |\n| Expand waves | Recheck restrictions, quota and actual capacity before each wave | Approved schedule; pause or roll back when agreed thresholds fail |\n| Close out | Retain recovery resources for the approved period, then retire only confirmed unused sources | Owner approval, inventory reconciliation and updated cost/licensing records |\n\n### Use the workload's supported migration method\n\n- **Standalone VMs:** choose supported resize versus rebuild/migrate after assessing generation, storage, encryption and application constraints. See the [VM modernization guide](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirement/retired-sizes-modernization-guide).\n- **VM scale sets:** use model-level changes and a tested rolling/instance replacement strategy; validate instance health and orchestration behavior. See [VMSS upgrade policies](https://learn.microsoft.com/azure/virtual-machine-scale-sets/virtual-machine-scale-sets-upgrade-policy).\n- **AKS:** migrate through supported node-pool operations, with pod disruption, drain, storage and surge planning. **Do not resize managed backing VMs individually.** See [AKS node-pool resizing](https://learn.microsoft.com/azure/aks/resize-node-pool).\n- **Other managed services:** follow the owning service's pool/workspace/host migration process. Ownership conflicts require investigation before changing backing compute.\n- **SQL / SAP / stateful workloads:** engage application and database owners for licensing, data consistency, HA, backup/restore and vendor support. SQL registrations are opportunity signals, not automatic recommendations to move to a managed database.\n\n### Recheck and reconcile\n\nRefresh Inventory after changes and compare exports from the same scope. A resource disappearing from a retirement grid is **not proof of migration success**: it may have moved scope, changed size, been deleted, or become inaccessible. Confirm the destination, workload acceptance and source disposition independently."},"name":"workflow-execution-checklist","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"workflow-next-migrate","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"e399fd29-f38c-5234-b3e1-7a57a982c00a","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Previous: 3. Plan","subTarget":"planning","preText":"","style":"link"},{"id":"b467e94b-e340-5177-82c8-d9beb37cd452","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Recheck: 1. Inventory","subTarget":"inventory","preText":"","style":"primary"},{"id":"46eed351-4e9e-54fd-96f7-83afe8687e88","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Help: Methodology & references","subTarget":"about","preText":"","style":"link"}]}}]},"conditionalVisibility":{"parameterName":"WorkflowStage","comparison":"isEqualTo","value":"migrate"},"name":"stage-migrate"},{"type":12,"content":{"version":"NotebookGroup/1.0","groupType":"editable","items":[{"type":1,"content":{"json":"## Methodology & references\n\n**Goal:** Understand data sources, scoring, coverage and limitations.\n\n**What to do:** Review the scoring model and references before interpreting a flag. Return to Inventory > Catalogue coverage to see mapped versus unassessed sizes in your scope.\n\n**Before moving on:** Confirm that assumptions, cloud applicability and evidence quality match your environment.\n\n**Outcome / interpretation:** Transparent interpretation, not a supportability or migration certification."},"name":"workflow-guide-about","styleSettings":{"margin":"0","padding":"0"}},{"type":1,"content":{"json":"### Scope and recommendation policy\n\nThis workbook inventories the virtual machines and scale sets in the subscriptions you select, identifies which sizes are affected by announced Azure VM retirements and lifecycle changes, recommends a target size for each, and scores captured platform compatibility, not application migration readiness.\n\n**Target policy: v5 first.** Retirement recommendations prefer a catalogued non-NVMe v5 target that preserves architecture, CPU, memory, local disk (including known capacity) and premium-storage support. Newer targets remain alternatives. If no suitable v5 candidate exists, the newer target is explicitly marked for manual review. Optional modernization is separate from retirement remediation.\n\nV5 does not eliminate MANA, guest OS, encryption, quota or application checks. A high score is not a migration certification. **100 means no scored platform penalty; guest, application, HA, backup and rollback checks may still be Unknown.** Use Inventory > Workloads & owners to identify service ownership and stateful workload evidence.\n\nThe platform score uses your **actual** fleet attributes - the real Hyper-V generation of each OS disk, the region and zone each VM runs in, and whether it sits in an availability set or scale set - not from size metadata alone.\n\n> All data stays in your tenant. The workbook runs read-only Azure Resource Graph and selected-row Compute SKU API queries; it makes no resource changes."},"name":"workflow-policy","styleSettings":{"margin":"0","padding":"0"}},{"type":1,"content":{"json":"### How this workbook works\n\n**Data source.** Read-only Azure Resource Graph queries and a selected-row Compute SKU API inspection across the subscriptions you select. Nothing is written, nothing leaves your tenant, and no agent or Log Analytics workspace is required. You need `Reader` on the subscriptions in scope.\n\n**Lifecycle status.**\n\n| Status | Meaning |\n| --- | --- |\n| Retirement announced | The size has a published retirement date. VMs still running that size on the date will stop. Action is mandatory. |\n| End of life | The series has entered the End of Life lifecycle stage with a published retirement date. Plan the migration inside the notice window. |\n| Optional modernization | Previous-generation or current-generation sizes with no announced retirement. Moving is a price-performance decision, not a compliance one. |\n\n**Platform score (legacy export field `ReadinessScore`).** Every impacted resource starts at 100 and loses points for scored platform differences. **100 is not migration approval**; unknown drivers, application dependencies, HA, backup and rollback do not become passed checks. Workload complexity is assessed separately by the application/service owner.\n\n| Factor | Penalty | Evaluated against |\n| --- | ---: | --- |\n| Arm64 architecture change | 50 | Target CPU architecture |\n| Gen1 to Gen2 conversion | 45 | **Actual `hyperVGeneration` of the OS disk** |\n| Target size not offered in this region | 30 | VM region vs target availability |\n| Memory reduction at same vCPU | 25 | Source vs target memory |\n| Local temp disk removed | 20 | Source has temp disk, target does not |\n| Unconfirmed VM generation | 20 | OS disk metadata unavailable |\n| NVMe boot validation | 15 | Selected target requires NVMe controller |\n| MANA/accelerated networking validation | 0 | Hardware-dependent, independent of storage controller |\n| Narrow target region footprint | 10 | Target region count |\n| Availability zone parity | 10 | Only when the VM uses a zone |\n| vCPU count change | 5 | No size exists at the current vCPU count |\n| Availability set membership | 5 | Cluster-pinned resize constraint |\n| Scale set | 5 | Model-level SKU change |\n\nA VM already running Generation 2 takes **no** Gen1 penalty even when its target is Gen2-only. That is the difference between scoring the size and scoring your fleet.\n\n**Legacy-series pricing changes.** A pricing update takes effect **1 February 2027** for selected v1 and v2 size series. The workbook flags which of your series are in scope; it does not restate the rate change, because the applicable figures are communicated to each tenant through its own Azure Service Health notification and depend on the agreement. For authoritative rates see the official [Windows](https://azure.microsoft.com/pricing/details/virtual-machines/windows/) and [Linux](https://azure.microsoft.com/pricing/details/virtual-machines/linux/) VM pricing pages. This flag is separate from the regional exposure section.\n\n**Regional pricing exposure.** Inventory > Retirement & pricing separately shows VMs in seven regions with publicly reproduced notification changes. Its figures are not a formal public announcement, contractual rates or a bill forecast. Confirm Service Health scope and your agreement; regional exclusions do not exempt a series from other pricing changes. Modern VMs may have potential regional exposure without retiring.\n\n**Reserved Instances.** Purchases and renewals ended **1 July 2026** for one-year reservations on Av2, Amv2, Bv1, D, Ds, Dv2, Dsv2, F, Fs, Fsv2, G, Gs, Ls and Lsv2, and for both one- and three-year reservations on Dv3, Dsv3, Ev3 and Esv3. Existing reservation records are available separately in Inventory > Reservation exposure; billing coverage is not assessed. The cutoff is **not the customer's reservation expiry**, and does not establish pay-as-you-go billing or the absence of other discounts ([Azure update 560948](https://azure.microsoft.com/updates?id=560948)).\n\n**Cloud coverage.** The two changes do not have the same scope:\n\n| | Azure public | 21Vianet | Sovereign / Government |\n| --- | :---: | :---: | :---: |\n| v3 retirement | Applies | Exempt | Exempt |\n| Legacy-series 1 Feb 2027 pricing update | Applies | Applies | Exempt |\n\nThis table does not establish the scope of the separate regional notification.\n\nThis workbook does not detect cloud type. If you are running in Azure Government, a sovereign cloud, or 21Vianet, read the rows above before acting on a flag.\n\n**Capacity growth restrictions.** Separate from retirement. Existing subscriptions can keep deploying End of Life series within already-approved quota, subject to capacity, but additional quota is not approved and new subscriptions cannot deploy them at all. Restrictions on the v4 D and E families were **lifted** in the 28 September 2026 notification, so quota requests for those families can be submitted again through the standard process, subject to capacity. Note that Microsoft's modernization guidance for the v3 series still points at v5, v6 and v7 - the lifting of v4 restrictions removes a constraint, it does not make v4 the recommended destination.\n\n**Caveats.**\n- Target recommendations are a starting point. Right-size against 30-90 days of real CPU, memory, disk and network utilisation before committing.\n- Region availability is checked against a captured size catalogue. Confirm with `az vm list-skus --location <region> --resource-type virtualMachines --size <target> --all` before you schedule a wave.\n- Reserved instance and savings plan coverage is not evaluated here. Review it alongside the migration plan, because savings plans flex across families while reservations do not.\n- Per-core licensed software (SQL Server, Oracle, SAP) must be re-checked whenever the vCPU count changes.\n\n**References**\n- [VM size series retirements, capacity restrictions and modernization guidance](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions)\n- [VM lifecycle overview](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/lifecycle-overview)\n- [End of Life VM size series](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/end-of-life-sizes-list)\n- [Retired VM sizes modernization guide](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirement/retired-sizes-modernization-guide)\n- [Modernize to the v5 VM series](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/sizes-v5-modernization-overview)\n- [Modernize to the v6 and v7 VM series](https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/sizes-v6-v7-modernization-overview)\n- [Enhancing the Azure Virtual Machine lifecycle](https://azure.microsoft.com/blog/enhancing-microsoft-azure-virtual-machine-lifecycle/)\n- [Generation 2 VMs](https://learn.microsoft.com/azure/virtual-machines/generation-2)\n- [NVMe on Azure VMs](https://learn.microsoft.com/azure/virtual-machines/nvme-overview)\n- [MANA accelerated networking](https://learn.microsoft.com/azure/virtual-network/accelerated-networking-mana-overview)\n- [Resize a virtual machine](https://learn.microsoft.com/azure/virtual-machines/sizes/resize-vm)\n- [Manage Reserved VM Instances](https://learn.microsoft.com/azure/cost-management-billing/reservations/manage-reserved-vm-instance)\n- [Azure updates - retirements](https://azure.microsoft.com/updates/?updateType=retirements)\n"},"name":"about-text","styleSettings":{"margin":"0","padding":"0"}},{"type":11,"name":"workflow-next-about","content":{"version":"LinkItem/1.0","style":"paragraph","links":[{"id":"f0f5cc35-e86b-5e10-bee2-aff1edba0902","cellValue":"WorkflowStage","linkTarget":"parameter","linkLabel":"Return: Start here","subTarget":"start","preText":"","style":"link"}]}}]},"conditionalVisibility":{"parameterName":"WorkflowStage","comparison":"isEqualTo","value":"about"},"name":"stage-about"}],"styleSettings":{},"fallbackResourceIds":["Azure Monitor"],"$schema":"https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"}