    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### VM retirement / end of life\nEvery VM and scale set whose current size carries an announced retirement or end-of-life status. **Readiness** is scored 0-100 against your real configuration; **Blockers** lists the prerequisite work that must happen before the move."
            },
            "name": "imp-intro",
            "styleSettings": {
              "margin": "0",
              "padding": "0"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n// A Flexible-orchestration scale set surfaces BOTH the scale set (carrying\n// sku.capacity) and every member VM as separate Resource Graph rows. Counting\n// both double-reports the fleet, so member VMs are dropped here and the scale\n// set alone represents them. Uniform scale sets do not expose member VMs at\n// all, so they are unaffected. Flexible is the current Azure default, so this\n// matters for most modern fleets.\n\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| extend OsType = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.osDisk.osType), tostring(properties.storageProfile.osDisk.osType))\n| extend OsDiskId = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))\n| extend AvSetId = tostring(properties.availabilitySet.id)\n| extend PowerState = tostring(split(tostring(properties.extended.instanceView.powerState.code), '/')[1])\n| extend Zone = tostring(zones[0])\n| extend ImageSku = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.sku), tostring(properties.storageProfile.imageReference.sku))\n| extend ImageId = iff(IsVmss, tostring(coalesce(properties.virtualMachineProfile.storageProfile.imageReference.id, properties.virtualMachineProfile.storageProfile.imageReference.sharedGalleryImageId, properties.virtualMachineProfile.storageProfile.imageReference.communityGalleryImageId)), tostring(coalesce(properties.storageProfile.imageReference.id, properties.storageProfile.imageReference.sharedGalleryImageId, properties.storageProfile.imageReference.communityGalleryImageId)))\n| extend ImagePublisher = iff(IsVmss, tostring(properties.virtualMachineProfile.storageProfile.imageReference.publisher), tostring(properties.storageProfile.imageReference.publisher))\n| extend GuestOsName = tostring(properties.extended.instanceView.osName)\n| project ResourceId = id, Name = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId,\n          Region = location, VmSize, Instances, OsType, OsDiskId, AvSetId, PowerState, Zone, ImageSku, ImageId, ImagePublisher, GuestOsName, IsVmss, Tags = tags\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.compute/disks'\n    | project OsDiskId = tolower(id), DiskGen = tostring(properties.hyperVGeneration),\n              DiskAdeConfigured = tobool(properties.encryptionSettingsCollection.enabled),\n              DiskControllers = tostring(properties.supportedCapabilities.diskControllerTypes)\n  ) on OsDiskId\n| extend VmGeneration = case(\n        isnotempty(DiskGen), DiskGen,\n        ImageSku has 'gen2' or ImageSku has '-g2', 'V2',\n        'Unknown')\n| extend Rec = tostring(parse_json('{LifecycleSkuMap}')[VmSize])\n| where isnotempty(Rec)\n| extend P = split(Rec, '|')\n| extend Lifecycle = tostring(P[0]),\n         SeriesGroup = tostring(P[1]),\n         RetirementDate = tostring(P[2]),\n         RecommendedTarget = tostring(P[3]),\n         MemoryPreservingTarget = tostring(P[4]),\n         TargetVcpu = tostring(P[5]),\n         TargetMemoryGB = tostring(P[6]),\n         CurrentVcpu = toint(P[7]),\n         CurrentMemoryGB = toreal(P[8]),\n         WarnCodes = tostring(P[9]),\n         AlternateTargets = tostring(P[10]),\n         RiEnded = tostring(P[11]),\n         Series = tostring(P[12]),\n         PriceUpdate = tostring(P[13]),\n         MpVcpu = tostring(P[14]),\n         MpMemoryGB = tostring(P[15])\n| extend RetiresOn = iff(isempty(RetirementDate), datetime(null), todatetime(RetirementDate))\n| extend DaysToRetirement = iff(isempty(RetirementDate), toint(-1), datetime_diff('day', todatetime(RetirementDate), now()))\n| extend RegionId = tostring(parse_json('{RegionIdMap}')[tolower(Region)])\n| extend TargetRegions = tostring(parse_json('{TargetRegionMap}')[RecommendedTarget])\n| extend TargetInRegion = case(\n        isempty(RecommendedTarget) or isempty(TargetRegions), 'Unverified',\n        isempty(RegionId), 'Unverified',\n        TargetRegions has strcat('|', RegionId, '|'), 'Yes',\n        'No')\n| extend PriceUpdate2027 = iff(PriceUpdate == '1', 'Yes', 'No')\n// Reserved Instance purchases and renewals for these series ended 2026-07-01.\n// Once an existing RI expires the workload bills at pay-as-you-go, even when\n// the reservation is set to auto-renew. Public source: Azure update 560948.\n| extend RiEndsOn = iff(isempty(RiEnded), datetime(null), todatetime(RiEnded))\n| extend RiStatus = case(\n        isempty(RiEnded), 'Not applicable',\n        todatetime(RiEnded) < now(), 'Expired - billing at pay-as-you-go',\n        'Expires - no renewal available')\n// ---- readiness penalties, evaluated against the REAL fleet attributes ----\n| extend NeedsGen2 = iff(WarnCodes has 'g' and VmGeneration == 'V1', 1, 0)\n| extend GenUnknown = iff(WarnCodes has 'g' and VmGeneration == 'Unknown', 1, 0)\n| extend PenGen = iff(NeedsGen2 == 1, 45, iff(GenUnknown == 1, 20, 0))\n| extend PenArch = iff(WarnCodes has 'a', 50, 0)\n| extend PenMem = iff(WarnCodes has 'm', 25, 0)\n| extend PenTemp = iff(WarnCodes has 't', 20, 0)\n| extend PenNvme = iff(WarnCodes has 'n', 15, 0)\n| extend PenNarrow = iff(WarnCodes has 'r', 10, 0)\n| extend PenAz = iff(WarnCodes has 'z' and isnotempty(Zone), 10, 0)\n| extend PenVcpu = iff(WarnCodes has 'v', 5, 0)\n| extend PenRegion = iff(TargetInRegion == 'No', 30, 0)\n| extend PenAvSet = iff(isnotempty(AvSetId), 5, 0)\n| extend PenVmss = iff(IsVmss, 5, 0)\n| extend ReadinessScore = toint(iff(100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss < 0, 0, 100 - PenGen - PenArch - PenMem - PenTemp - PenNvme - PenNarrow - PenAz - PenVcpu - PenRegion - PenAvSet - PenVmss))\n| extend Complexity = case(\n        ReadinessScore >= 85, 'Low - in-place resize',\n        ReadinessScore >= 60, 'Medium - validate then resize',\n        ReadinessScore >= 35, 'High - prerequisites required',\n        'Very high - re-architecture')\n| extend Urgency = case(\n        DaysToRetirement < 0, 'No retirement date',\n        DaysToRetirement <= 180, 'Critical - under 6 months',\n        DaysToRetirement <= 365, 'High - under 12 months',\n        DaysToRetirement <= 730, 'Medium - under 24 months',\n        'Planned - over 24 months')\n| extend ActionCategory = case(\n        Lifecycle == 'RETIRE', 'Retirement announced - action required',\n        Lifecycle == 'EOL', 'End of life - plan migration',\n        'Optional modernization')\n| extend Blockers = trim(', ', strcat(\n        iff(NeedsGen2 == 1, 'Gen1 to Gen2 conversion, ', ''),\n        iff(GenUnknown == 1, 'Confirm VM generation, ', ''),\n        iff(PenArch > 0, 'Arm64 port, ', ''),\n        iff(PenMem > 0, 'Memory downgrade, ', ''),\n        iff(PenTemp > 0, 'Temp disk dependency, ', ''),\n        iff(PenNvme > 0, 'NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'MANA/accelerated networking validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(PenRegion > 0, 'Target not in region, ', ''),\n        iff(PenVcpu > 0, 'vCPU count change, ', '')))\n| extend Blockers = iff(isempty(Blockers), 'None identified', Blockers)\n// Size-level considerations, independent of any individual VM's configuration.\n// Used by the size-by-size mapping so rows do not split on per-VM attributes.\n| extend SizeConsiderations = trim(', ', strcat(\n        iff(WarnCodes has 'g', 'Target is Gen2-only, ', ''),\n        iff(WarnCodes has 'a', 'Arm64 architecture change, ', ''),\n        iff(WarnCodes has 'm', 'Memory reduction at same vCPU, ', ''),\n        iff(WarnCodes has 't', 'Local temp disk removed, ', ''),\n        iff(WarnCodes has 'n', 'Target requires NVMe boot validation, ', ''),\n        iff(WarnCodes has 'h', 'Hardware-dependent MANA validation, ', ''),\n        iff(WarnCodes has 'u', 'No suitable v5 target - manual review, ', ''),\n        iff(WarnCodes has 'k', 'No suitable target in this path - manual selection, ', ''),\n        iff(WarnCodes has 'l', 'Target local-disk capacity unverified, ', ''),\n        iff(WarnCodes has 'r', 'Narrow target region footprint, ', ''),\n        iff(WarnCodes has 'z', 'Limited zone coverage, ', ''),\n        iff(WarnCodes has 'v', 'No target at current vCPU count, ', '')))\n| extend SizeConsiderations = iff(isempty(SizeConsiderations), 'Straight resize', SizeConsiderations)\n| where Lifecycle != 'OPTIONAL'\n| where '{LifecycleFilter}' has Lifecycle\n| project Name, ResourceGroup, Region, VmSize, Instances, VmGeneration,\n          RecommendedTarget, TargetInRegion, RetiresOn, ReadinessScore,\n          Blockers, ResourceId\n| order by ReadinessScore asc, RetiresOn asc",
              "size": 1,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "table",
              "title": "Retiring virtual machines and scale sets",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Name",
                    "formatter": 1,
                    "formatOptions": {
                      "linkColumn": "ResourceId",
                      "linkTarget": "Resource",
                      "linkIsContextBlade": true,
                      "customColumnWidthSetting": "18ch"
                    }
                  },
                  {
                    "columnMatch": "ResourceGroup",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "17ch"
                    }
                  },
                  {
                    "columnMatch": "Region",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "11ch"
                    }
                  },
                  {
                    "columnMatch": "VmSize",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "18ch"
                    }
                  },
                  {
                    "columnMatch": "Instances",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "12ch"
                    }
                  },
                  {
                    "columnMatch": "VmGeneration",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "8ch"
                    }
                  },
                  {
                    "columnMatch": "RecommendedTarget",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "21ch"
                    }
                  },
                  {
                    "columnMatch": "TargetInRegion",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "No",
                          "representation": "failed",
                          "text": "Not available"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Unverified",
                          "representation": "unknown",
                          "text": "Unverified"
                        },
                        {
                          "operator": "Default",
                          "representation": "success",
                          "text": "Available"
                        }
                      ],
                      "customColumnWidthSetting": "14ch"
                    }
                  },
                  {
                    "columnMatch": "RetiresOn",
                    "formatter": 6,
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "shortDatePattern"
                    },
                    "formatOptions": {
                      "customColumnWidthSetting": "13ch"
                    }
                  },
                  {
                    "columnMatch": "ReadinessScore",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "redGreen",
                      "min": 0,
                      "max": 100,
                      "customColumnWidthSetting": "12ch"
                    }
                  },
                  {
                    "columnMatch": "Blockers",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "32ch"
                    }
                  },
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 5
                  }
                ],
                "rowLimit": 10,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "ReadinessScore",
                    "sortOrder": 1
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "ResourceGroup",
                    "label": "Resource group"
                  },
                  {
