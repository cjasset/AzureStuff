                  },
                  {
                    "columnMatch": "AvgReadiness",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "redGreen",
                      "min": 0,
                      "max": 100,
                      "customColumnWidthSetting": "9%"
                    }
                  },
                  {
                    "columnMatch": "Sizes",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "15%"
                    }
                  }
                ],
                "rowLimit": 10,
                "labelSettings": [
                  {
                    "columnId": "EnvSource",
                    "label": "Signal"
                  },
                  {
                    "columnId": "EarliestRetirement",
                    "label": "Earliest retirement"
                  },
                  {
                    "columnId": "AvgReadiness",
