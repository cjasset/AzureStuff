\":\"NVsv3\",\"standard_nv16as_v4\":\"NVasv4\",\"standard_nv18ads_a10_v5\":\"NVads_A10v5\",\"standard_nv24s_v3\":\"NVsv3\",\"standard_nv32as_v4\":\"NVasv4\",\"standard_nv36ads_a10_v5\":\"NVads_A10v5\",\"standard_nv48s_v3\":\"NVsv3\",\"standard_nv4as_v4\":\"NVasv4\",\"standard_nv6ads_a10_v5\":\"NVads_A10v5\",\"standard_nv72ads_a10_v5\":\"NVads_A10v5\",\"standard_nv8as_v4\":\"NVasv4\"}')[tolower(VmSize)])\n| extend ReportedExcluded = tobool(parse_json('{\"amv2\":true,\"av2\":true,\"blsv1\":true,\"bmsv1\":true,\"bsv1\":true,\"ddsv7\":true,\"dldsv7\":true,\"dlsv7\":true,\"dsv1\":true,\"dsv2\":true,\"dsv7\":true,\"dv1\":true,\"dv2\":true,\"edsv7\":true,\"esv7\":true,\"fsv1\":true,\"fsv2\":true,\"fv1\":true,\"gsv1\":true,\"gv1\":true,\"hcs\":true,\"lsv1\":true,\"lsv2\":true,\"npsv1\":true}')[tolower(Series)]) == true\n        or tolower(VmSize) matches regex '^standard_(d[0-9]+(-[0-9]+)?(s|ds|ls|lds)|e[0-9]+(-[0-9]+)?(s|ds))_v7$'\n| extend Exposure = case(\n        ReportedExcluded == true, 'Reported regional exclusion - not a universal exemption',\n        isempty(Series), 'Potential exposure - series/scope unknown',\n        'Potential exposure - verify advisory and agreement')\n| extend EffectiveDate = datetime(2027-02-01),\n         Evidence = 'Public Q&A reproduction of customer notification; not a formal public announcement',\n         Scope = 'VM compute only; not a bill estimate. Confirm meters, contract, reservations and regional scope in Service Health. Separate legacy-series changes may apply.',\n         Source = 'https://learn.microsoft.com/en-us/answers/questions/6025662/is-there-any-official-announcement-for-azure-vm-in'\n| project Name, ResourceGroup, Region, VmSize, Instances, Series, Exposure,\n          AnnouncedRegionalPercent, EffectiveDate, Evidence, Scope, Source, ResourceId\n| order by AnnouncedRegionalPercent desc, Region asc, Name asc",
