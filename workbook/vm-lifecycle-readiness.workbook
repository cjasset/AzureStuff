              }
            },
            "name": "about-coverage",
            "customWidth": "50",
            "styleSettings": {
              "maxWidth": "620px"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend IsVmss = (type =~ 'microsoft.compute/virtualmachinescalesets')\n| where IsVmss or isempty(tostring(properties.virtualMachineScaleSet.id))\n| extend VmSize = iff(IsVmss, tostring(sku.name), tostring(properties.hardwareProfile.vmSize))\n| extend Instances = iff(IsVmss, toint(sku.capacity), 1)\n| summarize Resources = count(), Instances = sum(Instances) by VmSize\n| order by Instances desc",
